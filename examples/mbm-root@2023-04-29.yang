                }
                leaf "RR_EthPort_2_AutoNeg" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 1) or (/config_data/main/EthPorts/RR_EthPort_2_Enable != 'On'))";
                    type "lbox_eth_autoneg_M1";
                    must "not ((. = 'LB_eth_autoneg_1000mbps_auto' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100)) or (. = 'LB_eth_autoneg_1000mbps_full' and ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_1000Mbps_Full != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100))) or (. = 'LB_eth_autoneg_1000mbps_half' and ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_1000Mbps_Half != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100))) or (. = 'LB_eth_autoneg_100mbps_auto' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)) or (. = 'LB_eth_autoneg_100mbps_full' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)) or (. = 'LB_eth_autoneg_100mbps_half' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)))";
                }
                leaf "RR_EthPort_3_Enable" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 2)";
                    type "lbox_off_on";
                }
                leaf "RR_EthPort_3_AutoNeg" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 2) or (/config_data/main/EthPorts/RR_EthPort_3_Enable != 'On'))";
                    type "lbox_eth_autoneg_M1";
                    must "not ((. = 'LB_eth_autoneg_1000mbps_auto' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100)) or (. = 'LB_eth_autoneg_1000mbps_full' and ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_1000Mbps_Full != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100))) or (. = 'LB_eth_autoneg_1000mbps_half' and ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_1000Mbps_Half != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100))) or (. = 'LB_eth_autoneg_100mbps_auto' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)) or (. = 'LB_eth_autoneg_100mbps_full' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)) or (. = 'LB_eth_autoneg_100mbps_half' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)))";
                }
                leaf "RR_EthPort_4_Enable" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 3)";
                    type "lbox_off_on";
                }
                leaf "RR_EthPort_4_AutoNeg" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 3) or (/config_data/main/EthPorts/RR_EthPort_4_Enable != 'On'))";
                    type "lbox_eth_autoneg_M1";
                    must "not ((. = 'LB_eth_autoneg_1000mbps_auto' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100)) or (. = 'LB_eth_autoneg_1000mbps_full' and ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_1000Mbps_Full != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100))) or (. = 'LB_eth_autoneg_1000mbps_half' and ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_1000Mbps_Half != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100))) or (. = 'LB_eth_autoneg_100mbps_auto' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)) or (. = 'LB_eth_autoneg_100mbps_full' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)) or (. = 'LB_eth_autoneg_100mbps_half' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)))";
                }
            }
            container "ExtensionPorts" {
                leaf "RR_PortSfpEnable" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Port_Sfp != 'On')";
                    type "enumeration" {
                        enum "Off" {
                            value "0";
