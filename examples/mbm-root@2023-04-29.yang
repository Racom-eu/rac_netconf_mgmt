            container "WifiExt" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Module_Wifi != 'On') or (/config_data/main/Wifi/RR_WifiExt_Enable != 'On'))";
                leaf "RR_WifiExt_IpAddr" {
                    type "inet:ipv4-address";
                }
                leaf "RR_WifiExt_Netmask" {
                    type "lim_ipv4_mask";
                }
                leaf "RR_WifiExt_MngEn" {
                    type "lbox_off_on";
                }
                leaf "RR_WifiExt_OperationType" {
                    type "enumeration" {
                        enum "LB_wifi_operation_type_Ap" {
                            value "0";
                        }
                        enum "LB_wifi_operation_type_Client" {
                            value "1";
                        }
                    }
                    must "not ((. = 'LB_wifi_operation_type_Client' and (/config_data/auth/CnfAuth/RR_CnfAuthCnfVersion >= 0)))";
                }
                leaf "RR_WifiExt_AutoSsid" {
                    when "not (/config_data/main/WifiExt/RR_WifiExt_OperationType != 'LB_wifi_operation_type_Ap')";
                    type "lbox_off_on";
                }
                leaf "RR_WifiExt_MacAcl" {
                    when "not (/config_data/main/WifiExt/RR_WifiExt_OperationType != 'LB_wifi_operation_type_Ap')";
                    type "lbox_wifi_mac_acl";
                }
                leaf "RR_WifiExt_RmtAccEn" {
                    when "not (/config_data/main/UserAccess/RR_UsAcc_RmtAccess_Enable != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_WifiExt_HideSsid" {
                    when "not (/config_data/main/WifiExt/RR_WifiExt_OperationType != 'LB_wifi_operation_type_Ap')";
                    type "lbox_off_on";
                }
                leaf "RR_WifiExt_Ssid" {
                    when "not (/config_data/main/WifiExt/RR_WifiExt_AutoSsid != 'Off')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{1,32}";
                    }
                }
                leaf "RR_WifiExt_Password" {
                    when "not (/config_data/main/WifiExt/RR_WifiExt_Security = 'LB_wifi_security_Off')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,63}";
                    }
                }
                leaf "RR_WifiExt_Security" {
                    type "lbox_wifi_security";
                }
                leaf "RR_WifiExt_Encryption" {
                    when "not (/config_data/main/WifiExt/RR_WifiExt_Security = 'LB_wifi_security_Off')";
                    type "enumeration" {
                        enum "LB_wifi_ext_encryption_Tkip" {
                            value "0";
                        }
                        enum "LB_wifi_ext_encryption_Aes" {
                            value "1";
                        }
                        enum "LB_wifi_ext_encryption_TkipAes" {
                            value "2";
                        }
                    }
                    must "not ((. = 'LB_wifi_ext_encryption_Tkip' and ((/config_data/main/WifiExt/RR_WifiExt_Security = 'LB_wifi_security_Wpa3') or (/config_data/main/WifiExt/RR_WifiExt_Mode = 'LB_wifi_ext_mode_80211bgn') or (/config_data/main/WifiExt/RR_WifiExt_Mode = 'LB_wifi_ext_mode_80211an') or (/config_data/main/WifiExt/RR_WifiExt_Mode = 'LB_wifi_ext_mode_80211anac'))) or (. = 'LB_wifi_ext_encryption_TkipAes' and ((/config_data/main/WifiExt/RR_WifiExt_Security = 'LB_wifi_security_Wpa3') or (/config_data/main/WifiExt/RR_WifiExt_Mode = 'LB_wifi_ext_mode_80211bgn') or (/config_data/main/WifiExt/RR_WifiExt_Mode = 'LB_wifi_ext_mode_80211an') or (/config_data/main/WifiExt/RR_WifiExt_Mode = 'LB_wifi_ext_mode_80211anac'))))";
                }
                leaf "RR_WifiExt_Mode" {
                    type "enumeration" {
                        enum "LB_wifi_ext_mode_80211a" {
                            value "0";
                        }
                        enum "LB_wifi_ext_mode_80211b" {
                            value "1";
                        }
                        enum "LB_wifi_ext_mode_80211bg" {
                            value "2";
                        }
                        enum "LB_wifi_ext_mode_80211bgn" {
                            value "3";
                        }
                        enum "LB_wifi_ext_mode_80211an" {
                            value "4";
                        }
                        enum "LB_wifi_ext_mode_80211anac" {
                            value "5";
                        }
                    }
                    must "not ((. = 'LB_wifi_ext_mode_80211a' and (/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211a != 'On')) or (. = 'LB_wifi_ext_mode_80211b' and (/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211b != 'On')) or (. = 'LB_wifi_ext_mode_80211bg' and ((/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211b != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211g != 'On'))) or (. = 'LB_wifi_ext_mode_80211bgn' and ((/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211b != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211g != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211n != 'On'))) or (. = 'LB_wifi_ext_mode_80211an' and ((/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211a != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211n != 'On'))) or (. = 'LB_wifi_ext_mode_80211anac' and ((/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211a != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211n != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_80211ac != 'On'))))";
                }
                leaf "RR_WifiExt_Band" {
                    type "enumeration" {
                        enum "LB_wifi_ext_band_24GHz" {
                            value "0";
                        }
                        enum "LB_wifi_ext_band_5GHz" {
                            value "1";
                        }
                    }
                    must "not ((. = 'LB_wifi_ext_band_24GHz' and ((/config_data/main/WifiExt/RR_WifiExt_Mode != 'LB_wifi_ext_mode_80211b') and (/config_data/main/WifiExt/RR_WifiExt_Mode != 'LB_wifi_ext_mode_80211bg') and (/config_data/main/WifiExt/RR_WifiExt_Mode != 'LB_wifi_ext_mode_80211bgn'))) or (. = 'LB_wifi_ext_band_5GHz' and ((/config_data/main/WifiExt/RR_WifiExt_Mode != 'LB_wifi_ext_mode_80211a') and (/config_data/main/WifiExt/RR_WifiExt_Mode != 'LB_wifi_ext_mode_80211an') and (/config_data/main/WifiExt/RR_WifiExt_Mode != 'LB_wifi_ext_mode_80211anac'))))";
                }
                leaf "RR_WifiExt_Bandwidth" {
                    type "enumeration" {
                        enum "LB_wifi_ext_bandwidth_20MHz" {
                            value "0";
                        }
                        enum "LB_wifi_ext_bandwidth_40MHz" {
                            value "1";
                        }
                        enum "LB_wifi_ext_bandwidth_80MHz" {
                            value "2";
                        }
                    }
                    must "not ((. = 'LB_wifi_ext_bandwidth_40MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Mode != 'LB_wifi_ext_mode_80211a') and (/config_data/main/WifiExt/RR_WifiExt_Mode != 'LB_wifi_ext_mode_80211bgn') and (/config_data/main/WifiExt/RR_WifiExt_Mode != 'LB_wifi_ext_mode_80211an') and (/config_data/main/WifiExt/RR_WifiExt_Mode != 'LB_wifi_ext_mode_80211anac'))) or (. = 'LB_wifi_ext_bandwidth_80MHz' and (/config_data/main/WifiExt/RR_WifiExt_Mode != 'LB_wifi_ext_mode_80211anac')))";
                }
                leaf "RR_WifiExt_Channel24GHz" {
                    when "not (/config_data/main/WifiExt/RR_WifiExt_Band != 'LB_wifi_ext_band_24GHz')";
                    type "enumeration" {
                        enum "LB_wifi_ext_channel_Automatic" {
                            value "0";
                        }
                        enum "LB_wifi_ext_channel_1_2412MHz" {
                            value "1";
                        }
                        enum "LB_wifi_ext_channel_2_2417MHz" {
                            value "2";
                        }
                        enum "LB_wifi_ext_channel_3_2422MHz" {
                            value "3";
                        }
                        enum "LB_wifi_ext_channel_4_2427MHz" {
                            value "4";
                        }
                        enum "LB_wifi_ext_channel_5_2432MHz" {
                            value "5";
                        }
                        enum "LB_wifi_ext_channel_6_2437MHz" {
                            value "6";
                        }
                        enum "LB_wifi_ext_channel_7_2442MHz" {
                            value "7";
                        }
                        enum "LB_wifi_ext_channel_8_2447MHz" {
                            value "8";
                        }
                        enum "LB_wifi_ext_channel_9_2452MHz" {
                            value "9";
                        }
                        enum "LB_wifi_ext_channel_10_2457MHz" {
                            value "10";
                        }
                        enum "LB_wifi_ext_channel_11_2462MHz" {
                            value "11";
                        }
                        enum "LB_wifi_ext_channel_12_2467MHz" {
                            value "12";
                        }
                        enum "LB_wifi_ext_channel_13_2472MHz" {
                            value "13";
                        }
                        enum "LB_wifi_ext_channel_14_2484MHz" {
                            value "14";
                        }
                    }
                    must "not ((. = 'LB_wifi_ext_channel_1_2412MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_2_2417MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_3_2422MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_4_2427MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_5_2432MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_6_2437MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_7_2442MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_8_2447MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_9_2452MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_10_2457MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_11_2462MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_12_2467MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_13_2472MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_14_2484MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')))";
                }
                leaf "RR_WifiExt_Channel5GHz" {
                    when "not (/config_data/main/WifiExt/RR_WifiExt_Band != 'LB_wifi_ext_band_5GHz')";
                    type "enumeration" {
                        enum "LB_wifi_ext_channel_Automatic" {
                            value "0";
                        }
                        enum "LB_wifi_ext_channel_36_5180MHz" {
                            value "36";
                        }
                        enum "LB_wifi_ext_channel_40_5200MHz" {
                            value "40";
                        }
                        enum "LB_wifi_ext_channel_44_5220MHz" {
                            value "44";
                        }
                        enum "LB_wifi_ext_channel_48_5240MHz" {
                            value "48";
                        }
                        enum "LB_wifi_ext_channel_52_5260MHz" {
                            value "52";
                        }
                        enum "LB_wifi_ext_channel_56_5280MHz" {
                            value "56";
                        }
                        enum "LB_wifi_ext_channel_60_5300MHz" {
                            value "60";
                        }
                        enum "LB_wifi_ext_channel_64_5320MHz" {
                            value "64";
                        }
                        enum "LB_wifi_ext_channel_100_5500MHz" {
                            value "100";
                        }
                        enum "LB_wifi_ext_channel_104_5520MHz" {
                            value "104";
                        }
                        enum "LB_wifi_ext_channel_108_5540MHz" {
                            value "108";
                        }
                        enum "LB_wifi_ext_channel_112_5560MHz" {
                            value "112";
                        }
                        enum "LB_wifi_ext_channel_116_5580MHz" {
                            value "116";
                        }
                        enum "LB_wifi_ext_channel_120_5600MHz" {
                            value "120";
                        }
                        enum "LB_wifi_ext_channel_124_5620MHz" {
                            value "124";
                        }
                        enum "LB_wifi_ext_channel_128_5640MHz" {
                            value "128";
                        }
                        enum "LB_wifi_ext_channel_132_5660MHz" {
                            value "132";
                        }
                        enum "LB_wifi_ext_channel_136_5680MHz" {
                            value "136";
                        }
                        enum "LB_wifi_ext_channel_140_5700MHz" {
                            value "140";
                        }
                        enum "LB_wifi_ext_channel_144_5720MHz" {
                            value "144";
                        }
                        enum "LB_wifi_ext_channel_149_5745MHz" {
                            value "149";
                        }
                        enum "LB_wifi_ext_channel_153_5765MHz" {
                            value "153";
                        }
                        enum "LB_wifi_ext_channel_157_5785MHz" {
                            value "157";
                        }
                        enum "LB_wifi_ext_channel_161_5805MHz" {
                            value "161";
                        }
                        enum "LB_wifi_ext_channel_165_5825MHz" {
                            value "165";
                        }
                    }
                    must "not ((. = 'LB_wifi_ext_channel_40_5200MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_44_5220MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_48_5240MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_56_5280MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_60_5300MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_64_5320MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_104_5520MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_108_5540MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_112_5560MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_120_5600MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_124_5620MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_128_5640MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_136_5680MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_140_5700MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_144_5720MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_153_5765MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_157_5785MHz' and ((/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz') and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_40MHz'))) or (. = 'LB_wifi_ext_channel_161_5805MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')) or (. = 'LB_wifi_ext_channel_165_5825MHz' and (/config_data/main/WifiExt/RR_WifiExt_Bandwidth != 'LB_wifi_ext_bandwidth_20MHz')))";
                }
                leaf "RR_WifiExt_AutoTxPower" {
                    when "not (((/config_data/main/WifiExt/RR_WifiExt_Band = 'LB_wifi_ext_band_24GHz') and (/config_data/main/WifiExt/RR_WifiExt_Channel24GHz = 'LB_wifi_ext_channel_Automatic')) or ((/config_data/main/WifiExt/RR_WifiExt_Band = 'LB_wifi_ext_band_5GHz') and (/config_data/main/WifiExt/RR_WifiExt_Channel5GHz = 'LB_wifi_ext_channel_Automatic')))";
                    type "lbox_off_on";
                }
                leaf "RR_WifiExt_TxPower" {
                    when "not ((/config_data/main/WifiExt/RR_WifiExt_AutoTxPower != 'Off') or ((/config_data/main/WifiExt/RR_WifiExt_Band = 'LB_wifi_ext_band_24GHz') and (/config_data/main/WifiExt/RR_WifiExt_Channel24GHz = 'LB_wifi_ext_channel_Automatic')) or ((/config_data/main/WifiExt/RR_WifiExt_Band = 'LB_wifi_ext_band_5GHz') and (/config_data/main/WifiExt/RR_WifiExt_Channel5GHz = 'LB_wifi_ext_channel_Automatic')))";
                    type "uint8" {
                        range "0..16";
                    }
                    must ". <= /config_data/device/DeviceHw/RR_DynHw_Wifi_Ext_TxPowerMax" {
                        error-message "valmsg_it_WifiExt_TxPower";
                    }
                }
                leaf "RR_WifiExt_Antenna1Config" {
                    type "lbox_antenna_config";
                }
                leaf "RR_WifiExt_Antenna2Config" {
                    type "lbox_antenna_config";
                }
                leaf "RR_WifiExt_AntennaGain" {
                    type "uint8" {
                        range "0..30";
                    }
                }
                leaf "RR_WifiExt_CableLoss" {
                    type "uint8" {
                        range "0..30";
                    }
                }
                leaf "RR_WifiExt_Mtu" {
                    when "not (/config_data/main/WifiExt/RR_WifiExt_OperationType != 'LB_wifi_operation_type_Ap')";
                    type "uint16" {
                        range "256..1500";
                    }
                }
            }
            container "Networking" {
                leaf "RR_FirewallL3Mode" {
                    type "lbox_off_on";
                }
                leaf "RR_FirewallL2AccessCtrl" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "Blacklist" {
                            value "1";
                        }
                        enum "Whitelist" {
                            value "2";
                        }
                    }
                }
                leaf "RR_AdvancedDynRouting" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and ((/config_data/device/DeviceSwKey/RR_SwKey_Flag_routing_bgp != 'On') and (/config_data/device/DeviceSwKey/RR_SwKey_Flag_routing_ospf != 'On') and (/config_data/device/DeviceSwKey/RR_SwKey_Flag_routing_babel != 'On'))))";
                }
                leaf "RR_NatMode" {
                    type "lbox_off_on";
                }
                leaf "RR_QoSMode" {
                    type "lbox_off_on";
                }
                leaf "RR_LinkManagerEn" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (/config_data/device/DeviceSwKey/RR_SwKey_Flag_routing_link_management != 'On')))";
                }
                leaf "RR_FirewallL2Mode" {
                    type "lbox_off_on";
                }
                leaf "RR_PppoeClient_Enable" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (/config_data/device/DeviceSwKey/RR_SwKey_Flag_interface_pppoe_client != 'On')))";
                }
                leaf "RR_DhcpServerEn" {
                    type "lbox_off_on";
                }
                leaf "RR_DnsForwardingEn" {
                    type "lbox_off_on";
                }
            }
            container "NetworkingHelpers" {
                leaf "RR_NetHelper_Ftp" {
                    type "lbox_off_on";
                }
                leaf "RR_NetHelper_Ftp_Port" {
                    when "not (/config_data/main/NetworkingHelpers/RR_NetHelper_Ftp != 'On')";
                    type "lim_udp_port";
                }
            }
            container "FirewallL3Log" {
                when "not (/config_data/main/Networking/RR_FirewallL3Mode != 'On')";
                leaf "RR_FirewallL3Log_En" {
                    type "lbox_off_on";
                }
                leaf "RR_FirewallL3Log_PacketCount" {
                    when "not (/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On')";
                    type "lim_fwall_traffic_filter";
                    must ". <= /config_data/main/FirewallL3Log/RR_FirewallL3Log_PacketBurst" {
                        error-message "valmsg_it_FirewallL3Log_PacketCount";
                    }
                }
                leaf "RR_FirewallL3Log_TimePeriod" {
                    when "not (/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On')";
                    type "lbox_fwall_filter_limit_period";
                }
                leaf "RR_FirewallL3Log_PacketBurst" {
                    when "not (/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On')";
                    type "lim_fwall_traffic_filter";
                    must ". >= /config_data/main/FirewallL3Log/RR_FirewallL3Log_PacketCount" {
                        error-message "valmsg_it_FirewallL3Log_PacketBurst";
                    }
                }
            }
            container "FirewallL2AccLog" {
                when "not (/config_data/main/Networking/RR_FirewallL2AccessCtrl = 'Off')";
                leaf "RR_FirewallL2AccLog_En" {
                    type "lbox_off_on";
                }
                leaf "RR_FirewallL2AccLog_FrameCount" {
                    when "not (/config_data/main/FirewallL2AccLog/RR_FirewallL2AccLog_En != 'On')";
                    type "lim_fwall_traffic_filter";
                    must ". <= /config_data/main/FirewallL2AccLog/RR_FirewallL2AccLog_FrameBurst" {
                        error-message "valmsg_it_FirewallL2AccLog_FrameCount";
                    }
                }
                leaf "RR_FirewallL2AccLog_TimePeriod" {
                    when "not (/config_data/main/FirewallL2AccLog/RR_FirewallL2AccLog_En != 'On')";
                    type "lbox_fwall_filter_limit_period";
                }
                leaf "RR_FirewallL2AccLog_FrameBurst" {
                    when "not (/config_data/main/FirewallL2AccLog/RR_FirewallL2AccLog_En != 'On')";
                    type "lim_fwall_traffic_filter";
                    must ". >= /config_data/main/FirewallL2AccLog/RR_FirewallL2AccLog_FrameCount" {
                        error-message "valmsg_it_FirewallL2AccLog_FrameBurst";
                    }
                }
            }
            container "FirewallL2FwdLog" {
                when "not (/config_data/main/Networking/RR_FirewallL2Mode != 'On')";
                leaf "RR_FirewallL2FwdLog_En" {
                    type "lbox_off_on";
                }
                leaf "RR_FirewallL2FwdLog_FrameCount" {
                    when "not (/config_data/main/FirewallL2FwdLog/RR_FirewallL2FwdLog_En != 'On')";
                    type "lim_fwall_traffic_filter";
                    must ". <= /config_data/main/FirewallL2FwdLog/RR_FirewallL2FwdLog_FrameBurst" {
                        error-message "valmsg_it_FirewallL2FwdLog_FrameCount";
                    }
                }
                leaf "RR_FirewallL2FwdLog_TimePeriod" {
                    when "not (/config_data/main/FirewallL2FwdLog/RR_FirewallL2FwdLog_En != 'On')";
                    type "lbox_fwall_filter_limit_period";
                }
                leaf "RR_FirewallL2FwdLog_FrameBurst" {
                    when "not (/config_data/main/FirewallL2FwdLog/RR_FirewallL2FwdLog_En != 'On')";
                    type "lim_fwall_traffic_filter";
                    must ". >= /config_data/main/FirewallL2FwdLog/RR_FirewallL2FwdLog_FrameCount" {
                        error-message "valmsg_it_FirewallL2FwdLog_FrameBurst";
                    }
                }
            }
            container "NatLog" {
                when "not (/config_data/main/Networking/RR_NatMode != 'On')";
                leaf "RR_NatLog_En" {
                    type "lbox_off_on";
                }
                leaf "RR_NatLog_PacketCount" {
                    when "not (/config_data/main/NatLog/RR_NatLog_En != 'On')";
                    type "lim_fwall_traffic_filter";
                    must ". <= /config_data/main/NatLog/RR_NatLog_PacketBurst" {
                        error-message "valmsg_it_NatLog_PacketCount";
                    }
                }
                leaf "RR_NatLog_TimePeriod" {
                    when "not (/config_data/main/NatLog/RR_NatLog_En != 'On')";
                    type "lbox_fwall_filter_limit_period";
                }
                leaf "RR_NatLog_PacketBurst" {
                    when "not (/config_data/main/NatLog/RR_NatLog_En != 'On')";
                    type "lim_fwall_traffic_filter";
                    must ". >= /config_data/main/NatLog/RR_NatLog_PacketCount" {
                        error-message "valmsg_it_NatLog_PacketBurst";
                    }
                }
            }
            container "DnsForwarding" {
                when "not (/config_data/main/Networking/RR_DnsForwardingEn != 'On')";
                leaf "RR_DnsFwd_SrvPort" {
                    type "lim_udp_port";
                }
                leaf "RR_DnsFwd_ServerList" {
                    type "enumeration" {
                        enum "LB_DnsFwd_ServerList_V_Static" {
                            value "0";
                        }
                        enum "LB_DnsFwd_ServerList_V_Dynamic" {
                            value "1";
                        }
                    }
                }
                leaf "RR_DnsFwd_SrvSelection" {
                    type "enumeration" {
                        enum "LB_DnsFwd_SrvSelection_V_Round_robin" {
                            value "0";
                        }
                        enum "LB_DnsFwd_SrvSelection_V_Strict_order" {
                            value "1";
                        }
                        enum "LB_DnsFwd_SrvSelection_V_All_simult" {
                            value "2";
                        }
                    }
                }
                leaf "RR_DnsFwd_DynSrvSource" {
                    when "not (/config_data/main/DnsForwarding/RR_DnsFwd_ServerList != 'LB_DnsFwd_ServerList_V_Dynamic')";
                    type "enumeration" {
                        enum "WWAN (MAIN)" {
                            value "0";
                        }
                        enum "WWAN (EXT)" {
                            value "1";
                        }
                        enum "PPP 1" {
                            value "2";
                        }
                        enum "PPP 2" {
                            value "3";
                        }
                        enum "PPP 3" {
                            value "4";
                        }
                        enum "LB_Routing_Mode_Pppoe_client" {
                            value "5";
                        }
                    }
                    must "not ((. = 'WWAN (MAIN)' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On')) or (. = 'WWAN (EXT)' and (/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On')) or (. = 'PPP 1' and (/config_data/device/DeviceHw/RR_DynHw_Port_Com1 != 'On')) or (. = 'PPP 2' and (/config_data/device/DeviceHw/RR_DynHw_Port_Com2 != 'On')) or (. = 'PPP 3' and (/config_data/device/DeviceHw/RR_DynHw_Port_Com3 != 'On')))";
                }
                leaf "RR_DnsFwd_Cache" {
                    type "lbox_off_on";
                }
                leaf "RR_DnsFwd_MaxRequests" {
                    type "uint8" {
                        range "5..250";
                    }
                }
                leaf "RR_DnsFwd_CacheSize" {
                    when "not (/config_data/main/DnsForwarding/RR_DnsFwd_Cache != 'On')";
                    type "uint16" {
                        range "50..10000";
                    }
                }
                leaf "RR_DnsFwd_ServeLocal" {
                    type "lbox_off_on";
                }
                leaf "RR_DnsFwd_IsolateLocalNet" {
                    type "lbox_off_on";
                }
                leaf "RR_DnsFwd_DetectLoops" {
                    type "lbox_off_on";
                }
                leaf "RR_DnsFwd_FilterWindows" {
                    type "lbox_off_on";
                }
                leaf "RR_DnsFwd_DnsSec" {
                    when "not (/config_data/main/DnsForwarding/RR_DnsFwd_Cache != 'On')";
                    type "lbox_off_on";
                }
            }
            container "AdvDynamicRouting" {
                when "not (/config_data/main/Networking/RR_AdvancedDynRouting != 'On')";
                leaf "RR_ADR_RouterId" {
                    type "inet:ipv4-address";
                }
                leaf "RR_ADR_OspfEn" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (/config_data/device/DeviceSwKey/RR_SwKey_Flag_routing_ospf != 'On')))";
                }
                leaf "RR_ADR_BgpEn" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (/config_data/device/DeviceSwKey/RR_SwKey_Flag_routing_bgp != 'On')))";
                }
                leaf "RR_ADR_BabelEn" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (/config_data/device/DeviceSwKey/RR_SwKey_Flag_routing_babel != 'On')))";
                }
                leaf "RR_ADR_KernelMetric" {
                    type "lim_routing_metric_dyn";
                }
            }
            container "Ospf" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On'))";
                leaf "RR_Ospf_InstanceId" {
                    type "lim_uint_8";
                }
                leaf "RR_OspfImFil_Policy" {
                    type "lbox_adr_filter_policy";
                }
                leaf "RR_OspfExFil_Policy" {
                    type "lbox_adr_filter_policy";
                }
            }
            container "Bgp" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On'))";
                leaf "RR_Bgp_LocalAS" {
                    type "lim_uint_32";
                }
                leaf "RR_Bgp_LocalRouterPreference" {
                    type "lim_uint_32";
                }
                leaf "RR_Bgp_SetMED" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "Static" {
                            value "1";
                        }
                        enum "OSPF metric 1" {
                            value "2";
                        }
                        enum "Babel metric" {
                            value "3";
                        }
                    }
                    must "not ((. = 'OSPF metric 1' and (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On')) or (. = 'Babel metric' and (/config_data/main/AdvDynamicRouting/RR_ADR_BabelEn != 'On')))";
                }
                leaf "RR_Bgp_RouteReflector" {
                    type "lbox_off_on";
                }
                leaf "RR_Bgp_RRClusterIdType" {
                    when "not (/config_data/main/Bgp/RR_Bgp_RouteReflector != 'On')";
                    type "enumeration" {
                        enum "Router Id" {
                            value "0";
                        }
                        enum "Manual" {
                            value "1";
                        }
                    }
                }
                leaf "RR_BgpImIgpFil_Policy" {
                    type "lbox_adr_filter_policy";
                }
                leaf "RR_BgpExIgpFil_Policy" {
                    type "lbox_adr_filter_policy";
                }
                leaf "RR_BgpImOutFil_Policy" {
                    type "lbox_adr_filter_policy";
                }
                leaf "RR_BgpExOutFil_Policy" {
                    type "lbox_adr_filter_policy";
                }
                leaf "RR_Bgp_StaticMED" {
                    when "not (/config_data/main/Bgp/RR_Bgp_SetMED = 'Off')";
                    type "lim_uint_32";
                }
                leaf "RR_Bgp_RRClusterId" {
                    when "not ((/config_data/main/Bgp/RR_Bgp_RouteReflector != 'On') or (/config_data/main/Bgp/RR_Bgp_RRClusterIdType != 'Manual'))";
                    type "inet:ipv4-address";
                }
                leaf "RR_BgpImOutFil_Limit" {
                    type "lim_uint_16_1toFF";
                }
            }
            container "Babel" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_BabelEn != 'On'))";
                leaf "RR_Babel_RandomizeId" {
                    type "lbox_off_on";
                }
                leaf "RR_BabelRelFil_Policy" {
                    type "lbox_adr_filter_policy";
                }
                leaf "RR_BabelImFil_Policy" {
                    type "lbox_adr_filter_policy";
                }
                leaf "RR_BabelExFil_Policy" {
                    type "lbox_adr_filter_policy";
                }
                leaf "RR_BabelPreFil_Poisoned" {
                    type "lbox_off_on";
                }
                leaf "RR_BabelPreFil_LimitMetric" {
                    type "lbox_off_on";
                }
                leaf "RR_BabelPreFil_LimitMetricThr" {
                    when "not (/config_data/main/Babel/RR_BabelPreFil_LimitMetric != 'On')";
                    type "lim_adr_babel_metric";
                }
            }
            container "LinkManager" {
                when "not (/config_data/main/Networking/RR_LinkManagerEn != 'On')";
                description "Cnf. group for Link Manager: common";
                leaf "RR_LinkMng_IpSecControl" {
                    when "not (/config_data/main/VPN/RR_IpSecEnable != 'On')";
                    type "lbox_off_on";
                }
            }
            container "PppoeClient" {
                when "not (/config_data/main/Networking/RR_PppoeClient_Enable != 'On')";
                leaf "RR_PppoeClient_MngEn" {
                    type "lbox_off_on";
                }
                leaf "RR_PppoeClient_Masquerade" {
                    type "lbox_off_on";
                }
                leaf "RR_PppoeClient_NetMask" {
                    type "lim_ipv4_mask0";
                }
                leaf "RR_PppoeClient_CtrlMsgLogEn" {
                    type "lbox_off_on";
                }
                leaf "RR_PppoeClient_IfaceIdSelect" {
                    type "enumeration" {
                        enum "LB_lan_vlan_iface_select_Lan" {
                            value "0";
                        }
                        enum "LB_lan_vlan_iface_select_Vlan" {
                            value "1";
                        }
                    }
                }
                leaf "RR_PppoeClient_RmtAccEn" {
                    when "not (/config_data/main/UserAccess/RR_UsAcc_RmtAccess_Enable != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_PppoeClient_IfaceIdVlan" {
                    when "not (/config_data/main/PppoeClient/RR_PppoeClient_IfaceIdSelect != 'LB_lan_vlan_iface_select_Vlan')";
                    type "lim_uint_16";
                }
                leaf "RR_PppoeClient_IfaceIdLan" {
                    when "not (/config_data/main/PppoeClient/RR_PppoeClient_IfaceIdSelect != 'LB_lan_vlan_iface_select_Lan')";
                    type "lim_uint_16";
                }
                leaf "RR_PppoeClient_Username" {
                    type "string" {
                        pattern "[ !#%-:<-\\[\\]-_a-~]{0,64}";
                    }
                }
                leaf "RR_PppoeClient_Password" {
                    type "string" {
                        pattern "[ !#%-:<-\\[\\]-_a-~]{0,64}";
                    }
                }
                leaf "RR_PppoeClient_SvcName" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,64}";
                    }
                }
                leaf "RR_PppoeClient_AcName" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,64}";
                    }
                }
                leaf "RR_PppoeClient_HostUniq" {
                    type "string" {
                        pattern "([0-9a-fA-F][0-9a-fA-F])*";
                    }
                    must "string-length(.) <= 64" {
                        error-message "valmsg_it_Pppoe_Client_HostUniq";
                    }
                }
                leaf "RR_PppoeClient_LcpKeepFailureCnt" {
                    type "lim_uint_8";
                }
                leaf "RR_PppoeClient_LcpKeepInterval" {
                    when "not (/config_data/main/PppoeClient/RR_PppoeClient_LcpKeepFailureCnt = '0')";
                    type "lim_uint_16_1toFF";
                }
                leaf "RR_PppoeClient_IdleTimeout" {
                    type "lim_uint_16";
                }
            }
            container "VPN" {
                leaf "RR_IpSecEnable" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and ((/config_data/device/DeviceHw/RR_DynHw_NoCrypt = 'On') or (/config_data/device/DeviceSwKey/RR_SwKey_Flag_vpn_ipsec != 'On'))))";
                }
                leaf "RR_GreL2Enable" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (/config_data/device/DeviceSwKey/RR_SwKey_Flag_vpn_gre != 'On')))";
                }
                leaf "RR_GreL3Enable" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (/config_data/device/DeviceSwKey/RR_SwKey_Flag_vpn_gre != 'On')))";
                }
                leaf "RR_OpenVpnEnable" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and ((/config_data/device/DeviceHw/RR_DynHw_NoCrypt = 'On') or (/config_data/device/DeviceSwKey/RR_SwKey_Flag_vpn_openvpn != 'On'))))";
                }
            }
            container "IpSecGlobal" {
                when "not (/config_data/main/VPN/RR_IpSecEnable != 'On')";
                leaf "RR_IpSecMakeBeforeBreak" {
                    type "lbox_off_on";
                }
            }
            container "Vrrp" {
                leaf "RR_Vrrp_Enable" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (/config_data/auth/CnfAuth/RR_CnfAuthCnfVersion >= 0)))";
                }
                leaf "RR_Vrrp_VRID" {
                    when "not (/config_data/main/Vrrp/RR_Vrrp_Enable != 'On')";
                    type "uint8" {
                        range "1..255";
                    }
                }
                leaf "RR_Vrrp_Prio" {
                    when "not (/config_data/main/Vrrp/RR_Vrrp_Enable != 'On')";
                    type "uint8" {
                        range "0..255";
                    }
                }
                leaf "RR_Vrrp_Timeout" {
                    when "not (/config_data/main/Vrrp/RR_Vrrp_Enable != 'On')";
                    type "uint8" {
                        range "0..255";
                    }
                }
            }
            container "HotStdby" {
                when "not (/config_data/device/DeviceHw/RR_DynHw_HotStandby != 'On')";
                leaf "RR_HotStdby_Enable" {
                    type "lbox_off_on";
                }
                leaf "RR_HotStdby_ToggleEnable" {
                    when "not (/config_data/main/HotStdby/RR_HotStdby_Enable != 'On')";
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (/config_data/auth/CnfAuth/RR_CnfAuthCnfVersion >= 0)))";
                }
                leaf "RR_HotStdby_MasterMode" {
                    when "not (/config_data/main/HotStdby/RR_HotStdby_Enable != 'On')";
                    type "enumeration" {
                        enum "HS_master" {
                            value "0";
                        }
                        enum "HS_slave" {
                            value "1";
                        }
                    }
                }
                leaf "RR_HotStdby_FallbackTime" {
                    when "not ((/config_data/main/HotStdby/RR_HotStdby_Enable != 'On') or (/config_data/main/HotStdby/RR_HotStdby_MasterMode = 'HS_slave'))";
                    type "uint16" {
                        range "15..8191";
                    }
                }
                leaf "RR_HotStdby_Mac" {
                    when "not (/config_data/main/HotStdby/RR_HotStdby_Enable != 'On')";
                    type "yang:mac-address";
                }
                leaf "RR_HotStdby_Ip" {
                    when "not (/config_data/main/HotStdby/RR_HotStdby_Enable != 'On')";
                    type "inet:ipv4-address";
                }
                leaf "RR_HotStdby_ToggleSwitchPeriod" {
                    when "not ((/config_data/main/HotStdby/RR_HotStdby_Enable != 'On') or (/config_data/main/HotStdby/RR_HotStdby_ToggleEnable != 'On'))";
                    type "uint32" {
                        range "60..8640000";
                    }
                }
                leaf "RR_HotStdby_ToggleSwitchTime" {
                    when "not ((/config_data/main/HotStdby/RR_HotStdby_Enable != 'On') or (/config_data/main/HotStdby/RR_HotStdby_ToggleEnable != 'On'))";
                    type "uint32" {
                        range "5..4320000";
                    }
                }
                leaf "RR_HotStdby_RadioMac" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/main/HotStdby/RR_HotStdby_Enable != 'On'))";
                    type "yang:mac-address";
                }
                leaf "RR_HotStdby_MngEn" {
                    when "not (/config_data/main/HotStdby/RR_HotStdby_Enable != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_HotStdby_RmtAccEn" {
                    when "not ((/config_data/main/HotStdby/RR_HotStdby_Enable != 'On') or (/config_data/main/UserAccess/RR_UsAcc_RmtAccess_Enable != 'On'))";
                    type "lbox_off_on";
                }
            }
            container "HotStdbyGuardEth" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_HotStandby != 'On') or (/config_data/main/HotStdby/RR_HotStdby_Enable != 'On'))";
                leaf "RR_HotStdby_Guard_Mode" {
                    type "enumeration" {
                        enum "INCLUDE" {
                            value "0";
                        }
                        enum "EXCLUDE" {
                            value "1";
                        }
                    }
                }
            }
            container "SleepMode" {
                leaf "RR_Sleep_Enable" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (((/config_data/device/DeviceHw/RR_DynHw_HotStandby = 'On') and (/config_data/main/HotStdby/RR_HotStdby_Enable = 'On')) or ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio = 'On') and (/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'Base driven') and (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType = 'Base')))))";
                }
                leaf "RR_Sleep_WakeOnTime" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Rtc != 'On') or (/config_data/main/SleepMode/RR_Sleep_Enable != 'On'))";
                    type "lbox_off_on";
                }
                leaf "RR_Sleep_SleepOnTime" {
                    when "not (/config_data/main/SleepMode/RR_Sleep_Enable != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_Sleep_WakeOnSI" {
                    when "not (/config_data/main/SleepMode/RR_Sleep_Enable != 'On')";
                    type "lbox_off_on";
                }
            }
            container "SleepModeWakeTime" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Rtc != 'On') or (/config_data/main/SleepMode/RR_Sleep_Enable != 'On') or (/config_data/main/SleepMode/RR_Sleep_WakeOnTime != 'On'))";
                leaf "RR_SleepWT_WakeFrom_H" {
                    type "lim_time_hours_day";
                }
                leaf "RR_SleepWT_WakeFrom_M" {
                    type "lim_time_minutes_hr";
                }
                leaf "RR_SleepWT_WakeUntil_M" {
                    type "lim_time_minutes_hr";
                }
                leaf "RR_SleepWT_WakeUntil_H" {
                    type "lim_time_hours_day";
                }
                leaf "RR_SleepWT_Period" {
                    type "uint16" {
                        range "5..1439";
                    }
                }
            }
            container "SleepModeSleepTime" {
                when "not ((/config_data/main/SleepMode/RR_Sleep_Enable != 'On') or (/config_data/main/SleepMode/RR_Sleep_SleepOnTime != 'On'))";
                leaf "RR_SleepST_PowerOnInterval" {
                    type "uint16" {
                        range "5..1439";
                    }
                }
                leaf "RR_SleepST_WakingReset" {
                    type "lbox_off_on";
                }
                leaf "RR_SleepST_WReset_OnMainAct" {
                    when "not ((/config_data/main/SleepModeSleepTime/RR_SleepST_WakingReset != 'On') or ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') and ((/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On') or (/config_data/main/Cellular/RR_CellMain_Enable != 'On'))))";
                    type "lbox_off_on";
                }
                leaf "RR_SleepST_WReset_OnExtAct" {
                    when "not ((/config_data/main/SleepModeSleepTime/RR_SleepST_WakingReset != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') or (/config_data/main/Cellular/RR_CellAux_Enable != 'On')) and ((/config_data/device/DeviceHw/RR_DynHw_Module_Wifi != 'On') or (/config_data/main/Wifi/RR_WifiExt_Enable != 'On'))))";
                    type "lbox_off_on";
                }
            }
            container "STP" {
                leaf "RR_STP_Priority" {
                    when "not (/config_data/main/STP/RR_STP_Ena != 'On')";
                    type "uint16" {
                        range "0..32768";
                    }
                }
                leaf "RR_STP_FwdDelay" {
                    when "not (/config_data/main/STP/RR_STP_Ena != 'On')";
                    type "uint8" {
                        range "2..30";
                    }
                }
                leaf "RR_STP_Ena" {
                    type "lbox_off_on";
                }
                leaf "RR_STP_HelloTime" {
                    when "not (/config_data/main/STP/RR_STP_Ena != 'On')";
                    type "uint8" {
                        range "1..10";
                    }
                }
                leaf "RR_STP_MaxAge" {
                    when "not (/config_data/main/STP/RR_STP_Ena != 'On')";
                    type "uint8" {
                        range "6..40";
                    }
                }
            }
            container "UserAccess" {
                leaf "RR_UsAcc_RadiusAuth" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (/config_data/device/DeviceSwKey/RR_SwKey_Flag_adm_radius != 'On')))";
                }
                leaf "RR_UsAcc_Ssh_Enable" {
                    type "lbox_off_on";
                }
                leaf "RR_UsAcc_Http_Enable" {
                    type "lbox_off_on";
                }
                leaf "RR_UsAcc_WebSrvCertSource" {
                    type "lbox_default_user";
                }
                leaf "RR_UsAcc_WebInactTimeout" {
                    type "uint16" {
                        range "5..2880";
                    }
                }
                leaf "RR_UsAcc_RmtAccessClientKeySource" {
                    when "not (/config_data/main/UserAccess/RR_UsAcc_RmtAccess_Enable != 'On')";
                    type "lbox_default_user";
                }
                leaf "RR_UsAcc_RmtAccess_Enable" {
                    type "lbox_off_on";
                }
                leaf "RR_UsAcc_Netconf_Enable" {
                    type "lbox_off_on";
                }
                leaf "RR_UsAcc_NetconfCli_Enable" {
                    type "lbox_off_on";
                }
                leaf "RR_UsAcc_Passwd_MinLen" {
                    type "uint8" {
                        range "5..64";
                    }
                }
                leaf "RR_UsAcc_Passwd_MinLCase" {
                    type "uint8" {
                        range "0..5";
                    }
                }
                leaf "RR_UsAcc_Passwd_MinUCase" {
                    type "uint8" {
                        range "0..5";
                    }
                }
                leaf "RR_UsAcc_Passwd_MinDigit" {
                    type "uint8" {
                        range "0..5";
                    }
                }
                leaf "RR_UsAcc_Passwd_MinSpec" {
                    type "uint8" {
                        range "0..5";
                    }
                }
                leaf "RR_UsAcc_Ssh_Port" {
                    when "not (/config_data/main/UserAccess/RR_UsAcc_Ssh_Enable != 'On')";
                    type "lim_udp_port";
                }
                leaf "RR_UsAcc_Http_Port" {
                    when "not (/config_data/main/UserAccess/RR_UsAcc_Http_Enable != 'On')";
                    type "lim_udp_port";
                }
                leaf "RR_UsAcc_Https_Port" {
                    type "lim_udp_port";
                }
                leaf "RR_UsAcc_Netconf_Port" {
                    when "not (/config_data/main/UserAccess/RR_UsAcc_Netconf_Enable != 'On')";
                    type "uint16";
                }
                leaf "RR_UsAcc_NetconfCli_Port" {
                    when "not (/config_data/main/UserAccess/RR_UsAcc_NetconfCli_Enable != 'On')";
                    type "lim_unpriv_port";
                }
            }
            container "UsAccRadius" {
                when "not (/config_data/main/UserAccess/RR_UsAcc_RadiusAuth != 'On')";
                leaf "RR_UsAccRad_ServerAddr" {
                    type "inet:ipv4-address";
                }
                leaf "RR_UsAccRad_Realm" {
                    type "string" {
                        pattern "(.{0}|[^\"`\\\\$;.]+\\.[^\"`\\\\$;]+)";
                    }
                    must "string-length(.) <= 32" {
                        error-message "valmsg_it_UsAccRad_Realm";
                    }
                }
                leaf "RR_UsAccRad_ReqTimeout" {
                    type "uint8" {
                        range "1..30";
                    }
                }
                leaf "RR_UsAccRad_ReqRetries" {
                    type "uint8" {
                        range "1..7";
                    }
                }
                leaf "RR_UsAccRad_AccLvlSource" {
                    type "enumeration" {
                        enum "Static" {
                            value "0";
                        }
                        enum "From server" {
                            value "1";
                        }
                    }
                }
                leaf "RR_UsAccRad_AccLvlStatic" {
                    when "not (/config_data/main/UsAccRadius/RR_UsAccRad_AccLvlSource != 'Static')";
                    type "enumeration" {
                        enum "guest" {
                            value "0";
                        }
                        enum "tech" {
                            value "1";
                        }
                        enum "sectech" {
                            value "2";
                        }
                        enum "admin" {
                            value "3";
                        }
                    }
                }
                leaf "RR_UsAccRad_MapGuest_From" {
                    when "not (/config_data/main/UsAccRadius/RR_UsAccRad_AccLvlSource != 'From server')";
                    type "lim_uint_32";
                    must ". <= /config_data/main/UsAccRadius/RR_UsAccRad_MapGuest_To" {
                        error-message "valmsg_it_UsAccRad_MapGuest_From";
                    }
                }
                leaf "RR_UsAccRad_MapGuest_To" {
                    when "not (/config_data/main/UsAccRadius/RR_UsAccRad_AccLvlSource != 'From server')";
                    type "lim_uint_32";
                    must ". >= /config_data/main/UsAccRadius/RR_UsAccRad_MapGuest_From" {
                        error-message "valmsg_it_UsAccRad_MapGuest_To";
                    }
                    must ". <= /config_data/main/UsAccRadius/RR_UsAccRad_MapTech_From - 1" {
                        error-message "valmsg_it_UsAccRad_MapGuest_To";
                    }
                }
                leaf "RR_UsAccRad_MapTech_From" {
                    when "not (/config_data/main/UsAccRadius/RR_UsAccRad_AccLvlSource != 'From server')";
                    type "lim_uint_32";
                    must ". >= /config_data/main/UsAccRadius/RR_UsAccRad_MapGuest_To + 1" {
                        error-message "valmsg_it_UsAccRad_MapTech_From";
                    }
                    must ". <= /config_data/main/UsAccRadius/RR_UsAccRad_MapTech_To" {
                        error-message "valmsg_it_UsAccRad_MapTech_From";
                    }
                }
                leaf "RR_UsAccRad_MapTech_To" {
                    when "not (/config_data/main/UsAccRadius/RR_UsAccRad_AccLvlSource != 'From server')";
                    type "lim_uint_32";
                    must ". >= /config_data/main/UsAccRadius/RR_UsAccRad_MapTech_From" {
                        error-message "valmsg_it_UsAccRad_MapTech_To";
                    }
                    must ". <= /config_data/main/UsAccRadius/RR_UsAccRad_MapSecTech_From - 1" {
                        error-message "valmsg_it_UsAccRad_MapTech_To";
                    }
                }
                leaf "RR_UsAccRad_MapSecTech_From" {
                    when "not (/config_data/main/UsAccRadius/RR_UsAccRad_AccLvlSource != 'From server')";
                    type "lim_uint_32";
                    must ". >= /config_data/main/UsAccRadius/RR_UsAccRad_MapTech_To + 1" {
                        error-message "valmsg_it_UsAccRad_MapSecTech_From";
                    }
                    must ". <= /config_data/main/UsAccRadius/RR_UsAccRad_MapSecTech_To" {
                        error-message "valmsg_it_UsAccRad_MapSecTech_From";
                    }
                }
                leaf "RR_UsAccRad_MapSecTech_To" {
                    when "not (/config_data/main/UsAccRadius/RR_UsAccRad_AccLvlSource != 'From server')";
                    type "lim_uint_32";
                    must ". >= /config_data/main/UsAccRadius/RR_UsAccRad_MapSecTech_From" {
                        error-message "valmsg_it_UsAccRad_MapSecTech_To";
                    }
                    must ". <= /config_data/main/UsAccRadius/RR_UsAccRad_MapAdmin_From - 1" {
                        error-message "valmsg_it_UsAccRad_MapSecTech_To";
                    }
                }
                leaf "RR_UsAccRad_MapAdmin_From" {
                    when "not (/config_data/main/UsAccRadius/RR_UsAccRad_AccLvlSource != 'From server')";
                    type "lim_uint_32";
                    must ". >= /config_data/main/UsAccRadius/RR_UsAccRad_MapSecTech_To + 1" {
                        error-message "valmsg_it_UsAccRad_MapAdmin_From";
                    }
                    must ". <= /config_data/main/UsAccRadius/RR_UsAccRad_MapAdmin_To" {
                        error-message "valmsg_it_UsAccRad_MapAdmin_From";
                    }
                }
                leaf "RR_UsAccRad_MapAdmin_To" {
                    when "not (/config_data/main/UsAccRadius/RR_UsAccRad_AccLvlSource != 'From server')";
                    type "lim_uint_32";
                    must ". >= /config_data/main/UsAccRadius/RR_UsAccRad_MapAdmin_From" {
                        error-message "valmsg_it_UsAccRad_MapAdmin_To";
                    }
                }
                leaf "RR_UsAccRad_Key" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,32}";
                    }
                }
            }
            container "UsAccWebSrvCert" {
                when "not (/config_data/main/UserAccess/RR_UsAcc_WebSrvCertSource != 'LB_default_user_User')";
                leaf "RR_UsAccWSC_PrivKeyId" {
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
                leaf "RR_UsAccWSC_CertId" {
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
                leaf "RR_UsAccWSC_CAChainId" {
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
                leaf "RR_UsAccWSC_DHParamsId" {
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
            }
            container "UsAccRmtAccClientKey" {
                when "not ((/config_data/main/UserAccess/RR_UsAcc_RmtAccess_Enable != 'On') or (/config_data/main/UserAccess/RR_UsAcc_RmtAccessClientKeySource != 'LB_default_user_User'))";
                leaf "RR_UsAccRmtA_ClientPrivKeyId" {
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
            }
            container "SNMP" {
                leaf "RR_SnmpMode" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "v1_v2c_v3" {
                            value "1";
                        }
                        enum "v3" {
                            value "2";
                        }
                    }
                }
                leaf "RR_SnmpV3_SecLevel" {
                    when "not (/config_data/main/SNMP/RR_SnmpMode = 'Off')";
                    type "enumeration" {
                        enum "NoAuthNoPriv" {
                            value "0";
                        }
                        enum "AuthNoPriv" {
                            value "1";
                        }
                        enum "AuthPriv" {
                            value "2";
                        }
                    }
                }
                leaf "RR_SnmpNotification" {
                    when "not (/config_data/main/SNMP/RR_SnmpMode = 'Off')";
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "Trap" {
                            value "1";
                        }
                        enum "Inform" {
                            value "2";
                        }
                    }
                }
                leaf "RR_SnmpNotifVersion" {
                    when "not ((/config_data/main/SNMP/RR_SnmpMode = 'Off') or (/config_data/main/SNMP/RR_SnmpNotification = 'Off'))";
                    type "enumeration" {
                        enum "v1" {
                            value "0";
                        }
                        enum "v2c" {
                            value "1";
                        }
                        enum "v3" {
                            value "2";
                        }
                    }
                    must "not ((. = 'v1' and (/config_data/main/SNMP/RR_SnmpNotification = 'Inform')) or (. = 'v3' and (/config_data/main/SNMP/RR_SnmpNotification = 'Inform')))";
                }
                leaf "RR_SnmpInformTimeout" {
                    when "not ((/config_data/main/SNMP/RR_SnmpMode = 'Off') or (/config_data/main/SNMP/RR_SnmpNotification != 'Inform'))";
                    type "decimal64" {
                        fraction-digits "1";
                        range "0.1..20.0";
                    }
                }
                leaf "RR_SnmpV1V2_CommName" {
                    when "not (/config_data/main/SNMP/RR_SnmpMode != 'v1_v2c_v3')";
                    type "string" {
                        pattern "[ !#%-\\)\\+-:<-\\?A-\\[\\]-_a-~]{1,32}";
                    }
                }
                leaf "RR_SnmpV3_SecUserName" {
                    when "not (/config_data/main/SNMP/RR_SnmpMode = 'Off')";
                    type "string" {
                        pattern "[!#%-\\)\\+-:<-\\?A-\\[\\]-_a-~]{0,32}";
                    }
                }
                leaf "RR_SnmpV3_EngineIdMode" {
                    when "not (/config_data/main/SNMP/RR_SnmpMode = 'Off')";
                    type "enumeration" {
                        enum "Default" {
                            value "0";
                        }
                        enum "UserDefined" {
                            value "1";
                        }
                    }
                }
                leaf "RR_SnmpInformRepeats" {
                    when "not ((/config_data/main/SNMP/RR_SnmpMode = 'Off') or (/config_data/main/SNMP/RR_SnmpNotification != 'Inform'))";
                    type "uint8" {
                        range "0..10";
                    }
                }
                leaf "RR_SnmpV3_EngineId" {
                    when "not ((/config_data/main/SNMP/RR_SnmpMode = 'Off') or (/config_data/main/SNMP/RR_SnmpV3_EngineIdMode != 'UserDefined'))";
                    type "string" {
                        pattern "[a-zA-Z0-9 _-]{0,27}";
                    }
                }
                leaf "RR_SnmpStatisticsTableUpdatePeriod" {
                    when "not (/config_data/main/SNMP/RR_SnmpMode = 'Off')";
                    type "uint16" {
                        range "1..1440";
                    }
                }
            }
            container "SnmpSecurity2" {
                when "not (/config_data/main/SNMP/RR_SnmpMode = 'Off')";
                description "Cnf. group for SNMP: security";
                leaf "RR_SnmpV3_AuthProtocol" {
                    when "not (/config_data/main/SNMP/RR_SnmpV3_SecLevel = 'NoAuthNoPriv')";
                    type "enumeration" {
                        enum "MD5_legacy" {
                            value "0";
                        }
                        enum "SHA1_legacy" {
                            value "1";
                        }
                        enum "SHA224" {
                            value "2";
                        }
                        enum "SHA256" {
                            value "3";
                        }
                        enum "SHA384" {
                            value "4";
                        }
                        enum "SHA512" {
                            value "5";
                        }
                    }
                }
                leaf "RR_SnmpV3_EncrProtocol" {
                    when "not (/config_data/main/SNMP/RR_SnmpV3_SecLevel != 'AuthPriv')";
                    type "enumeration" {
                        enum "DES_legacy" {
                            value "0";
                        }
                        enum "AES128" {
                            value "1";
                        }
                        enum "AES192" {
                            value "2";
                        }
                        enum "AES256" {
                            value "3";
                        }
                    }
                }
                leaf "RR_SnmpV3_AuthPassphrase" {
                    when "not (/config_data/main/SNMP/RR_SnmpV3_SecLevel = 'NoAuthNoPriv')";
                    type "string" {
                        pattern "(|[^\"`\\\\$;]{8,128})";
                    }
                }
                leaf "RR_SnmpV3_EncrPassphrase" {
                    when "not (/config_data/main/SNMP/RR_SnmpV3_SecLevel != 'AuthPriv')";
                    type "string" {
                        pattern "(|[^\"`\\\\$;]{8,128})";
                    }
                }
            }
            container "SyslogRmt" {
                leaf "RR_SyslogRmt_Enable" {
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_MaxSeverity" {
                    when "not (/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On')";
                    type "lbox_event_severity_error_down";
                    must "not ((. = 'Warning' and (/config_data/auth/CnfAuth/RR_CnfAuthCnfVersion >= 0)) or (. = 'Notice' and (/config_data/auth/CnfAuth/RR_CnfAuthCnfVersion >= 0)) or (. = 'Informational' and (/config_data/auth/CnfAuth/RR_CnfAuthCnfVersion >= 0)) or (. = 'Debug' and (/config_data/auth/CnfAuth/RR_CnfAuthCnfVersion >= 0)))";
                }
                leaf "RR_SyslogRmt_EventsEnable" {
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_EventsMaxSeverity" {
                    when "not (/config_data/main/SyslogRmt/RR_SyslogRmt_EventsEnable != 'On')";
                    type "lbox_event_severity_info_down";
                    must "not ((. = 'Debug' and (/config_data/auth/CnfAuth/RR_CnfAuthCnfVersion >= 0)))";
                }
                leaf "RR_SyslogRmt_EventsFacility" {
                    when "not (/config_data/main/SyslogRmt/RR_SyslogRmt_EventsEnable != 'On')";
                    type "enumeration" {
                        enum "LB_events_facility_Local0" {
                            value "0";
                        }
                        enum "LB_events_facility_Local1" {
                            value "1";
                        }
                        enum "LB_events_facility_Local2" {
                            value "2";
                        }
                        enum "LB_events_facility_Local3" {
                            value "3";
                        }
                        enum "LB_events_facility_Local4" {
                            value "4";
                        }
                        enum "LB_events_facility_Local5" {
                            value "5";
                        }
                        enum "LB_events_facility_Local6" {
                            value "6";
                        }
                        enum "LB_events_facility_Local7" {
                            value "7";
                        }
                    }
                }
                leaf "RR_SyslogRmt_TransportProtocol" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') and (/config_data/main/SyslogRmt/RR_SyslogRmt_EventsEnable != 'On'))";
                    type "lbox_transport_protocol";
                }
                leaf "RR_SyslogRmt_TcpKeepaliveEnable" {
                    when "not (((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') and (/config_data/main/SyslogRmt/RR_SyslogRmt_EventsEnable != 'On')) or (/config_data/main/SyslogRmt/RR_SyslogRmt_TransportProtocol != 'LB_transport_protocol_Tcp'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_TcpKeepaliveProbes" {
                    when "not (((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') and (/config_data/main/SyslogRmt/RR_SyslogRmt_EventsEnable != 'On')) or (/config_data/main/SyslogRmt/RR_SyslogRmt_TransportProtocol != 'LB_transport_protocol_Tcp') or (/config_data/main/SyslogRmt/RR_SyslogRmt_TcpKeepaliveEnable != 'On'))";
                    type "uint8" {
                        range "1..15";
                    }
                }
                leaf "RR_SyslogRmt_FacilitiesAll" {
                    when "not (/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityLocal0" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityLocal1" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityLocal2" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityLocal3" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityLocal4" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityLocal5" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityLocal6" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityLocal7" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_TcpKeepaliveIntvl" {
                    when "not (((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') and (/config_data/main/SyslogRmt/RR_SyslogRmt_EventsEnable != 'On')) or (/config_data/main/SyslogRmt/RR_SyslogRmt_TransportProtocol != 'LB_transport_protocol_Tcp') or (/config_data/main/SyslogRmt/RR_SyslogRmt_TcpKeepaliveEnable != 'On'))";
                    type "uint8" {
                        range "10..240";
                    }
                }
                leaf "RR_SyslogRmt_TcpKeepaliveTime" {
                    when "not (((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') and (/config_data/main/SyslogRmt/RR_SyslogRmt_EventsEnable != 'On')) or (/config_data/main/SyslogRmt/RR_SyslogRmt_TransportProtocol != 'LB_transport_protocol_Tcp') or (/config_data/main/SyslogRmt/RR_SyslogRmt_TcpKeepaliveEnable != 'On'))";
                    type "uint16" {
                        range "60..64800";
                    }
                }
                leaf "RR_SyslogRmt_IpAddr" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') and (/config_data/main/SyslogRmt/RR_SyslogRmt_EventsEnable != 'On'))";
                    type "inet:ipv4-address";
                }
                leaf "RR_SyslogRmt_IpPort" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') and (/config_data/main/SyslogRmt/RR_SyslogRmt_EventsEnable != 'On'))";
                    type "lim_udp_port";
                }
                leaf "RR_SyslogRmt_TimeReopen" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') and (/config_data/main/SyslogRmt/RR_SyslogRmt_EventsEnable != 'On'))";
                    type "uint8" {
                        range "1..240";
                    }
                }
                leaf "RR_SyslogRmt_FacilityKernel" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityUser" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityMail" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityDaemon" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityAuth" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilitySyslog" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_SyslogRmt_FacilityLinePrinter" {
                    when "not ((/config_data/main/SyslogRmt/RR_SyslogRmt_Enable != 'On') or (/config_data/main/SyslogRmt/RR_SyslogRmt_FacilitiesAll != 'Off'))";
                    type "lbox_off_on";
                }
