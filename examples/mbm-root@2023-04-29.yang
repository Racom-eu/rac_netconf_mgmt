                leaf "KrngGCSAN_Type" {
                    type "enumeration" {
                        enum "LB_KrngGCSAN_Type_IP" {
                            value "0";
                        }
                        enum "LB_KrngGCSAN_Type_DNS" {
                            value "1";
                        }
                    }
                    default "LB_KrngGCSAN_Type_IP";
                }
                leaf "KrngGCSAN_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "KrngGCSAN_IpAddr" {
                    when "not (../KrngGCSAN_Type != 'LB_KrngGCSAN_Type_IP')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "KrngGCSAN_DnsName" {
                    when "not (../KrngGCSAN_Type != 'LB_KrngGCSAN_Type_DNS')";
                    type "string" {
                        pattern "[a-zA-Z0-9.-]{0,128}";
                    }
                    default "";
                }
            }
            list "RR_S_TABLE_MqttBridgeTopics" {
                when "not ((/config_data/main/MqttBroker/RR_MqttBroker_Enable != 'On') or (/config_data/main/MqttBroker/RR_MqttBroker_BridgeEnable != 'On'))";
                key "ID";
                max-elements "10";
                min-elements "1";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "MqttBrTopic_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "MqttBrTopic_Direction" {
                    type "lbox_mqtt_direction";
                    default "LB_mqtt_direction_in";
                }
                leaf "MqttBrTopic_QoSLevel" {
                    type "lbox_mqtt_qos";
                    default "LB_mqtt_qos_0";
                }
                leaf "MqttBrTopic_Pattern" {
                    type "string" {
                        pattern "(([a-zA-Z0-9_]+(/([a-zA-Z0-9_]+|[+]))*(/#)?)|[#+])?";
                    }
                    default "";
                }
                leaf "MqttBrTopic_LocalPrefix" {
                    type "string" {
                        pattern "([a-zA-Z0-9_]+(/[a-zA-Z0-9_]+)*/?)?";
                    }
                    default "";
                }
                leaf "MqttBrTopic_RemotePrefix" {
                    type "string" {
                        pattern "([a-zA-Z0-9_]+(/[a-zA-Z0-9_]+)*/?)?";
                    }
                    default "";
                }
                leaf "MqttBrTopic_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
            }
        }
        container "auth" {
            container "CnfAuth" {
                leaf "RR_CnfAuthCnfVersion" {
                    type "uint16" {
                        range "0..1023";
                    }
                    must ". = 34" {
                        error-message "Wrong configuration version.";
                    }
                    mandatory "true";
                }
            }
        }
