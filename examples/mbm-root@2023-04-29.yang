exRx != '150') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_10_En != 'On'))) or (. = '150' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '150') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_17_En != 'On'))) or (. = '175' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '200') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_11_En != 'On'))) or (. = '200' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '200') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_12_En != 'On'))) or (. = '225' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '250') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_13_En != 'On'))) or (. = '250' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '250') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_14_En != 'On'))) or (. = '300' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '300') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_15_En != 'On'))) or (. = '400' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '400') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_19_En != 'On'))) or (. = '625' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '625') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_20_En != 'On'))) or (. = '1250' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '1250') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_21_En != 'On'))) or (. = '2500' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '2500') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_22_En != 'On'))) or (. = '5000' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '5000') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_23_En != 'On'))) or (. = '10000' and ((/config_data/main/RadioChannel/RR_RadioChSpacingDuplexRx != '10000') or (/config_data/region/Region/RR_DynReg_ChOccupied_Val_24_En != 'On'))))";
                }
            }
            container "RadioACM" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Radio_Acm != 'On') or (/config_data/main/RadioChannel/RR_RadioACMEn != 'On') or (/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'None'))";
                leaf "RR_RadioACMDefaultProfile" {
                    when "not ((/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'Base driven') and (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType != 'Base'))";
                    type "lbox_radio_acm_profiles_M1";
                    must "not ((. = 'LB_radio_acm_profiles_2CPFSK_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'FSK')) or (. = 'LB_radio_acm_profiles_4CPFSK_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'FSK')) or (. = 'LB_radio_acm_profiles_4CPFSK_1_1' and (/config_data/main/RadioChannel/RR_RadioModType != 'FSK')) or (. = 'LB_radio_acm_profiles_DPSK_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'LB_radio_acm_profiles_pi4DQPSK_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'LB_radio_acm_profiles_16DEQAM_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'LB_radio_acm_profiles_64QAM_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'LB_radio_acm_profiles_256QAM_3_4' and ((/config_data/main/RadioChannel/RR_RadioModType != 'QAM') or (/config_data/device/DeviceSwKey/RR_SwKey_Flag_radio_modulation_over_64QAM != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Radio_Modulation_Over_64QAM != 'On'))) or (. = 'LB_radio_acm_profiles_256QAM_5_6' and ((/config_data/main/RadioChannel/RR_RadioModType != 'QAM') or (/config_data/device/DeviceSwKey/RR_SwKey_Flag_radio_modulation_over_64QAM != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Radio_Modulation_Over_64QAM != 'On'))))";
                }
                leaf "RR_RadioACMBestProfile" {
                    when "not ((/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'Base driven') and (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType != 'Base'))";
                    type "lbox_radio_acm_profiles_M1";
                    must "not ((. = 'LB_radio_acm_profiles_2CPFSK_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'FSK')) or (. = 'LB_radio_acm_profiles_4CPFSK_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'FSK')) or (. = 'LB_radio_acm_profiles_4CPFSK_1_1' and (/config_data/main/RadioChannel/RR_RadioModType != 'FSK')) or (. = 'LB_radio_acm_profiles_DPSK_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'LB_radio_acm_profiles_pi4DQPSK_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'LB_radio_acm_profiles_16DEQAM_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'LB_radio_acm_profiles_64QAM_3_4' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'LB_radio_acm_profiles_256QAM_3_4' and ((/config_data/main/RadioChannel/RR_RadioModType != 'QAM') or (/config_data/device/DeviceSwKey/RR_SwKey_Flag_radio_modulation_over_64QAM != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Radio_Modulation_Over_64QAM != 'On'))) or (. = 'LB_radio_acm_profiles_256QAM_5_6' and ((/config_data/main/RadioChannel/RR_RadioModType != 'QAM') or (/config_data/device/DeviceSwKey/RR_SwKey_Flag_radio_modulation_over_64QAM != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Radio_Modulation_Over_64QAM != 'On'))))";
                }
                leaf "RR_RadioACMReplyTimeout" {
                    type "uint8" {
                        range "1..60";
                    }
                }
                leaf "RR_RadioACMFallbackTimeout" {
                    when "not ((/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'Base driven') and (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType != 'Base'))";
                    type "uint8" {
                        range "1..60";
                    }
                }
                leaf "RR_RadioACMMeasTimeConst" {
                    type "uint16" {
                        range "1..300";
                    }
                }
                leaf "RR_RadioACMBlockTimeStart" {
                    when "not ((/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'Base driven') and (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType != 'Base'))";
                    type "uint16" {
                        range "1..1440";
                    }
                    must ". <= /config_data/main/RadioACM/RR_RadioACMBlockTimeMax" {
                        error-message "valmsg_it_RadioACMBlockTimeStart";
                    }
                }
                leaf "RR_RadioACMBlockTimeMax" {
                    when "not ((/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'Base driven') and (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType != 'Base'))";
                    type "uint16" {
                        range "1..1440";
                    }
                    must ". >= /config_data/main/RadioACM/RR_RadioACMBlockTimeStart" {
                        error-message "valmsg_it_RadioACMBlockTimeMax";
                    }
                }
            }
            container "RadioProtocol" {
                when "not (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')";
                leaf "RR_RadioAccessProtocol" {
                    type "enumeration" {
                        enum "Transparent" {
                            value "0";
                        }
                        enum "Flexible" {
                            value "1";
                        }
                        enum "Base driven" {
                            value "2";
                        }
                        enum "None" {
                            value "3";
                        }
                    }
                    must "not ((. = 'Transparent' and (/config_data/main/RadioInterface/RR_RadioIfMode != 'Bridge')) or (. = 'Flexible' and ((/config_data/device/DeviceSwKey/RR_SwKey_Flag_radio_protocols != 'On') or (/config_data/main/RadioInterface/RR_RadioIfMode != 'Router'))) or (. = 'Base driven' and ((/config_data/device/DeviceHw/RR_DynHw_Radio_Protocol_Bdp != 'On') or (/config_data/device/DeviceSwKey/RR_SwKey_Flag_radio_protocols != 'On') or (/config_data/main/RadioInterface/RR_RadioIfMode != 'Router'))))";
                }
                leaf "RR_RadioCompression" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "LZO" {
                            value "1";
                        }
                    }
                }
                leaf "RR_RadioAck" {
                    when "not ((/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'Transparent' and /config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'None') or ((/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'Base driven') and (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType = 'Base')))";
                    type "lbox_off_on";
                }
                leaf "RR_RadioRetries" {
                    when "not ((/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'Transparent' and /config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'None') or ((/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'Base driven') and (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType = 'Base')) or (/config_data/main/RadioProtocol/RR_RadioAck != 'On'))";
                    type "lim_radio_retries";
                }
                leaf "RR_RadioEncryption" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "AES-256-CCM" {
                            value "1";
                        }
                        enum "AES-256-CCM + KEX" {
                            value "2";
                        }
                    }
                    must "not ((. = 'AES-256-CCM' and (/config_data/device/DeviceHw/RR_DynHw_NoCrypt = 'On')) or (. = 'AES-256-CCM + KEX' and (/config_data/device/DeviceHw/RR_DynHw_NoCrypt = 'On')))";
                }
            }
            container "RadioProtocolTrans" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/main/RadioProtocol/RR_RadioAccessProtocol != 'Transparent'))";
                leaf "RR_RadioTrans_Repeater" {
                    when "not ((/config_data/main/RadioChannel/RR_RadioACMEn = 'On') and (/config_data/device/DeviceHw/RR_DynHw_Radio_Acm = 'On'))";
                    type "lbox_off_on";
                }
                leaf "RR_RadioTrans_RepsNo" {
                    when "not ((/config_data/main/RadioChannel/RR_RadioACMEn = 'On') and (/config_data/device/DeviceHw/RR_DynHw_Radio_Acm = 'On'))";
                    type "uint8" {
                        range "0..7";
                    }
                }
                leaf "RR_RadioTrans_CommMode" {
                    type "enumeration" {
                        enum "Half Duplex" {
                            value "0";
                        }
                        enum "Full Duplex" {
                            value "1";
                        }
                    }
                    must "not ((. = 'Full Duplex' and ((/config_data/device/DeviceHw/RR_DynHw_Radio_Antenna_Dual != 'On') or (/config_data/device/DeviceSwKey/RR_SwKey_Flag_radio_full_duplex != 'On'))))";
                }
                leaf "RR_RadioTrans_TxDelay" {
                    type "uint16" {
                        range "0..16000";
                    }
                }
            }
            container "RadioProtocolBaseDr" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/main/RadioProtocol/RR_RadioAccessProtocol != 'Base driven'))";
                leaf "RR_RadioBDP_StationType" {
                    type "enumeration" {
                        enum "Remote" {
                            value "0";
                        }
                        enum "Base" {
                            value "1";
                        }
                    }
                    must "not ((. = 'Base' and (/config_data/device/DeviceHw/RR_DynHw_Radio_Protocol_Bdp_Base != 'On')))";
                }
                leaf "RR_RadioBDP_AutoAddress" {
                    when "not (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType != 'Remote')";
                    type "lbox_off_on";
                }
                leaf "RR_RadioBDP_Address" {
                    when "not ((/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType != 'Remote') or (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_AutoAddress = 'On'))";
                    type "lim_uint_8";
                }
                leaf "RR_RadioBDP_BurstSize" {
                    when "not (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType != 'Base')";
                    type "uint8" {
                        range "0..15";
                    }
                }
                leaf "RR_RadioBDP_BcastRepeats" {
                    when "not (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType != 'Base')";
                    type "uint8" {
                        range "0..15";
                    }
                }
                leaf "RR_RadioBDP_QueryTimeout" {
                    when "not (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType != 'Base')";
                    type "decimal64" {
                        fraction-digits "2";
                        range "0.01..30.0";
                    }
                }
            }
            container "RadioProtocolFlexible" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/main/RadioProtocol/RR_RadioAccessProtocol != 'Flexible'))";
                leaf "RR_RadioFlex_BcastRepeats" {
                    type "lim_radio_retries";
                }
                leaf "RR_RadioFlex_SlotsNo_Rx" {
                    type "uint8" {
                        range "0..12";
                    }
                }
                leaf "RR_RadioFlex_TxDelayBusy_Len" {
                    type "uint16" {
                        range "0..16000";
                    }
                }
                leaf "RR_RadioFlex_TxDelayFree_Prob" {
                    type "uint8" {
                        range "0..100";
                    }
                }
                leaf "RR_RadioFlex_TxDelayFree_Len" {
                    when "not (/config_data/main/RadioProtocolFlexible/RR_RadioFlex_TxDelayFree_Prob = 0)";
                    type "uint16" {
                        range "1..16000";
                    }
                }
                leaf "RR_RadioFlex_RssThold" {
                    type "uint8" {
                        range "50..150";
                    }
                }
                leaf "RR_RadioFlex_SlotLen" {
                    type "uint8" {
                        range "0..250";
                    }
                }
                leaf "RR_RadioFlex_SlotsNo_Tx" {
                    type "uint8" {
                        range "0..12";
                    }
                }
                leaf "RR_RadioFlex_SlotsNo_Add" {
                    type "uint8" {
                        range "0..7";
                    }
                }
                leaf "RR_RadioFlex_RetrTout_VarNo" {
                    type "uint8" {
                        range "0..15";
                    }
                }
                leaf "RR_RadioFlex_RetrTout_Progressive" {
                    type "lbox_off_on";
                }
                leaf "RR_RadioFlex_ComBcastRep_En" {
                    type "lbox_off_on";
                }
                leaf "RR_RadioFlex_ComBcastRep_DelayMode" {
                    when "not (/config_data/main/RadioProtocolFlexible/RR_RadioFlex_ComBcastRep_En = 'Off')";
                    type "enumeration" {
                        enum "Random" {
                            value "0";
                        }
                        enum "Fixed" {
                            value "1";
                        }
                    }
                }
                leaf "RR_RadioFlex_RetrTout_FixLen" {
                    type "uint16" {
                        range "10..10000";
                    }
                }
                leaf "RR_RadioFlex_RetrTout_VarLen" {
                    when "not (/config_data/main/RadioProtocolFlexible/RR_RadioFlex_RetrTout_VarNo = 0)";
                    type "uint16" {
                        range "10..10000";
                    }
                }
                leaf "RR_RadioFlex_ComBcastRep_DelaySlots" {
                    when "not (/config_data/main/RadioProtocolFlexible/RR_RadioFlex_ComBcastRep_En = 'Off')";
                    type "uint8" {
                        range "0..15";
                    }
                }
            }
            container "RadioEncryption" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/main/RadioProtocol/RR_RadioEncryption = 'Off'))";
                leaf "RR_RadioEncr_KeyMode" {
                    type "lbox_psk_key_mode";
                }
                leaf "RR_RadioEncr_Key2Mode" {
                    type "lbox_psk_key_mode";
                }
                leaf "RR_RadioEncr_KeyId" {
                    when "not (/config_data/main/RadioEncryption/RR_RadioEncr_KeyMode != 'Key')";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
                leaf "RR_RadioEncr_PassPhrase" {
                    when "not (/config_data/main/RadioEncryption/RR_RadioEncr_KeyMode != 'Pass Phrase')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,128}";
                    }
                }
                leaf "RR_RadioEncr_Key2Id" {
                    when "not (/config_data/main/RadioEncryption/RR_RadioEncr_Key2Mode != 'Key')";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
                leaf "RR_RadioEncr_PassPhrase2" {
                    when "not (/config_data/main/RadioEncryption/RR_RadioEncr_Key2Mode != 'Pass Phrase')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,128}";
                    }
                }
                leaf "RR_RadioEncr_RekeyPeriod" {
                    when "not (/config_data/main/RadioProtocol/RR_RadioEncryption != 'AES-256-CCM + KEX')";
                    type "uint16" {
                        range "5..10080";
                    }
                }
            }
            container "RadioProtocolQueues" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/main/RadioProtocol/RR_RadioAccessProtocol = 'None'))";
                leaf "RR_RadioQ_TxBufStoreToutEnable" {
                    type "lbox_off_on";
                }
                leaf "RR_RadioQ_QueueLen" {
                    type "uint8" {
                        range "1..31";
                    }
                }
                leaf "RR_RadioQ_TxBufStoreTout" {
                    when "not (/config_data/main/RadioProtocolQueues/RR_RadioQ_TxBufStoreToutEnable != 'On')";
                    type "decimal64" {
                        fraction-digits "2";
                        range "0.01..150.0";
                    }
                }
                leaf "RR_RadioQ_QueueSize" {
                    type "uint8" {
                        range "1..48";
                    }
                }
            }
            container "Cellular" {
                leaf "RR_CellMain_Enable" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_CellAux_Enable" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On')";
                    type "lbox_off_on";
                }
            }
            container "CellularMain" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On') or (/config_data/main/Cellular/RR_CellMain_Enable != 'On'))";
                leaf "RR_CellMain_Masquerade" {
                    type "lbox_off_on";
                }
                leaf "RR_CellMain_MngEn" {
                    type "lbox_off_on";
                }
                leaf "RR_CellMain_LinkTesting" {
                    type "lbox_off_on";
                }
                leaf "RR_CellMain_ProfileSwitching" {
                    type "lbox_off_on";
                }
                leaf "RR_CellMain_SmsCommands" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_Sms != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_CellMain_SmsNotifications" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_Sms != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_CellMain_RmtAccEn" {
                    when "not (/config_data/main/UserAccess/RR_UsAcc_RmtAccess_Enable != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_CellMain_CtrlMsgLogEn" {
                    type "lbox_off_on";
                }
            }
            container "CellularMainLinkTester" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On') or (/config_data/main/Cellular/RR_CellMain_Enable != 'On') or (/config_data/main/CellularMain/RR_CellMain_LinkTesting != 'On'))";
                leaf "RR_CellMainLT_TestPeriod" {
                    type "uint16" {
                        range "3..3600";
                    }
                }
                leaf "RR_CellMainLT_RepeatPeriod" {
                    type "uint16" {
                        range "3..3600";
                    }
                }
                leaf "RR_CellMainLT_WaitTime" {
                    type "uint8" {
                        range "1..60";
                    }
                }
                leaf "RR_CellMainLT_FailCnt" {
                    type "uint8" {
                        range "1..20";
                    }
                }
                leaf "RR_CellMainLT_UseBackupAddr" {
                    type "lbox_off_on";
                }
                leaf "RR_CellMainLT_EvaluationType" {
                    when "not (/config_data/main/CellularMainLinkTester/RR_CellMainLT_UseBackupAddr != 'On')";
                    type "enumeration" {
                        enum "LB_CellLT_ProfileSwitch_One_succeeds" {
                            value "0";
                        }
                        enum "LB_CellLT_ProfileSwitch_Both_succeed" {
                            value "1";
                        }
                    }
                }
                leaf "RR_CellMainLT_TestAddr" {
                    type "string" {
                        pattern "[a-zA-Z0-9.-]{1,128}";
                    }
                }
                leaf "RR_CellMainLT_BackupTestAddr" {
                    when "not (/config_data/main/CellularMainLinkTester/RR_CellMainLT_UseBackupAddr != 'On')";
                    type "string" {
                        pattern "[a-zA-Z0-9.-]{1,128}";
                    }
                }
            }
            container "CellularMainProfileSwitch" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On') or (/config_data/main/Cellular/RR_CellMain_Enable != 'On') or (/config_data/main/CellularMain/RR_CellMain_ProfileSwitching != 'On'))";
                leaf "RR_CellMainPS_SwitchingMethod" {
                    type "enumeration" {
                        enum "LB_CellPS_SwitchingMethod_First_fail" {
                            value "0";
                        }
                        enum "LB_CellPS_SwitchingMethod_Retry_running" {
                            value "1";
                        }
                        enum "LB_CellPS_SwitchingMethod_Timeout" {
                            value "2";
                        }
                    }
                }
                leaf "RR_CellMainPS_ConnectionTimeout" {
                    type "uint8" {
                        range "3..60";
                    }
                }
                leaf "RR_CellMainPS_RetryFirstProfile" {
                    type "lbox_off_on";
                }
                leaf "RR_CellMainPS_RetryTimeout" {
                    when "not (/config_data/main/CellularMainProfileSwitch/RR_CellMainPS_RetryFirstProfile != 'On')";
                    type "uint16" {
                        range "5..10080";
                    }
                }
            }
            container "CellularAux" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') or (/config_data/main/Cellular/RR_CellAux_Enable != 'On'))";
                leaf "RR_CellAux_Masquerade" {
                    type "lbox_off_on";
                }
                leaf "RR_CellAux_MngEn" {
                    type "lbox_off_on";
                }
                leaf "RR_CellAux_LinkTesting" {
                    type "lbox_off_on";
                }
                leaf "RR_CellAux_ProfileSwitching" {
                    type "lbox_off_on";
                }
                leaf "RR_CellAux_SmsCommands" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_Sms != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_CellAux_SmsNotifications" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_Sms != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_CellAux_RmtAccEn" {
                    when "not (/config_data/main/UserAccess/RR_UsAcc_RmtAccess_Enable != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_CellAux_CtrlMsgLogEn" {
                    type "lbox_off_on";
                }
            }
            container "CellularAuxLinkTester" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') or (/config_data/main/Cellular/RR_CellAux_Enable != 'On') or (/config_data/main/CellularAux/RR_CellAux_LinkTesting != 'On'))";
                leaf "RR_CellAuxLT_TestPeriod" {
                    type "uint16" {
                        range "3..3600";
                    }
                }
                leaf "RR_CellAuxLT_RepeatPeriod" {
                    type "uint16" {
                        range "3..3600";
                    }
                }
                leaf "RR_CellAuxLT_WaitTime" {
                    type "uint8" {
                        range "1..60";
                    }
                }
                leaf "RR_CellAuxLT_FailCnt" {
                    type "uint8" {
                        range "1..20";
                    }
                }
                leaf "RR_CellAuxLT_UseBackupAddr" {
                    type "lbox_off_on";
                }
                leaf "RR_CellAuxLT_EvaluationType" {
                    when "not (/config_data/main/CellularAuxLinkTester/RR_CellAuxLT_UseBackupAddr != 'On')";
                    type "enumeration" {
                        enum "LB_CellLT_ProfileSwitch_One_succeeds" {
                            value "0";
                        }
                        enum "LB_CellLT_ProfileSwitch_Both_succeed" {
                            value "1";
                        }
                    }
                }
                leaf "RR_CellAuxLT_TestAddr" {
                    type "string" {
                        pattern "[a-zA-Z0-9.-]{1,128}";
                    }
                }
                leaf "RR_CellAuxLT_BackupTestAddr" {
                    when "not (/config_data/main/CellularAuxLinkTester/RR_CellAuxLT_UseBackupAddr != 'On')";
                    type "string" {
                        pattern "[a-zA-Z0-9.-]{1,128}";
                    }
                }
            }
            container "CellularAuxProfileSwitch" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') or (/config_data/main/Cellular/RR_CellAux_Enable != 'On') or (/config_data/main/CellularAux/RR_CellAux_ProfileSwitching != 'On'))";
                leaf "RR_CellAuxPS_SwitchingMethod" {
                    type "enumeration" {
                        enum "LB_CellPS_SwitchingMethod_First_fail" {
                            value "0";
                        }
                        enum "LB_CellPS_SwitchingMethod_Retry_running" {
                            value "1";
                        }
                        enum "LB_CellPS_SwitchingMethod_Timeout" {
                            value "2";
                        }
                    }
