                leaf "RR_KrngGCrt_Organization" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{1,256}";
                    }
                }
                leaf "RR_KrngGCrt_Department" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{1,256}";
                    }
                }
                leaf "RR_KrngGCrt_Location" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{1,256}";
                    }
                }
                leaf "RR_KrngGCrt_State" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{1,256}";
                    }
                }
                leaf "RR_KrngGCrt_CountryCode" {
                    when "not (/config_data/main/KrngGenCert/RR_KrngGCrt_Country != 'LB_KrngGCrt_Country_Other')";
                    type "string" {
                        pattern "[A-Z][A-Z]";
                    }
                }
                leaf "RR_KrngGCrt_CommonName" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{1,256}";
                    }
                }
                leaf "RR_KrngGCrt_Email" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{1,256}";
                    }
                }
                leaf "RR_KrngGCrt_ExpPeriod" {
                    type "uint16" {
                        range "7..36500";
                    }
                }
            }
            container "KrngServices" {
                leaf "RR_KrngSrv_LocalCA" {
                    type "lbox_off_on";
                }
            }
            container "KrngLocalCA" {
                when "not (/config_data/main/KrngServices/RR_KrngSrv_LocalCA != 'On')";
                leaf "RR_KrngLCA_KeyId" {
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
                leaf "RR_KrngLCA_CertId" {
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
            }
            container "CnfSecurity" {
                leaf "RR_CnfSec_Pass_Required" {
                    type "lbox_off_on";
                }
                leaf "RR_CnfSec_Pass_MinLCase" {
                    type "uint8" {
                        range "0..5";
                    }
                }
                leaf "RR_CnfSec_Pass_MinUCase" {
                    type "uint8" {
                        range "0..5";
                    }
                }
                leaf "RR_CnfSec_Pass_MinDigit" {
                    type "uint8" {
                        range "0..5";
                    }
                }
                leaf "RR_CnfSec_Pass_MinSpec" {
                    type "uint8" {
                        range "0..5";
                    }
                }
                leaf "RR_CnfSec_Pass_MinLen" {
                    type "uint8" {
                        range "5..64";
                    }
                }
            }
            container "UsbDisc" {
                leaf "RR_UsbDisc_FwEnable" {
                    type "lbox_off_on";
                }
            }
            container "SDK" {
                leaf "RR_Sdk_Enable" {
                    type "lbox_off_on";
                }
            }
            container "MqttBroker" {
                leaf "RR_MqttBroker_Enable" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (/config_data/device/DeviceSwKey/RR_SwKey_Flag_mqtt != 'On')))";
                }
                leaf "RR_MqttBroker_QueueQoS0Messages" {
                    when "not (/config_data/main/MqttBroker/RR_MqttBroker_Enable != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_MqttBroker_RetainAvailable" {
                    when "not (/config_data/main/MqttBroker/RR_MqttBroker_Enable != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_MqttBroker_UpgradeOutgoingQoS" {
                    when "not (/config_data/main/MqttBroker/RR_MqttBroker_Enable != 'On')";
                    type "lbox_off_on";
                }
                leaf "RR_MqttBroker_BridgeEnable" {
                    when "not (/config_data/main/MqttBroker/RR_MqttBroker_Enable != 'On')";
                    type "lbox_off_on";
                }
            }
            container "MqttListener" {
                when "not (/config_data/main/MqttBroker/RR_MqttBroker_Enable != 'On')";
                leaf "RR_MqttListener_MaxQoS" {
                    type "lbox_mqtt_qos";
                }
                leaf "RR_MqttListener_EnableNonSecurePort" {
                    type "lbox_off_on";
                }
                leaf "RR_MqttListener_ServerCertificateSource" {
                    type "lbox_default_user";
                }
                leaf "RR_MqttListener_Port" {
                    when "not (/config_data/main/MqttListener/RR_MqttListener_EnableNonSecurePort != 'On')";
                    type "lim_udp_port";
                }
                leaf "RR_MqttListener_SecurePort" {
                    type "lim_udp_port";
                }
                leaf "RR_MqttListener_ServerKeyId" {
                    when "not (/config_data/main/MqttListener/RR_MqttListener_ServerCertificateSource != 'LB_default_user_User')";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
                leaf "RR_MqttListener_ServerCertId" {
                    when "not (/config_data/main/MqttListener/RR_MqttListener_ServerCertificateSource != 'LB_default_user_User')";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
                leaf "RR_MqttListener_CACertId" {
                    when "not (/config_data/main/MqttListener/RR_MqttListener_ServerCertificateSource != 'LB_default_user_User')";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
            }
            container "MqttBridge" {
                when "not ((/config_data/main/MqttBroker/RR_MqttBroker_Enable != 'On') or (/config_data/main/MqttBroker/RR_MqttBroker_BridgeEnable != 'On'))";
                leaf "RR_MqttBridge_ProtocolVersion" {
                    type "lbox_mqtt_protocol_version";
                }
                leaf "RR_MqttBridge_OutgoingRetain" {
                    type "lbox_off_on";
                }
                leaf "RR_MqttBridge_EnableSecureBridge" {
                    type "lbox_off_on";
                }
                leaf "RR_MqttBridge_Port" {
                    type "lim_udp_port";
                }
                leaf "RR_MqttBridge_ConnectionAddress" {
                    type "inet:ipv4-address";
                }
                leaf "RR_MqttBridge_ConnectionName" {
                    type "string" {
                        pattern "[a-zA-Z0-9_-]{0,64}";
                    }
                }
                leaf "RR_MqttBridge_RemoteClientID" {
                    type "string" {
                        pattern "[a-zA-Z0-9_-]{0,64}";
                    }
                }
                leaf "RR_MqttBridge_RemotePassword" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,128}";
                    }
                }
                leaf "RR_MqttBridge_RemoteUsername" {
                    type "string" {
                        pattern "[a-zA-Z0-9_-]{0,64}";
                    }
                }
                leaf "RR_MqttBridge_KeyId" {
                    when "not (/config_data/main/MqttBridge/RR_MqttBridge_EnableSecureBridge != 'On')";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
                leaf "RR_MqttBridge_CertId" {
                    when "not (/config_data/main/MqttBridge/RR_MqttBridge_EnableSecureBridge != 'On')";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
                leaf "RR_MqttBridge_CACertId" {
                    when "not (/config_data/main/MqttBridge/RR_MqttBridge_EnableSecureBridge != 'On')";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
            }
            list "RR_S_TABLE_LanInterfaces" {
                key "ID";
                max-elements "16";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "LanIface_Name" {
                    type "string" {
                        pattern "[a-zA-Z0-9_-]{1,12}";
                    }
                    mandatory "true";
                }
                leaf "LanIface_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "LanIface_BridgeWithRadio" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/main/RadioInterface/RR_RadioIfMode != 'Bridge'))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LanIface_MngEn" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "LanIface_StpEn" {
                    when "not (/config_data/main/STP/RR_STP_Ena != 'On')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LanIface_RmtAccEn" {
                    when "not (/config_data/main/UserAccess/RR_UsAcc_RmtAccess_Enable != 'On')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LanIface_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "LanIface_MtuMode" {
                    type "lbox_auto_limited";
                    default "LB_auto_limited_V_Automatic";
                }
                leaf "LanIface_MaxMtu" {
                    when "not (../LanIface_MtuMode != 'LB_auto_limited_V_Limited')";
                    type "uint16" {
                        range "74..1500";
                    }
                    default "1500";
                }
            }
            list "RR_S_TABLE_LanIfacePorts" {
                key "ID";
                max-elements "32";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "ID_Parent" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "LanIfPort_ItActive" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (((../LanIfPort_PortId = 'ETH5') and (/config_data/main/ExtensionPorts/RR_PortSfpEnable != 'On')) or ((../LanIfPort_PortId = 'ETH1') and (/config_data/main/EthPorts/RR_EthPort_1_Enable != 'On')) or ((../LanIfPort_PortId = 'ETH2') and (/config_data/main/EthPorts/RR_EthPort_2_Enable != 'On')) or ((../LanIfPort_PortId = 'ETH3') and (/config_data/main/EthPorts/RR_EthPort_3_Enable != 'On')) or ((../LanIfPort_PortId = 'ETH4') and (/config_data/main/EthPorts/RR_EthPort_4_Enable != 'On')))))";
                    default "On";
                }
                leaf "LanIfPort_PortId" {
                    type "enumeration" {
                        enum "VLAN" {
                            value "0";
                        }
                        enum "ETH1" {
                            value "1";
                        }
                        enum "ETH2" {
                            value "2";
                        }
                        enum "ETH3" {
                            value "3";
                        }
                        enum "ETH4" {
                            value "4";
                        }
                        enum "ETH5" {
                            value "5";
                        }
                    }
                    must "not ((. = 'ETH1' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 0)) or (. = 'ETH2' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 1)) or (. = 'ETH3' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 2)) or (. = 'ETH4' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 3)) or (. = 'ETH5' and (/config_data/device/DeviceHw/RR_DynHw_Port_Sfp != 'On')))";
                    default "ETH1";
                }
                leaf "LanIfPort_VlanRowId" {
                    when "not (../LanIfPort_PortId != 'VLAN')";
                    type "lim_uint_16";
                    default "0";
                }
            }
            list "RR_S_TABLE_LanIfaceLanAddresses" {
                key "ID";
                max-elements "32";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "ID_Parent" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "LanIfAddr_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "LanIfAddr_IsVirtual" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_HotStandby != 'On') or (/config_data/main/HotStdby/RR_HotStdby_Enable != 'On'))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LanIfAddr_IpMask" {
                    type "lim_ipv4_mask";
                    default "24";
                }
                leaf "LanIfAddr_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "LanIfAddr_IpAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_LanIfaceVlans" {
                key "ID";
                max-elements "32";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "ID_Parent" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "LanVlan_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "LanVlan_MngEn" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "LanVlan_VlanPrioMapping" {
                    when "not (/config_data/main/Networking/RR_QoSMode != 'On')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LanVlan_RmtAccEn" {
                    when "not (/config_data/main/UserAccess/RR_UsAcc_RmtAccess_Enable != 'On')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LanVlan_VlanId" {
                    type "lim_vlan_id";
                    default "1";
                }
                leaf "LanVlan_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "LanVlan_MtuMode" {
                    type "lbox_auto_limited";
                    default "LB_auto_limited_V_Automatic";
                }
                leaf "LanVlan_MaxMtu" {
                    when "not (../LanVlan_MtuMode != 'LB_auto_limited_V_Limited')";
                    type "uint16" {
                        range "70..1496";
                    }
                    default "1496";
                }
            }
            list "RR_S_TABLE_LanIfaceVlanAddresses" {
                key "ID";
                max-elements "32";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "ID_Parent" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "LanIfAddr_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "LanIfAddr_IsVirtual" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_HotStandby != 'On') or (/config_data/main/HotStdby/RR_HotStdby_Enable != 'On'))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LanIfAddr_IpMask" {
                    type "lim_ipv4_mask";
                    default "24";
                }
                leaf "LanIfAddr_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "LanIfAddr_IpAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_RadioBabelFltRules" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/main/RadioInterface/RR_RadioIfMode != 'Router') or (/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_BabelEn != 'On') or (/config_data/main/RadioInterface/RR_RadioBabelFilterEn != 'On'))";
                key "ID";
                max-elements "512";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "RadioBblFltR_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "RadioBblFltR_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "RadioBblFltR_RadioSrcAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "RadioBblFltR_RssThr_Soft" {
                    type "lim_babelflt_rss";
                    must ". <= ../RadioBblFltR_RssThr_Hard" {
                        error-message "valmsg_it_RadioBblFltR_RssThr_Soft";
                    }
                    default "110";
                }
                leaf "RadioBblFltR_RssThr_Hard" {
                    type "lim_babelflt_rss";
                    must ". >= ../RadioBblFltR_RssThr_Soft" {
                        error-message "valmsg_it_RadioBblFltR_RssThr_Hard";
                    }
                    default "130";
                }
                leaf "RadioBblFltR_MseThr_Soft" {
                    type "lim_babelflt_mse";
                    must ". >= ../RadioBblFltR_MseThr_Hard" {
                        error-message "valmsg_it_RadioBblFltR_MseThr_Soft";
                    }
                    default "10";
                }
                leaf "RadioBblFltR_MseThr_Hard" {
                    type "lim_babelflt_mse";
                    must ". <= ../RadioBblFltR_MseThr_Soft" {
                        error-message "valmsg_it_RadioBblFltR_MseThr_Hard";
                    }
                    default "5";
                }
            }
            list "RR_S_TABLE_RadioBDPRemotes" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/main/RadioProtocol/RR_RadioAccessProtocol != 'Base driven') or (/config_data/main/RadioProtocolBaseDr/RR_RadioBDP_StationType != 'Base'))";
                key "ID";
                max-elements "512";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "BDPRemotes_Address1" {
                    type "lim_uint_8";
                    must ". <= ../BDPRemotes_Address2" {
                        error-message "valmsg_it_BDPRemotes_Address1";
                    }
                    default "1";
                }
                leaf "BDPRemotes_Address2" {
                    type "lim_uint_8";
                    must ". >= ../BDPRemotes_Address1" {
                        error-message "valmsg_it_BDPRemotes_Address2";
                    }
                    default "1";
                }
                leaf "BDPRemotes_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "BDPRemotes_Type" {
                    type "enumeration" {
                        enum "Direct" {
                            value "0";
                        }
                        enum "Direct & Repeater" {
                            value "1";
                        }
                        enum "Behind Repeater" {
                            value "2";
                        }
                    }
                    default "Direct";
                }
                leaf "BDPRemotes_Ack" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "BDPRemotes_Retries" {
                    when "not (../BDPRemotes_Ack != 'On')";
                    type "lim_radio_retries";
                    default "3";
                }
                leaf "BDPRemotes_CtsRetries" {
                    when "not (../BDPRemotes_Type = 'Behind Repeater')";
                    type "lim_radio_retries";
                    default "3";
                }
                leaf "BDPRemotes_Modulation" {
                    when "not ((/config_data/main/RadioChannel/RR_RadioACMEn = 'On') and (/config_data/device/DeviceHw/RR_DynHw_Radio_Acm = 'On'))";
                    type "lbox_radio_modulation_M7";
                    must "not ((. = '2CPFSK' and (/config_data/main/RadioChannel/RR_RadioModType != 'FSK')) or (. = '4CPFSK' and (/config_data/main/RadioChannel/RR_RadioModType != 'FSK')) or (. = 'DPSK' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'pi/4DQPSK' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'D8PSK' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = '16DEQAM' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = '64QAM' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = '256QAM' and ((/config_data/main/RadioChannel/RR_RadioModType != 'QAM') or (/config_data/device/DeviceSwKey/RR_SwKey_Flag_radio_modulation_over_64QAM != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Radio_Modulation_Over_64QAM != 'On'))))";
                    default "2CPFSK";
                }
                leaf "BDPRemotes_FEC" {
                    when "not ((/config_data/main/RadioChannel/RR_RadioACMEn = 'On') and (/config_data/device/DeviceHw/RR_DynHw_Radio_Acm = 'On'))";
                    type "lbox_radio_fec_bdp_M9";
                    must "not ((. = '1/1' and ((../BDPRemotes_Modulation = '256QAM') and ((/config_data/main/RadioChannel/RR_RadioChSpacing = '250' and /config_data/main/RadioChannel/RR_RadioChSpacing = '300') or ((/config_data/main/RadioChannel/RR_RadioChSpacing = '200') and (/config_data/main/RadioChannel/RR_RadioChOccupied = '200'))))) or (. = '5/6' and (../BDPRemotes_Modulation != '64QAM' and ../BDPRemotes_Modulation != '256QAM')) or (. = '2/3' and (../BDPRemotes_Modulation != '64QAM' and ../BDPRemotes_Modulation != '256QAM')))";
                    default "1/1";
                }
                leaf "BDPRemotes_RelayAddr" {
                    when "not (../BDPRemotes_Type != 'Behind Repeater')";
                    type "lim_uint_8";
                    default "1";
                }
                leaf "BDPRemotes_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
            }
            list "RR_S_TABLE_RadioFlexLinkOpts" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/main/RadioProtocol/RR_RadioAccessProtocol != 'Flexible'))";
                key "ID";
                max-elements "512";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "FlexLinkOpt_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "FlexLinkOpt_Ack" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "FlexLinkOpt_Retries" {
                    when "not (../FlexLinkOpt_Ack != 'On')";
                    type "lim_radio_retries";
                    default "3";
                }
                leaf "FlexLinkOpt_Modulation" {
                    when "not ((/config_data/main/RadioChannel/RR_RadioACMEn = 'On') and (/config_data/device/DeviceHw/RR_DynHw_Radio_Acm = 'On'))";
                    type "lbox_radio_modulation_M7";
                    must "not ((. = '2CPFSK' and (/config_data/main/RadioChannel/RR_RadioModType != 'FSK')) or (. = '4CPFSK' and (/config_data/main/RadioChannel/RR_RadioModType != 'FSK')) or (. = 'DPSK' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'pi/4DQPSK' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = 'D8PSK' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = '16DEQAM' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = '64QAM' and (/config_data/main/RadioChannel/RR_RadioModType != 'QAM')) or (. = '256QAM' and ((/config_data/main/RadioChannel/RR_RadioModType != 'QAM') or (/config_data/device/DeviceSwKey/RR_SwKey_Flag_radio_modulation_over_64QAM != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Radio_Modulation_Over_64QAM != 'On'))))";
                    default "2CPFSK";
                }
                leaf "FlexLinkOpt_FEC" {
                    when "not ((/config_data/main/RadioChannel/RR_RadioACMEn = 'On') and (/config_data/device/DeviceHw/RR_DynHw_Radio_Acm = 'On'))";
                    type "lbox_radio_fec_flex_M9";
                    must "not ((. = '1/1' and ((../FlexLinkOpt_Modulation = '256QAM') and ((/config_data/main/RadioChannel/RR_RadioChSpacing = '250' and /config_data/main/RadioChannel/RR_RadioChSpacing = '300') or ((/config_data/main/RadioChannel/RR_RadioChSpacing = '200') and (/config_data/main/RadioChannel/RR_RadioChOccupied = '200'))))) or (. = '5/6' and (../FlexLinkOpt_Modulation != '64QAM' and ../FlexLinkOpt_Modulation != '256QAM')) or (. = '2/3' and (../FlexLinkOpt_Modulation != '64QAM' and ../FlexLinkOpt_Modulation != '256QAM')))";
                    default "1/1";
                }
                leaf "FlexLinkOpt_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "FlexLinkOpt_RadioDstAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_CellularProfilesMain" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On') or (/config_data/main/Cellular/RR_CellMain_Enable != 'On'))";
                key "ID";
                max-elements "8";
                min-elements "1";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "CellProfMain_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "CellProfMain_Network" {
                    type "lbox_cellular_network";
                    default "Automatic";
                }
                leaf "CellProfMain_PreferredSvc" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_SvcConv != 'On')";
                    type "lbox_cellular_Main_preferred_svc_M2";
                    must "not ((. = 'LB_cell_pref_svc_2g_first' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc2gFirst != 'On')) or (. = 'LB_cell_pref_svc_2g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc2gOnly != 'On') or ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc2gFirst = 'On') and (../CellProfMain_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_3g_first' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3gFirst != 'On')) or (. = 'LB_cell_pref_svc_3g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3g4g5gOnly = 'On')) and (../CellProfMain_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_2g_3g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc2g3gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc2gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3gFirst = 'On')) and (../CellProfMain_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_4g_first' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc4gFirst != 'On')) or (. = 'LB_cell_pref_svc_4g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc4gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc4gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3g4g5gOnly = 'On')) and (../CellProfMain_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_3g_4g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3g4gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc4gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3g4g5gOnly = 'On')) and (../CellProfMain_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_5g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc5gOnly != 'On') or ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3g4g5gOnly = 'On') and (../CellProfMain_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_3g_5g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3g5gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3g4g5gOnly = 'On')) and (../CellProfMain_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_4g_5g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc4g5gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc4gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3g4g5gOnly = 'On')) and (../CellProfMain_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_3g_4g_5g_only' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvc3g4g5gOnly != 'On')))";
                    default "LB_cell_pref_svc_4g_first";
                }
                leaf "CellProfMain_ComprHdr" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "CellProfMain_ComprData" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "CellProfMain_Authentication" {
                    type "lbox_cellular_authentication";
                    default "None";
                }
                leaf "CellProfMain_SimUsed" {
                    type "lbox_cellular_sim_select";
                    default "SIM1";
                }
                leaf "CellProfMain_PreferredSvcLpwan" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_SvcLpwan != 'On')";
                    type "lbox_cellular_Main_preferred_svc_lpwan_M2";
                    must "not ((. = 'LB_cell_pref_svc_lpwan_Lte_cat_m_first' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvcCatMFirst != 'On')) or (. = 'LB_cell_pref_svc_lpwan_Lte_cat_m_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvcCatMOnly != 'On') or ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvcCatMFirst = 'On') and (../CellProfMain_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_lpwan_Lte_cat_nb_first' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvcCatNbFirst != 'On')) or (. = 'LB_cell_pref_svc_lpwan_Lte_cat_nb_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvcCatNbOnly != 'On') or ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_PrefSvcCatNbFirst = 'On') and (../CellProfMain_Network = 'Prefer manual')))))";
                    default "LB_cell_pref_svc_lpwan_Lte_cat_m_only";
                }
                leaf "CellProfMain_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "CellProfMain_ManualPlmn" {
                    when "not (../CellProfMain_Network != 'Prefer manual' and ../CellProfMain_Network != 'Lock to manual')";
                    type "string" {
                        pattern "[0-9]{1,10}";
                    }
                    default "00000";
                }
                leaf "CellProfMain_APN" {
                    type "string" {
                        pattern "(([a-zA-Z0-9]|([a-zA-Z0-9][a-zA-Z0-9-]{0,61}[a-zA-Z0-9]))(\\.([a-zA-Z0-9]|([a-zA-Z0-9][a-zA-Z0-9-]{0,61}[a-zA-Z0-9])))*)?";
                    }
                    must "string-length(.) <= 99" {
                        error-message "valmsg_it_CellProfMain_APN";
                    }
                    default "";
                }
                leaf "CellProfMain_Username" {
                    when "not (../CellProfMain_Authentication = 'None')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,50}";
                    }
                    default "";
                }
                leaf "CellProfMain_Password" {
                    when "not (../CellProfMain_Authentication = 'None')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,50}";
                    }
                    default "";
                }
                leaf "CellProfMain_Mtu" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Cell_Main_SvcLpwan != 'Off') and (../CellProfMain_PreferredSvcLpwan != 'LB_cell_pref_svc_lpwan_Lte_cat_m_only'))";
                    type "uint16" {
                        range "70..1500";
                    }
                    must ". >= /config_data/device/DeviceHw/RR_DynHw_Cell_Main_MtuMin" {
                        error-message "valmsg_it_CellProfMain_MtuMin";
                    }
                    default "1500";
                }
            }
            list "RR_S_TABLE_CellularProfilesAux" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') or (/config_data/main/Cellular/RR_CellAux_Enable != 'On'))";
