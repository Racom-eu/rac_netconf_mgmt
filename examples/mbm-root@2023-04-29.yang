                leaf "BgpImIgpFRule_Action" {
                    type "lbox_adr_filter_action";
                    default "Accept";
                }
                leaf "BgpImIgpFRule_SetPreference" {
                    when "not (../BgpImIgpFRule_Action = 'Reject')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "BgpImIgpFRule_FPathAS" {
                    when "not (../BgpImIgpFRule_FilterBgpPath != 'Contain' and ../BgpImIgpFRule_FilterBgpPath != 'Not contain')";
                    type "lim_uint_32";
                    default "65000";
                }
                leaf "BgpImIgpFRule_Preference" {
                    when "not ((../BgpImIgpFRule_Action = 'Reject') or (../BgpImIgpFRule_SetPreference != 'On'))";
                    type "lim_adr_preference";
                    default "100";
