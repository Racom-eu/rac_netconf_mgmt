            list "RR_S_TABLE_QoSInterfaces" {
                when "not (/config_data/main/Networking/RR_QoSMode != 'On')";
                key "ID";
                max-elements "16";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "QoSIface_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "QoSIface_Egr_Type" {
                    type "enumeration" {
                        enum "Strict_priority" {
                            value "0";
                        }
                        enum "Rate_limiting" {
                            value "1";
                        }
                    }
                    default "Strict_priority";
                }
                leaf "QoSIface_Egr_PrioFallback" {
                    when "not (../QoSIface_Egr_Type != 'Strict_priority')";
                    type "lbox_qos_priority";
                    default "8 (Lowest)";
                }
                leaf "QoSIface_Egr_HtbFallback" {
                    when "not (../QoSIface_Egr_Type != 'Rate_limiting')";
                    type "lbox_qos_flow_label";
                    default "Flow_H";
                }
                leaf "QoSIface_Egr_MaxRate_Unit" {
                    type "lbox_qos_rate_unit";
                    default "Mibps";
                }
                leaf "QoSIface_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "QoSIface_IfName" {
                    type "string" {
                        pattern "[a-zA-Z0-9_.-]{0,16}";
                    }
                    default "";
                }
                leaf "QoSIface_Egr_MaxRate_Val" {
                    type "lim_qos_rate_limit";
                    default "1";
                }
                leaf "QoSIface_TargetDelay" {
                    type "uint16" {
                        range "5..10000";
                    }
                    default "5";
                }
            }
            list "RR_S_TABLE_QoSEgrHtbFlows" {
                when "not (/config_data/main/Networking/RR_QoSMode != 'On')";
                key "ID";
                max-elements "128";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "ID_Parent" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "QoSEHFlow_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "QoSEHFlow_Label" {
                    type "lbox_qos_flow_label";
                    default "Flow_A";
                }
                leaf "QoSEHFlow_Prio" {
                    type "enumeration" {
                        enum "1_Highest" {
                            value "0";
                        }
                        enum "2" {
                            value "1";
                        }
                        enum "3" {
                            value "2";
                        }
                        enum "4" {
                            value "3";
                        }
                        enum "5" {
                            value "4";
                        }
                        enum "6" {
                            value "5";
                        }
                        enum "7_Lowest" {
                            value "6";
                        }
                    }
                    default "1_Highest";
                }
                leaf "QoSEHFlow_MaxRate_Unit" {
                    type "lbox_qos_rate_unit";
                    default "kibps";
                }
                leaf "QoSEHFlow_GrntRate_Ena" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "QoSEHFlow_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "QoSEHFlow_MaxRate_Val" {
                    type "lim_qos_rate_limit";
                    default "1";
                }
                leaf "QoSEHFlow_GrntRate_Val" {
                    when "not (../QoSEHFlow_GrntRate_Ena != 'On')";
                    type "lim_qos_rate_limit";
                    default "1";
                }
            }
            list "RR_S_TABLE_QoSEgrFilterRules" {
                when "not (/config_data/main/Networking/RR_QoSMode != 'On')";
                key "ID";
                max-elements "256";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "ID_Parent" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "QoSERule_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "QoSERule_Protocol" {
                    type "lbox_l3_protocol";
                    default "All";
                }
                leaf "QoSERule_DS_Type" {
                    type "lbox_qos_ds_type";
                    default "Off";
                }
                leaf "QoSERule_VlanPrioSet" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "QoSERule_SrcIpMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "QoSERule_SrcRUdpPort" {
                    when "not (../QoSERule_Protocol != 'UDP')";
                    type "lbox_udp_reserved_ports";
                    default "MANUAL";
                }
                leaf "QoSERule_DstIpMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "QoSERule_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "QoSERule_ProtocolNum" {
                    when "not (../QoSERule_Protocol != 'Other')";
                    type "lim_uint_8_1toFF";
                    default "1";
                }
                leaf "QoSERule_SrcIp" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "QoSERule_SrcPort" {
                    when "not ((../QoSERule_Protocol != 'UDP' and ../QoSERule_Protocol != 'TCP') or ((../QoSERule_Protocol = 'UDP') and (../QoSERule_SrcRUdpPort != 'MANUAL')))";
                    type "lim_udp_port0";
                    default "0";
                }
                leaf "QoSERule_DstIp" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "QoSERule_DstRUdpPort" {
                    when "not (../QoSERule_Protocol != 'UDP')";
                    type "lbox_udp_reserved_ports";
                    default "MANUAL";
                }
                leaf "QoSERule_DS_DSCP" {
                    when "not (../QoSERule_DS_Type != 'DSCP')";
                    type "lim_qos_dscp";
                    default "0";
                }
                leaf "QoSERule_DS_Precedence" {
                    when "not (../QoSERule_DS_Type != 'TOS_Precedence')";
                    type "lim_qos_tos_precedence";
                    default "0";
                }
                leaf "QoSERule_Target" {
                    type "lbox_qos_target";
                    default "Flow_A_Prio_1_Highest";
                }
                leaf "QoSERule_DstPort" {
                    when "not ((../QoSERule_Protocol != 'UDP' and ../QoSERule_Protocol != 'TCP') or ((../QoSERule_Protocol = 'UDP') and (../QoSERule_DstRUdpPort != 'MANUAL')))";
                    type "lim_udp_port0";
                    default "0";
                }
                leaf "QoSERule_VlanPrioVal" {
                    when "not (../QoSERule_VlanPrioSet != 'On')";
                    type "lim_qos_vlan_priority";
                    default "0";
                }
                leaf "QoSERule_SrcPortUseMask" {
                    when "not ((../QoSERule_Protocol != 'UDP' and ../QoSERule_Protocol != 'TCP') or ((../QoSERule_Protocol = 'UDP') and (../QoSERule_SrcRUdpPort != 'MANUAL')))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "QoSERule_SrcPortMask" {
                    when "not ((../QoSERule_Protocol != 'UDP' and ../QoSERule_Protocol != 'TCP') or ((../QoSERule_Protocol = 'UDP') and (../QoSERule_SrcRUdpPort != 'MANUAL')) or (../QoSERule_SrcPortUseMask != 'On'))";
                    type "lim_l4_port_mask";
                    default "16";
                }
                leaf "QoSERule_DstPortUseMask" {
                    when "not ((../QoSERule_Protocol != 'UDP' and ../QoSERule_Protocol != 'TCP') or ((../QoSERule_Protocol = 'UDP') and (../QoSERule_DstRUdpPort != 'MANUAL')))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "QoSERule_DstPortMask" {
                    when "not ((../QoSERule_Protocol != 'UDP' and ../QoSERule_Protocol != 'TCP') or ((../QoSERule_Protocol = 'UDP') and (../QoSERule_DstRUdpPort != 'MANUAL')) or (../QoSERule_DstPortUseMask != 'On'))";
                    type "lim_l4_port_mask";
                    default "16";
                }
            }
            list "RR_S_TABLE_DhcpServers" {
                when "not (/config_data/main/Networking/RR_DhcpServerEn != 'On')";
                key "ID";
                max-elements "16";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "DhcpSrv_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "DhcpSrv_LeaseTime" {
                    type "uint16" {
                        range "2..10080";
                    }
                    default "60";
                }
                leaf "DhcpSrv_StaticOnly" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "DhcpSrv_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "DhcpSrv_IpStart" {
                    type "inet:ipv4-address";
                    must "(round(16777216 * number(substring-before(., \".\")) + 65536 * number(substring-before(substring-after(., \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(., \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(., \".\"), \".\"), \".\")))) <= (round(16777216 * number(substring-before(../DhcpSrv_IpEnd, \".\")) + 65536 * number(substring-before(substring-after(../DhcpSrv_IpEnd, \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(../DhcpSrv_IpEnd, \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(../DhcpSrv_IpEnd, \".\"), \".\"), \".\"))))" {
                        error-message "valmsg_it_DhcpSrv_IpStart";
                    }
                    default "0.0.0.0";
                }
                leaf "DhcpSrv_IpEnd" {
                    type "inet:ipv4-address";
                    must "(round(16777216 * number(substring-before(., \".\")) + 65536 * number(substring-before(substring-after(., \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(., \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(., \".\"), \".\"), \".\")))) >= (round(16777216 * number(substring-before(../DhcpSrv_IpStart, \".\")) + 65536 * number(substring-before(substring-after(../DhcpSrv_IpStart, \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(../DhcpSrv_IpStart, \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(../DhcpSrv_IpStart, \".\"), \".\"), \".\"))))" {
                        error-message "valmsg_it_DhcpSrv_IpEnd";
                    }
                    default "0.0.0.0";
                }
                leaf "DhcpSrv_Gateway" {
                    type "lbox_dhcp_srv_announce";
                    default "LB_dhcp_srv_announce_V_Local";
                }
                leaf "DhcpSrv_Dns" {
                    type "enumeration" {
                        enum "LB_dhcp_srv_announce_V_Off" {
                            value "0";
                        }
                        enum "LB_dhcp_srv_announce_V_Local" {
                            value "1";
                        }
                        enum "LB_dhcp_srv_announce_V_Manual" {
                            value "2";
                        }
                    }
                    must "not ((. = 'LB_dhcp_srv_announce_V_Local' and (/config_data/main/Networking/RR_DnsForwardingEn != 'On')))";
                    default "LB_dhcp_srv_announce_V_Off";
                }
                leaf "DhcpSrv_Dns_UseSecondary" {
                    when "not (../DhcpSrv_Dns != 'LB_dhcp_srv_announce_V_Manual')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "DhcpSrv_Ntp" {
                    type "lbox_dhcp_srv_announce";
                    default "LB_dhcp_srv_announce_V_Off";
                }
                leaf "DhcpSrv_Gateway_Addr" {
                    when "not (../DhcpSrv_Gateway != 'LB_dhcp_srv_announce_V_Manual')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "DhcpSrv_Dns_PrimaryAddr" {
                    when "not (../DhcpSrv_Dns != 'LB_dhcp_srv_announce_V_Manual')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "DhcpSrv_Dns_SecondaryAddr" {
                    when "not ((../DhcpSrv_Dns != 'LB_dhcp_srv_announce_V_Manual') or (../DhcpSrv_Dns_UseSecondary != 'On'))";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "DhcpSrv_Ntp_Addr" {
                    when "not (../DhcpSrv_Ntp != 'LB_dhcp_srv_announce_V_Manual')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_DhcpStaticLeases" {
                when "not (/config_data/main/Networking/RR_DhcpServerEn != 'On')";
                key "ID";
                max-elements "1024";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "ID_Parent" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "DhcpStLease_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "DhcpStLease_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "DhcpStLease_MacAddr" {
                    type "yang:mac-address";
                    default "00:00:00:00:00:00";
                }
                leaf "DhcpStLease_IpAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_DnsServers" {
                when "not ((/config_data/main/Networking/RR_DnsForwardingEn != 'On') or (/config_data/main/DnsForwarding/RR_DnsFwd_ServerList != 'LB_DnsFwd_ServerList_V_Static'))";
                key "ID";
                max-elements "32";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "DnsSrv_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "DnsSrv_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "DnsSrv_IpAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "DnsSrv_Port" {
                    type "lim_udp_port";
                    default "53";
                }
                leaf "DnsSrv_Domain" {
                    type "string" {
                        pattern "[a-zA-Z0-9.*-]{0,128}";
                    }
                    default "";
                }
            }
            list "RR_S_TABLE_DnsBlockNames" {
                when "not (/config_data/main/Networking/RR_DnsForwardingEn != 'On')";
                key "ID";
                max-elements "128";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "DnsBlock_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "DnsBlock_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "DnsBlock_Domain" {
                    type "string" {
                        pattern "[a-zA-Z0-9.*-]{1,128}";
                    }
                    default "example.com";
                }
            }
            list "RR_S_TABLE_DnsSecTrustAnchors" {
                when "not ((/config_data/main/Networking/RR_DnsForwardingEn != 'On') or (/config_data/main/DnsForwarding/RR_DnsFwd_Cache != 'On') or (/config_data/main/DnsForwarding/RR_DnsFwd_DnsSec != 'On'))";
                key "ID";
                max-elements "8";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "DnsSecTA_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "DnsSecTA_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "DnsSecTA_KeyTag" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "DnsSecTA_Algorithm" {
                    type "lim_uint_8";
                    default "0";
                }
                leaf "DnsSecTA_DigestType" {
                    type "lim_uint_8";
                    default "0";
                }
                leaf "DnsSecTA_Digest" {
                    type "string" {
                        pattern "[0-9a-fA-F]{0,256}";
                    }
                    default "";
                }
            }
            list "RR_S_TABLE_RoutingRules" {
                key "ID";
                max-elements "512";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "Routing_DstAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "Routing_ItActive" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (((../Routing_Mode = 'WWAN (MAIN)') and (/config_data/main/Cellular/RR_CellMain_Enable != 'On')) or ((../Routing_Mode = 'WWAN (EXT)') and (/config_data/main/Cellular/RR_CellAux_Enable != 'On') and ((/config_data/main/Wifi/RR_WifiExt_Enable != 'On') or (/config_data/main/WifiExt/RR_WifiExt_OperationType != 'LB_wifi_operation_type_Client'))) or ((../Routing_Mode = 'PPP 1') and ((/config_data/main/ComPort_1/RR_ComPort_1_ENA != 'On') or (/config_data/main/ComPort_1/RR_ComPort_1_Protocol != 'PPP'))) or ((../Routing_Mode = 'PPP 2') and ((/config_data/main/ComPort_2/RR_ComPort_2_ENA != 'On') or (/config_data/main/ComPort_2/RR_ComPort_2_Protocol != 'PPP'))) or ((../Routing_Mode = 'PPP 3') and ((/config_data/main/ComPort_3/RR_ComPort_3_ENA != 'On') or (/config_data/main/ComPort_3/RR_ComPort_3_Protocol != 'PPP'))) or ((../Routing_Mode = 'LB_Routing_Mode_Link_manager') and (/config_data/main/Networking/RR_LinkManagerEn != 'On')) or ((../Routing_Mode = 'LB_Routing_Mode_Pppoe_client') and (/config_data/main/Networking/RR_PppoeClient_Enable != 'On')))))";
                    default "On";
                }
                leaf "Routing_DstMask" {
                    type "lim_ipv4_mask0";
                    default "32";
                }
                leaf "Routing_Mode" {
                    type "enumeration" {
                        enum "Static" {
                            value "0";
                        }
                        enum "WWAN (MAIN)" {
                            value "2";
                        }
                        enum "WWAN (EXT)" {
                            value "1";
                        }
                        enum "PPP 1" {
                            value "3";
                        }
                        enum "PPP 2" {
                            value "4";
                        }
                        enum "PPP 3" {
                            value "5";
                        }
                        enum "LB_Routing_Mode_Link_manager" {
                            value "6";
                        }
                        enum "LB_Routing_Mode_Pppoe_client" {
                            value "7";
                        }
                    }
                    must "not ((. = 'WWAN (MAIN)' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On')) or (. = 'WWAN (EXT)' and ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') and (/config_data/device/DeviceHw/RR_DynHw_Module_Wifi != 'On'))) or (. = 'PPP 1' and (/config_data/device/DeviceHw/RR_DynHw_Port_Com1 != 'On')) or (. = 'PPP 2' and (/config_data/device/DeviceHw/RR_DynHw_Port_Com2 != 'On')) or (. = 'PPP 3' and (/config_data/device/DeviceHw/RR_DynHw_Port_Com3 != 'On')))";
                    default "Static";
                }
                leaf "Routing_Persistent" {
                    when "not (../Routing_Mode = 'Static')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "Routing_NHopAddr" {
                    when "not (../Routing_Mode != 'Static')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "Routing_LocalUseSrcAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "Routing_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "Routing_Metric" {
                    type "lim_routing_metric";
                    default "0";
                }
            }
            list "RR_S_TABLE_OspfAreas" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On'))";
                key "ID";
                max-elements "32";
                description "Cnf. group for OSPF: row of table OspfAreas";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "OspfArea_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OspfArea_StubArea" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (../OspfArea_Id = '0.0.0.0')))";
                    default "Off";
                }
                leaf "OspfArea_StubDefaultGw" {
                    when "not (../OspfArea_StubArea != 'On')";
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OspfArea_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "OspfArea_Id" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_OspfInterfaces" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On'))";
                key "ID";
                max-elements "128";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "ID_Parent" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "OspfIface_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OspfIface_TtlSecurity" {
                    when "not (../OspfIface_Type = 'Stub')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "OspfIface_UseBroadcast" {
                    when "not (../OspfIface_Type != 'Broadcast' and ../OspfIface_Type != 'Point2Point')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "OspfIface_HelloInterval" {
                    when "not (../OspfIface_Type = 'Stub')";
                    type "uint16" {
                        range "1..3600";
                    }
                    default "10";
                }
                leaf "OspfIface_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "Ospf_IfName" {
                    type "string" {
                        pattern "[a-zA-Z0-9_.-]{0,16}";
                    }
                    default "";
                }
                leaf "OspfIface_NetAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "OspfIface_NetMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "OspfIface_Type" {
                    type "enumeration" {
                        enum "Broadcast" {
                            value "0";
                        }
                        enum "Point2Point" {
                            value "1";
                        }
                        enum "Point2Multipoint" {
                            value "2";
                        }
                        enum "NBMA" {
                            value "3";
                        }
                        enum "Stub" {
                            value "4";
                        }
                    }
                    default "Broadcast";
                }
                leaf "OspfIface_DeadCount" {
                    when "not (../OspfIface_Type = 'Stub')";
                    type "uint8" {
                        range "2..64";
                    }
                    default "4";
                }
                leaf "OspfIface_Cost" {
                    type "lim_adr_metric";
                    default "10";
                }
                leaf "OspfIface_Authentication" {
                    when "not (../OspfIface_Type = 'Stub')";
                    type "enumeration" {
                        enum "None" {
                            value "0";
                        }
                        enum "Keyed MD5 (OSPFv2)" {
                            value "1";
                        }
                        enum "HMAC SHA256" {
                            value "2";
                        }
                        enum "HMAC SHA384" {
                            value "3";
                        }
                        enum "HMAC SHA512" {
                            value "4";
                        }
                    }
                    default "None";
                }
                leaf "OspfIface_PollInterval" {
                    when "not (../OspfIface_Type != 'NBMA')";
                    type "uint16" {
                        range "1..3600";
                    }
                    default "20";
                }
                leaf "OspfIface_RetransTime" {
                    when "not (../OspfIface_Type = 'Stub')";
                    type "uint16" {
                        range "1..3600";
                    }
                    default "5";
                }
                leaf "OspfIface_DRPriority" {
                    when "not (../OspfIface_Type != 'Broadcast' and ../OspfIface_Type != 'NBMA')";
                    type "lim_uint_8";
                    default "1";
                }
                leaf "OspfIface_Password" {
                    when "not (../OspfIface_Authentication = 'None')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,128}";
                    }
                    default "";
                }
            }
            list "RR_S_TABLE_OspfIfaceNeighbors" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On'))";
                key "ID";
                max-elements "512";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "ID_Parent" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "OspfIfNeigh_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OspfIfNeigh_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "OspfIfNeigh_IpAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_OspfNetworks" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On'))";
                key "ID";
                max-elements "256";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "ID_Parent" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "OspfNet_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OspfNet_NetMask" {
                    type "lim_ipv4_mask0";
                    default "32";
                }
                leaf "OspfNet_Action" {
                    type "enumeration" {
                        enum "Aggregate" {
                            value "0";
                        }
                        enum "Hide" {
                            value "1";
                        }
                    }
                    default "Aggregate";
                }
                leaf "OspfNet_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "OspfNet_NetAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_OspfStaticRules" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On'))";
                key "ID";
                max-elements "256";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "OspfStRule_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OspfStRule_DstMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "OspfStRule_MetricType" {
                    type "lbox_ospf_metric_type";
                    default "Type 1";
                }
                leaf "OspfStRule_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "OspfStRule_DstAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "OspfStRule_Metric" {
                    type "lim_adr_metric";
                    default "1000";
                }
                leaf "OspfStRule_Tag" {
                    type "lim_uint_32";
                    default "0";
                }
            }
            list "RR_S_TABLE_OspfImFilterRules" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On'))";
                key "ID";
                max-elements "256";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "OspfImFRule_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OspfImFRule_FilterNet" {
                    type "lbox_adr_filter_match";
                    default "Off";
                }
                leaf "OspfImFRule_FNetMask" {
                    when "not (../OspfImFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "OspfImFRule_FNetMaskFrom" {
                    when "not (../OspfImFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    must ". <= ../OspfImFRule_FNetMaskTo" {
                        error-message "valmsg_it_OspfImFRule_FNetMaskFrom";
                    }
                    default "0";
                }
                leaf "OspfImFRule_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "OspfImFRule_FNetAddr" {
                    when "not (../OspfImFRule_FilterNet = 'Off')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "OspfImFRule_FNetMaskTo" {
                    when "not (../OspfImFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    must ". >= ../OspfImFRule_FNetMaskFrom" {
                        error-message "valmsg_it_OspfImFRule_FNetMaskTo";
                    }
                    default "32";
                }
                leaf "OspfImFRule_FilterSource" {
                    type "lbox_adr_filter_match";
                    default "Off";
                }
                leaf "OspfImFRule_FSource" {
                    when "not (../OspfImFRule_FilterSource = 'Off')";
                    type "lbox_ospf_source";
                    default "External type 1";
                }
                leaf "OspfImFRule_FilterTag" {
                    type "lbox_adr_filter_match";
                    default "Off";
                }
                leaf "OspfImFRule_Action" {
                    type "lbox_adr_filter_action";
                    default "Accept";
                }
                leaf "OspfImFRule_SetPreference" {
                    when "not (../OspfImFRule_Action = 'Reject')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "OspfImFRule_FTag" {
                    when "not (../OspfImFRule_FilterTag = 'Off')";
                    type "lim_uint_32";
                    default "0";
                }
                leaf "OspfImFRule_Preference" {
                    when "not ((../OspfImFRule_Action = 'Reject') or (../OspfImFRule_SetPreference != 'On'))";
                    type "lim_adr_preference";
                    default "200";
                }
                leaf "OspfImFRule_LocalUseSrcAddr" {
                    when "not (../OspfImFRule_Action = 'Reject')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_OspfExFilterRules" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On'))";
                key "ID";
                max-elements "256";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "OspfExFRule_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OspfExFRule_FilterNet" {
                    type "lbox_adr_filter_match";
                    default "Off";
                }
                leaf "OspfExFRule_FNetMask" {
                    when "not (../OspfExFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "OspfExFRule_FNetMaskFrom" {
                    when "not (../OspfExFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    must ". <= ../OspfExFRule_FNetMaskTo" {
                        error-message "valmsg_it_OspfExFRule_FNetMaskFrom";
                    }
                    default "0";
                }
                leaf "OspfExFRule_SetMetricType" {
                    when "not (../OspfExFRule_Action = 'Reject')";
                    type "lbox_ospf_metric_type";
                    default "Type 2";
                }
                leaf "OspfExFRule_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "OspfExFRule_FNetAddr" {
                    when "not (../OspfExFRule_FilterNet = 'Off')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "OspfExFRule_FNetMaskTo" {
                    when "not (../OspfExFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    must ". >= ../OspfExFRule_FNetMaskFrom" {
                        error-message "valmsg_it_OspfExFRule_FNetMaskTo";
                    }
                    default "32";
                }
                leaf "OspfExFRule_FilterProtocol" {
                    type "lbox_adr_filter_match";
                    default "Off";
                }
                leaf "OspfExFRule_FProtocol" {
                    when "not (../OspfExFRule_FilterProtocol = 'Off')";
                    type "enumeration" {
                        enum "System" {
                            value "0";
                        }
                        enum "BGP" {
                            value "1";
                        }
                        enum "BGP external" {
                            value "2";
                        }
                        enum "BGP internal" {
                            value "3";
                        }
                        enum "Babel" {
                            value "4";
                        }
                    }
                    must "not ((. = 'BGP' and (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On')) or (. = 'BGP external' and (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On')) or (. = 'BGP internal' and (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On')) or (. = 'Babel' and (/config_data/main/AdvDynamicRouting/RR_ADR_BabelEn != 'On')))";
                    default "System";
                }
                leaf "OspfExFRule_FilterBgpPath" {
                    when "not ((../OspfExFRule_FilterProtocol != 'Match') or (../OspfExFRule_FProtocol != 'BGP' and ../OspfExFRule_FProtocol != 'BGP internal'))";
                    type "lbox_adr_filter_bgppath_simple";
                    default "Off";
                }
                leaf "OspfExFRule_Action" {
                    type "lbox_adr_filter_action";
                    default "Accept";
                }
                leaf "OspfExFRule_SetTag" {
                    when "not (../OspfExFRule_Action = 'Reject')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "OspfExFRule_Metric" {
                    when "not (../OspfExFRule_Action = 'Reject')";
                    type "lim_adr_metric";
                    default "10000";
                }
                leaf "OspfExFRule_Tag" {
                    when "not ((../OspfExFRule_Action = 'Reject') or (../OspfExFRule_SetTag != 'On'))";
                    type "lim_uint_32";
                    default "0";
                }
                leaf "OspfExFRule_SetMetricFromOtherProt" {
                    when "not (../OspfExFRule_Action = 'Reject')";
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "BGP MED" {
                            value "1";
                        }
                        enum "Babel metric" {
                            value "2";
                        }
                    }
                    must "not ((. = 'BGP MED' and (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On')) or (. = 'Babel metric' and (/config_data/main/AdvDynamicRouting/RR_ADR_BabelEn != 'On')))";
                    default "Off";
                }
            }
            list "RR_S_TABLE_BgpNeighbors" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On'))";
                key "ID";
                max-elements "256";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "BgpNeigh_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "BgpNeigh_Type" {
                    type "enumeration" {
                        enum "Internal" {
                            value "0";
                        }
                        enum "External" {
                            value "1";
                        }
                    }
                    default "External";
                }
                leaf "BgpNeigh_HoldInterval" {
                    type "uint16" {
                        range "3..10800";
                    }
                    default "240";
                }
                leaf "BgpNeigh_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "BgpNeigh_NeighborAS" {
                    when "not (../BgpNeigh_Type != 'External')";
                    type "lim_uint_32";
                    default "65000";
                }
                leaf "BgpNeigh_NeighAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "BgpNeigh_LocalAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "BgpNeigh_Connection" {
                    type "enumeration" {
                        enum "Direct" {
                            value "0";
                        }
                        enum "Multihop" {
                            value "1";
                        }
                    }
                    default "Direct";
                }
                leaf "BgpNeigh_Md5Authentication" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "BgpNeigh_Passive" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "BgpNeigh_KeepInterval" {
                    type "uint16" {
                        range "1..3600";
                    }
                    default "80";
                }
                leaf "BgpNeigh_ConnRetryInterval" {
                    type "uint16" {
                        range "1..3600";
                    }
                    default "120";
                }
                leaf "BgpNeigh_TtlSecurity" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "BgpNeigh_RRClient" {
                    when "not ((/config_data/main/Bgp/RR_Bgp_RouteReflector != 'On') or (../BgpNeigh_Type != 'Internal'))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "BgpNeigh_SetCost" {
                    when "not (../BgpNeigh_Connection != 'Direct')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "BgpNeigh_ExpHops" {
                    when "not ((../BgpNeigh_Connection != 'Multihop') or (../BgpNeigh_TtlSecurity != 'On'))";
                    type "uint8" {
                        range "2..32";
                    }
                    default "2";
                }
                leaf "BgpNeigh_SetNHopSelf" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "Always" {
                            value "1";
                        }
                        enum "Internal" {
                            value "2";
                        }
                        enum "External" {
                            value "3";
                        }
                    }
                    default "Off";
                }
                leaf "BgpNeigh_Cost" {
                    when "not ((../BgpNeigh_Connection != 'Direct') or (../BgpNeigh_SetCost != 'On'))";
                    type "uint32" {
                        range "1..4294967295";
                    }
                    default "10";
                }
                leaf "BgpNeigh_Password" {
                    when "not (../BgpNeigh_Md5Authentication != 'On')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,80}";
                    }
                    default "";
                }
            }
            list "RR_S_TABLE_BgpStaticRules" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On'))";
                key "ID";
                max-elements "256";
                leaf "ID" {
