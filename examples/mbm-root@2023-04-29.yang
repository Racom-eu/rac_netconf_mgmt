            list "RR_S_TABLE_LinkMngLinks" {
                when "not (/config_data/main/Networking/RR_LinkManagerEn != 'On')";
                key "ID";
                max-elements "16";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "LinkMngLink_ItActive" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (((/config_data/main/Cellular/RR_CellMain_Enable != 'On') and (../LinkMngLink_Type = 'LB_LinkMngLink_Type_WWAN_MAIN')) or ((/config_data/main/Cellular/RR_CellAux_Enable != 'On') and (/config_data/main/Wifi/RR_WifiExt_Enable != 'On') and (../LinkMngLink_Type = 'LB_LinkMngLink_Type_WWAN_EXT')) or (((/config_data/main/ComPort_1/RR_ComPort_1_ENA != 'On') or (/config_data/main/ComPort_1/RR_ComPort_1_Protocol != 'PPP')) and (../LinkMngLink_Type = 'LB_LinkMngLink_Type_Ppp_1')) or (((/config_data/main/ComPort_2/RR_ComPort_2_ENA != 'On') or (/config_data/main/ComPort_2/RR_ComPort_2_Protocol != 'PPP')) and (../LinkMngLink_Type = 'LB_LinkMngLink_Type_Ppp_2')) or (((/config_data/main/ComPort_3/RR_ComPort_3_ENA != 'On') or (/config_data/main/ComPort_3/RR_ComPort_3_Protocol != 'PPP')) and (../LinkMngLink_Type = 'LB_LinkMngLink_Type_Ppp_3')) or ((/config_data/main/Networking/RR_PppoeClient_Enable != 'On') and (../LinkMngLink_Type = 'LB_LinkMngLink_Type_Pppoe_Client')))))";
                    default "On";
                }
                leaf "LinkMngLink_Type" {
                    type "enumeration" {
                        enum "LB_LinkMngLink_Type_Static" {
                            value "0";
                        }
                        enum "LB_LinkMngLink_Type_WWAN_MAIN" {
                            value "1";
                        }
                        enum "LB_LinkMngLink_Type_WWAN_EXT" {
                            value "2";
                        }
                        enum "LB_LinkMngLink_Type_Ppp_1" {
                            value "3";
                        }
                        enum "LB_LinkMngLink_Type_Ppp_2" {
                            value "4";
                        }
                        enum "LB_LinkMngLink_Type_Ppp_3" {
                            value "5";
                        }
                        enum "LB_LinkMngLink_Type_Pppoe_Client" {
                            value "6";
                        }
                    }
                    must "not ((. = 'LB_LinkMngLink_Type_WWAN_MAIN' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On')) or (. = 'LB_LinkMngLink_Type_WWAN_EXT' and ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') and (/config_data/device/DeviceHw/RR_DynHw_Module_Wifi != 'On'))) or (. = 'LB_LinkMngLink_Type_Ppp_1' and (/config_data/device/DeviceHw/RR_DynHw_Port_Com1 != 'On')) or (. = 'LB_LinkMngLink_Type_Ppp_2' and (/config_data/device/DeviceHw/RR_DynHw_Port_Com2 != 'On')) or (. = 'LB_LinkMngLink_Type_Ppp_3' and (/config_data/device/DeviceHw/RR_DynHw_Port_Com3 != 'On')))";
                    default "LB_LinkMngLink_Type_Static";
                }
                leaf "LinkMngLink_Tst_TestPeriod" {
                    when "not (../LinkMngLink_Testing != 'On')";
                    type "uint16" {
                        range "3..3600";
                    }
                    default "60";
                }
                leaf "LinkMngLink_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "LinkMngLink_Label" {
                    type "string" {
                        pattern "[a-zA-Z0-9@._-]{1,42}";
                    }
                    default "LINK";
                }
                leaf "LinkMngLink_NextHop" {
                    when "not (../LinkMngLink_Type != 'LB_LinkMngLink_Type_Static')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "LinkMngLink_Watch_ETH1" {
                    when "not ((../LinkMngLink_Type != 'LB_LinkMngLink_Type_Static') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 0) or (/config_data/main/EthPorts/RR_EthPort_1_Enable != 'On'))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LinkMngLink_Watch_ETH2" {
                    when "not ((../LinkMngLink_Type != 'LB_LinkMngLink_Type_Static') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 1) or (/config_data/main/EthPorts/RR_EthPort_2_Enable != 'On'))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LinkMngLink_Watch_ETH3" {
                    when "not ((../LinkMngLink_Type != 'LB_LinkMngLink_Type_Static') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 2) or (/config_data/main/EthPorts/RR_EthPort_3_Enable != 'On'))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LinkMngLink_Watch_ETH4" {
                    when "not ((../LinkMngLink_Type != 'LB_LinkMngLink_Type_Static') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 3) or (/config_data/main/EthPorts/RR_EthPort_4_Enable != 'On'))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LinkMngLink_Tst_RepeatPeriod" {
                    when "not (../LinkMngLink_Testing != 'On')";
                    type "uint16" {
                        range "3..3600";
                    }
                    default "10";
                }
                leaf "LinkMngLink_Watch_ETH5" {
                    when "not ((../LinkMngLink_Type != 'LB_LinkMngLink_Type_Static') or (/config_data/device/DeviceHw/RR_DynHw_Port_Sfp != 'On') or (/config_data/main/ExtensionPorts/RR_PortSfpEnable != 'On'))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LinkMngLink_Watch_Radio" {
                    when "not ((../LinkMngLink_Type != 'LB_LinkMngLink_Type_Static') or (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On'))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LinkMngLink_Tst_WaitTime" {
                    when "not (../LinkMngLink_Testing != 'On')";
                    type "uint8" {
                        range "1..60";
                    }
                    default "5";
                }
                leaf "LinkMngLink_IpSecAssociation_ID" {
                    when "not ((/config_data/main/VPN/RR_IpSecEnable != 'On') or (/config_data/main/LinkManager/RR_LinkMng_IpSecControl != 'On'))";
                    type "lim_uint_16";
                    default "0";
                }
                leaf "LinkMngLink_Testing" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LinkMngLink_Tst_PassCnt" {
                    when "not (../LinkMngLink_Testing != 'On')";
                    type "uint8" {
                        range "1..20";
                    }
                    default "1";
                }
                leaf "LinkMngLink_Tst_FailCnt" {
                    when "not (../LinkMngLink_Testing != 'On')";
                    type "uint8" {
                        range "1..20";
                    }
                    default "3";
                }
                leaf "LinkMngLink_Tst_UseBackupAddr" {
                    when "not (../LinkMngLink_Testing != 'On')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "LinkMngLink_Tst_EvaluationType" {
                    when "not ((../LinkMngLink_Testing != 'On') or (../LinkMngLink_Tst_UseBackupAddr != 'On'))";
                    type "lbox_test_2_evaluation";
                    default "LB_CellLT_ProfileSwitch_One_succeeds";
                }
                leaf "LinkMngLink_Tst_TestWhenBackup" {
                    when "not (../LinkMngLink_Testing != 'On')";
                    type "lbox_off_on";
                    default "On";
                }
                leaf "LinkMngLink_Tst_TestAddr" {
                    when "not (../LinkMngLink_Testing != 'On')";
                    type "string" {
                        pattern "[a-zA-Z0-9.-]{1,128}";
                    }
                    default "0.0.0.0";
                }
                leaf "LinkMngLink_Tst_BackupTestAddr" {
                    when "not ((../LinkMngLink_Testing != 'On') or (../LinkMngLink_Tst_UseBackupAddr != 'On'))";
                    type "string" {
                        pattern "[a-zA-Z0-9.-]{1,128}";
                    }
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_IpSecAssociations" {
                when "not (/config_data/main/VPN/RR_IpSecEnable != 'On')";
                key "ID";
                max-elements "24";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "IpSecA_ItActive" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and ((../IpSecA_Management != 'LB_IpSecA_Management_Off') and ((/config_data/main/Networking/RR_LinkManagerEn != 'On') or (/config_data/main/LinkManager/RR_LinkMng_IpSecControl != 'On')))))";
                    default "On";
                }
                leaf "IpSecA_IKEVersion" {
                    type "enumeration" {
                        enum "IKEv1" {
                            value "0";
                        }
                        enum "IKEv2" {
                            value "1";
                        }
                    }
                    default "IKEv2";
                }
                leaf "IpSecA_StartState" {
                    type "enumeration" {
                        enum "Passive" {
                            value "0";
                        }
                        enum "On Demand" {
                            value "1";
                        }
                        enum "Start" {
                            value "2";
                        }
                    }
                    default "Passive";
                }
                leaf "IpSecA_MOBIKE" {
                    when "not (../IpSecA_IKEVersion = 'IKEv1')";
                    type "lbox_off_on";
                    default "On";
                }
                leaf "IpSecA_DPDEnable" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "IpSecA_DPDAction" {
                    when "not (../IpSecA_DPDEnable != 'On')";
                    type "enumeration" {
                        enum "Clear" {
                            value "0";
                        }
                        enum "Hold" {
                            value "1";
                        }
                        enum "Restart" {
                            value "2";
                        }
                    }
                    default "Hold";
                }
                leaf "IpSecA_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "IpSecA_LocalAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "IpSecA_PeerAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "IpSecA_DPDPeriod" {
                    when "not (../IpSecA_DPDEnable != 'On')";
                    type "uint16" {
                        range "5..28800";
                    }
                    default "30";
                }
                leaf "IpSecA_Authentication" {
                    type "enumeration" {
                        enum "PSK" {
                            value "0";
                        }
                    }
                    default "PSK";
                }
                leaf "IpSecA_IKE_AEAD_ICV" {
                    when "not ((../IpSecA_IKEVersion != 'IKEv2') or (../IpSecA_IKE_Encryption != 'AES128CCM (AEAD)' and ../IpSecA_IKE_Encryption != 'AES192CCM (AEAD)' and ../IpSecA_IKE_Encryption != 'AES256CCM (AEAD)' and ../IpSecA_IKE_Encryption != 'AES128GCM (AEAD)' and ../IpSecA_IKE_Encryption != 'AES192GCM (AEAD)' and ../IpSecA_IKE_Encryption != 'AES256GCM (AEAD)'))";
                    type "enumeration" {
                        enum "64b" {
                            value "0";
                        }
                        enum "96b" {
                            value "1";
                        }
                        enum "128b" {
                            value "2";
                        }
                    }
                    default "96b";
