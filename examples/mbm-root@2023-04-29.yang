            container "CellularSim1" {
                when "not (((/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On') or (/config_data/main/Cellular/RR_CellMain_Enable != 'On')) and ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') or (/config_data/main/Cellular/RR_CellAux_Enable != 'On')))";
                leaf "RR_CellSim1_PinRequired" {
                    type "lbox_off_on";
                }
                leaf "RR_CellSim1_Pin" {
