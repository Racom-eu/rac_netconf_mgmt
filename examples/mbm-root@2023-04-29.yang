                        enum "IP address to IP address" {
                            value "1";
                        }
                        enum "Port to IP address" {
                            value "2";
                        }
                    }
                    must "not ((. = 'Port to IP address' and ((../NatDnat_Protocol != 'UDP' and ../NatDnat_Protocol != 'TCP') or (../NatDnat_DstPortStart >= ../NatDnat_DstPortEnd))))";
                    default "Off";
                }
                leaf "NatDnat_RewriteToIpMask" {
                    when "not (../NatDnat_RangeMapping != 'IP address to IP address')";
                    type "lim_ipv4_mask";
