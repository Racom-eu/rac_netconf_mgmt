                    must ". <= ../BgpImIgpFRule_FNetMaskTo" {
                        error-message "valmsg_it_BgpImIgpFRule_FNetMaskFrom";
                    }
                    default "0";
                }
                leaf "BgpImIgpFRule_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
