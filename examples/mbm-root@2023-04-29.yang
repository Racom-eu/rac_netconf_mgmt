            container "RadioBabelFilter" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On') or (/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_BabelEn != 'On') or (/config_data/main/RadioInterface/RR_RadioBabelFilterEn != 'On'))";
                leaf "RR_RadioBblFlt_RssThr_Soft" {
