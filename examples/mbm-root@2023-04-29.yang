                        }
                        enum "CAMELLIA-192-CFB" {
                            value "43";
                        }
                        enum "CAMELLIA-192-CFB1" {
                            value "44";
                        }
                        enum "CAMELLIA-192-CFB8" {
                            value "45";
                        }
                        enum "CAMELLIA-192-OFB" {
                            value "46";
                        }
                        enum "CAMELLIA-256-CBC" {
                            value "47";
                        }
                        enum "CAMELLIA-256-CFB" {
                            value "48";
                        }
                        enum "CAMELLIA-256-CFB1" {
                            value "49";
                        }
                        enum "CAMELLIA-256-CFB8" {
                            value "50";
                        }
                        enum "CAMELLIA-256-OFB" {
                            value "51";
                        }
                        enum "CHACHA20-POLY1305" {
                            value "52";
                        }
                        enum "SM4-CBC" {
                            value "53";
                        }
                        enum "SM4-CFB" {
                            value "54";
                        }
                        enum "SM4-OFB" {
                            value "55";
                        }
                        enum "DES-EDE-CBC (legacy)" {
                            value "56";
                        }
                        enum "DES-EDE-CFB (legacy)" {
                            value "57";
                        }
                        enum "DES-EDE-OFB (legacy)" {
                            value "58";
                        }
                        enum "DES-EDE3-CBC (legacy)" {
                            value "59";
                        }
                        enum "DES-EDE3-CFB (legacy)" {
                            value "60";
                        }
                        enum "DES-EDE3-CFB1 (legacy)" {
                            value "61";
                        }
                        enum "DES-EDE3-CFB8 (legacy)" {
                            value "62";
                        }
                        enum "DES-EDE3-OFB (legacy)" {
                            value "63";
                        }
                    }
                    default "Default";
                }
                leaf "OvpnTun_Net_ClAddrsStart" {
                    when "not ((../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server') or (../OvpnTun_Iface_Mode != 'LB_OvpnTun_Iface_Mode_Router') or (../OvpnTun_Net_DynamicClAddrs != 'On'))";
                    type "inet:ipv4-address";
                    must "(round(16777216 * number(substring-before(., \".\")) + 65536 * number(substring-before(substring-after(., \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(., \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(., \".\"), \".\"), \".\")))) <= (round(16777216 * number(substring-before(../OvpnTun_Net_ClAddrsEnd, \".\")) + 65536 * number(substring-before(substring-after(../OvpnTun_Net_ClAddrsEnd, \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(../OvpnTun_Net_ClAddrsEnd, \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(../OvpnTun_Net_ClAddrsEnd, \".\"), \".\"), \".\"))))" {
                        error-message "valmsg_it_OvpnTun_Net_ClAddrsStart";
                    }
                    default "10.8.0.100";
                }
                leaf "OvpnTun_Net_ClAddrsEnd" {
                    when "not ((../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server') or (../OvpnTun_Iface_Mode != 'LB_OvpnTun_Iface_Mode_Router') or (../OvpnTun_Net_DynamicClAddrs != 'On'))";
                    type "inet:ipv4-address";
                    must "(round(16777216 * number(substring-before(., \".\")) + 65536 * number(substring-before(substring-after(., \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(., \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(., \".\"), \".\"), \".\")))) >= (round(16777216 * number(substring-before(../OvpnTun_Net_ClAddrsStart, \".\")) + 65536 * number(substring-before(substring-after(../OvpnTun_Net_ClAddrsStart, \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(../OvpnTun_Net_ClAddrsStart, \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(../OvpnTun_Net_ClAddrsStart, \".\"), \".\"), \".\"))))" {
                        error-message "valmsg_it_OvpnTun_Net_ClAddrsEnd";
                    }
                    default "10.8.0.200";
                }
                leaf "OvpnTun_Auth_PrivKeyId" {
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                    default "";
                }
                leaf "OvpnTun_Auth_CertId" {
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                    default "";
                }
                leaf "OvpnTun_Auth_CACertId" {
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                    default "";
                }
                leaf "OvpnTun_Crypt_RenegPeriod" {
                    type "uint32" {
                        range "60..86400";
                    }
                    default "3600";
                }
                leaf "OvpnTun_Crypt_DigestAlg" {
                    type "enumeration" {
                        enum "MD5" {
                            value "0";
                        }
                        enum "MD5-SHA1" {
                            value "1";
                        }
                        enum "RIPEMD160" {
                            value "4";
                        }
                        enum "SM3" {
                            value "5";
                        }
                        enum "SHA1" {
                            value "6";
                        }
                        enum "SHA224" {
                            value "7";
                        }
                        enum "SHA256" {
                            value "8";
                        }
                        enum "SHA384" {
                            value "9";
                        }
                        enum "SHA512-224" {
                            value "10";
                        }
                        enum "SHA512-256" {
                            value "11";
                        }
                        enum "SHA512" {
                            value "12";
                        }
                        enum "SHA3-224" {
                            value "13";
                        }
                        enum "SHA3-256" {
                            value "14";
                        }
                        enum "SHA3-384" {
                            value "15";
                        }
                        enum "SHA3-512" {
                            value "16";
                        }
                        enum "BLAKE2s256" {
                            value "17";
                        }
                        enum "BLAKE2b512" {
                            value "18";
                        }
                    }
                    default "SHA1";
                }
                leaf "OvpnTun_Compr_Mode" {
                    type "enumeration" {
                        enum "LB_OvpnTun_Compr_Off" {
                            value "0";
                        }
                        enum "LB_OvpnTun_Compr_On" {
                            value "1";
                        }
                        enum "LB_OvpnTun_Compr_Asymmetric" {
                            value "2";
                        }
                    }
                    default "LB_OvpnTun_Compr_Off";
                }
                leaf "OvpnTun_Compr_Algorithm" {
                    when "not (../OvpnTun_Compr_Mode = 'LB_OvpnTun_Compr_Off')";
                    type "enumeration" {
                        enum "LZO" {
                            value "0";
                        }
                        enum "LZ4" {
                            value "1";
                        }
                        enum "LZ4v2" {
                            value "2";
                        }
                        enum "LB_OvpnTun_Compr_Algorithm_Migrate" {
                            value "3";
                        }
                    }
                    default "LZO";
                }
                leaf "OvpnTun_Session_Limit" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Client')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "OvpnTun_LinkFrag_Enable" {
                    when "not ((../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server') or (../OvpnTun_Srv_Protocol != 'UDP'))";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "OvpnTun_LinkFrag_MaxSize" {
                    when "not ((../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server') or (../OvpnTun_Srv_Protocol != 'UDP') or (../OvpnTun_LinkFrag_Enable != 'On'))";
                    type "lim_openvpn_link_frag_size";
                    default "1300";
                }
                leaf "OvpnTun_Route_Metric" {
                    when "not (../OvpnTun_Iface_Mode != 'LB_OvpnTun_Iface_Mode_Router')";
                    type "lim_routing_metric";
                    default "24";
                }
                leaf "OvpnTun_Route_LocalUseSrcAddr" {
                    when "not (../OvpnTun_Iface_Mode != 'LB_OvpnTun_Iface_Mode_Router')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "OvpnTun_Session_Length" {
                    when "not ((../OvpnTun_Mode != 'LB_OvpnTun_Mode_Client') or (../OvpnTun_Session_Limit != 'On'))";
                    type "uint32" {
                        range "300..86400";
                    }
                    default "3600";
                }
                leaf "OvpnTun_Srv_Protocol" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server')";
                    type "lbox_openvpn_protocol";
                    default "UDP";
                }
                leaf "OvpnTun_Keepalive_Enable" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server')";
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OvpnTun_FixTcpMss" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server')";
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OvpnTun_TlsProtection_Mode" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server')";
                    type "lbox_openvpn_tls_protection_mode";
                    default "LB_openvpn_tls_protection_mode_Off";
                }
                leaf "OvpnTun_TlsProtection_SharedKeyDir" {
                    when "not ((../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server') or (../OvpnTun_TlsProtection_Mode != 'LB_openvpn_tls_protection_mode_TLS_Auth'))";
                    type "lbox_openvpn_tlsauth_key_dir";
                    default "0";
                }
                leaf "OvpnTun_ClMng_Client2Client" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server')";
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OvpnTun_ClMng_AllowDupCN" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "OvpnTun_ClMng_KnownCNOnly" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server')";
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OvpnTun_ClMng_MaxConnected" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server')";
                    type "uint8" {
                        range "1..30";
                    }
                    default "30";
                }
                leaf "OvpnTun_ClAuth_UsePass" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Client')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "OvpnTun_Auth_AllowLegacy" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "OvpnTun_Srv_Port" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server')";
                    type "lim_udp_port";
                    default "1194";
                }
                leaf "OvpnTun_Srv_DHParamsId" {
                    when "not (../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server')";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                    default "";
                }
                leaf "OvpnTun_Keepalive_Period" {
                    when "not ((../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server') or (../OvpnTun_Keepalive_Enable != 'On'))";
                    type "uint16" {
                        range "10..3600";
                    }
                    must ". <= ../OvpnTun_Keepalive_Timeout - 1" {
                        error-message "valmsg_it_OvpnTun_Keepalive_Period";
                    }
                    default "10";
                }
                leaf "OvpnTun_Keepalive_Timeout" {
                    when "not ((../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server') or (../OvpnTun_Keepalive_Enable != 'On'))";
                    type "uint16" {
                        range "30..14400";
                    }
                    must ". >= ../OvpnTun_Keepalive_Period + 1" {
                        error-message "valmsg_it_OvpnTun_Keepalive_Timeout";
                    }
                    default "60";
                }
                leaf "OvpnTun_TlsProtection_SharedKeyId" {
                    when "not ((../OvpnTun_Mode != 'LB_OvpnTun_Mode_Server') or (../OvpnTun_TlsProtection_Mode != 'LB_openvpn_tls_protection_mode_TLS_Auth' and ../OvpnTun_TlsProtection_Mode != 'LB_openvpn_tls_protection_mode_TLS_Crypt'))";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                    default "";
                }
                leaf "OvpnTun_ClAuth_Username" {
                    when "not ((../OvpnTun_Mode != 'LB_OvpnTun_Mode_Client') or (../OvpnTun_ClAuth_UsePass != 'On'))";
                    type "string" {
                        pattern ".{0,64}";
                    }
                    default "";
                }
                leaf "OvpnTun_ClAuth_Password" {
                    when "not ((../OvpnTun_Mode != 'LB_OvpnTun_Mode_Client') or (../OvpnTun_ClAuth_UsePass != 'On'))";
                    type "string" {
                        pattern ".{0,64}";
                    }
                    default "";
                }
                leaf "OvpnTun_Iface_RmtAccEn" {
                    when "not ((/config_data/main/UserAccess/RR_UsAcc_RmtAccess_Enable != 'On') or (../OvpnTun_Iface_Mode != 'LB_OvpnTun_Iface_Mode_Router'))";
                    type "lbox_off_on";
                    default "Off";
                }
            }
            list "RR_S_TABLE_OvpnRmtProfiles" {
                when "not (/config_data/main/VPN/RR_OpenVpnEnable != 'On')";
                key "ID";
                max-elements "64";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "ID_Parent" {
                    type "lim_uint_16";
                    default "0";
                }
                leaf "OvpnRmt_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OvpnRmt_Protocol" {
                    type "lbox_openvpn_protocol";
                    default "UDP";
                }
                leaf "OvpnRmt_AddrFloating" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "OvpnRmt_Conn_PeriodMax" {
                    type "uint16" {
                        range "1..600";
                    }
                    must ". >= ../OvpnRmt_Conn_PeriodInit" {
                        error-message "valmsg_it_OvpnRmt_Conn_PeriodMax";
                    }
                    default "300";
                }
                leaf "OvpnRmt_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "OvpnRmt_Addr" {
                    type "string" {
                        pattern "[a-zA-Z0-9.-]{1,128}";
                    }
                    default "0.0.0.0";
                }
                leaf "OvpnRmt_Port" {
                    type "lim_udp_port";
                    default "1194";
                }
                leaf "OvpnRmt_Conn_PeriodInit" {
                    type "uint8" {
                        range "1..60";
                    }
                    must ". <= ../OvpnRmt_Conn_PeriodMax" {
                        error-message "valmsg_it_OvpnRmt_Conn_PeriodInit";
                    }
                    default "1";
                }
                leaf "OvpnRmt_Conn_Timeout" {
                    type "uint16" {
                        range "1..3600";
                    }
                    default "120";
                }
                leaf "OvpnRmt_LinkFrag_Enable" {
                    when "not (../OvpnRmt_Protocol != 'UDP')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "OvpnRmt_FixTcpMss" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "OvpnRmt_TlsProtection_Mode" {
                    type "lbox_openvpn_tls_protection_mode";
                    default "LB_openvpn_tls_protection_mode_Off";
                }
                leaf "OvpnRmt_TlsProtection_SharedKeyDir" {
                    when "not (../OvpnRmt_TlsProtection_Mode != 'LB_openvpn_tls_protection_mode_TLS_Auth')";
                    type "lbox_openvpn_tlsauth_key_dir";
                    default "1";
                }
                leaf "OvpnRmt_LinkFrag_MaxSize" {
                    when "not ((../OvpnRmt_Protocol != 'UDP') or (../OvpnRmt_LinkFrag_Enable != 'On'))";
                    type "lim_openvpn_link_frag_size";
                    default "1300";
                }
                leaf "OvpnRmt_TlsProtection_SharedKeyId" {
                    when "not (../OvpnRmt_TlsProtection_Mode != 'LB_openvpn_tls_protection_mode_TLS_Auth' and ../OvpnRmt_TlsProtection_Mode != 'LB_openvpn_tls_protection_mode_TLS_Crypt')";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                    default "";
                }
            }
