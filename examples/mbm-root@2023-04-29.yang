        grouping "SerialProtocol" {
            choice "ch-SerialProtocol" {
                case "c-None" {
                    when "deref(./_variant_source_ref) = \"None\"";
                }
                case "c-Async_Link" {
                    when "deref(./_variant_source_ref) = \"Async_Link\"";
                    container "Async_Link" {
                        container "Protocol_AsyncLink" {
                            leaf "RR_ComProt_DstIP" {
                                type "inet:ipv4-address";
                            }
                            leaf "RR_ComProt_DstPort" {
                                when "not (./../../Protocol_AsyncLink/RR_ComProt_DstStdPort != 'MANUAL')";
                                type "lim_udp_port0";
                            }
                            leaf "RR_ComProt_DstStdPort" {
                                type "lbox_udp_reserved_ports";
                            }
                            leaf "RR_ComProt_AsyncBcastAll" {
                                when "not (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')";
                                type "lbox_off_on";
                            }
                            leaf "RR_ComProt_AsyncBcastRx" {
                                when "not (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')";
                                type "lbox_off_on";
                            }
                        }
                    }
                }
                case "c-DNP3" {
                    when "deref(./_variant_source_ref) = \"DNP3\"";
                    container "DNP3" {
                        container "Protocol_DNP3" {
                            leaf "RR_ComProt_DNP3_AtrmIpBase" {
                                when "not (./../../Protocol_DNP3/RR_ComProt_DNP3_AtrMethod = 'Table')";
                                type "inet:ipv4-address";
                            }
                            leaf "RR_ComProt_DNP3_AtrmUdpPort" {
                                when "not ((./../../Protocol_DNP3/RR_ComProt_DNP3_AtrMethod = 'Table') or (./../../Protocol_DNP3/RR_ComProt_DNP3_DstStdPort != 'MANUAL'))";
                                type "lim_udp_port";
                            }
                            leaf "RR_ComProt_DNP3_AtrMethod" {
                                type "lbox_com_prot_addr_mode";
                            }
                            leaf "RR_ComProt_DNP3_AtrmIpMask" {
                                when "not (./../../Protocol_DNP3/RR_ComProt_DNP3_AtrMethod = 'Table')";
                                type "lim_ipv4_mask";
                            }
                            leaf "RR_ComProt_DNP3_DstStdPort" {
                                when "not (./../../Protocol_DNP3/RR_ComProt_DNP3_AtrMethod = 'Table')";
                                type "lbox_udp_reserved_ports";
                            }
                            leaf "RR_ComProt_DNP3_Bcast" {
                                when "not (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')";
                                type "lbox_off_on";
                            }
                        }
                        list "RR_S_TABLE_Protocol_DNP3_TTable" {
                            when "not (./../Protocol_DNP3/RR_ComProt_DNP3_AtrMethod = 'Mask')";
                            key "ID";
                            max-elements "1024";
                            ordered-by "user";
                            leaf "ID" {
                                type "lim_uint_16";
                            }
