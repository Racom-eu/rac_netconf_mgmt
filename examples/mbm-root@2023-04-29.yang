                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_9_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_10_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_11_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_12_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_13_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_14_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_15_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_16_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_17_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_18_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_19_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_20_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_21_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_22_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_23_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_ChOccupied_Val_24_En" {
                    type "lbox_off_on";
                }
                leaf "RR_DynReg_Frequency_Fallback" {
                    type "uint32";
                }
                leaf "RR_DynReg_RfPower_Fallback" {
                    type "uint8";
                }
                leaf "RR_DynReg_ChSpacing_Fallback" {
                    type "uint16";
                }
                leaf "RR_DynReg_ChOccupied_Fallback" {
                    type "uint16";
                }
            }
            list "RR_S_TABLE_RegionFreqIntervals" {
                key "ID";
                description "Cnf. group for dynamic configuration: row of table RegionFreqIntervals";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "DynReg_FreqIval_Min" {
                    type "uint32";
                    default "0";
                }
                leaf "DynReg_FreqIval_Max" {
                    type "uint32";
                    default "0";
                }
            }
            list "RR_S_TABLE_RegionRfPowerVals" {
                key "ID";
                description "Cnf. group for dynamic configuration: row of table RegionRfPowerVals";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "DynReg_RfPwrVal_Val" {
                    type "uint8";
                    default "0";
                }
            }
            list "RR_S_TABLE_RegionChSpacingVals" {
                key "ID";
                description "Cnf. group for dynamic configuration: row of table RegionChSpacingVals";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "DynReg_ChSpcVal_Val" {
                    type "uint16";
                    default "0";
                }
            }
            list "RR_S_TABLE_RegionChOccupiedVals" {
                key "ID";
                description "Cnf. group for dynamic configuration: row of table RegionChOccupiedVals";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "DynReg_ChOccVal_Val" {
                    type "uint16";
                    default "0";
                }
            }
        }
        container "com_1_prot" {
            when "not ((/config_data/device/DeviceHw/RR_DynHw_Port_Com1 != 'On') or (/config_data/main/ComPort_1/RR_ComPort_1_ENA != 'On'))";
            presence "Port / Terminal server enabled.";
            leaf "_variant_source_ref" {
                type "instance-identifier";
                default "/rr:config_data/rr:main/rr:ComPort_1/rr:RR_ComPort_1_Protocol";
            }
            uses "SerialProtocol";
        }
        container "com_2_prot" {
            when "not ((/config_data/device/DeviceHw/RR_DynHw_Port_Com2 != 'On') or (/config_data/main/ComPort_2/RR_ComPort_2_ENA != 'On'))";
            presence "Port / Terminal server enabled.";
            leaf "_variant_source_ref" {
                type "instance-identifier";
                default "/rr:config_data/rr:main/rr:ComPort_2/rr:RR_ComPort_2_Protocol";
            }
            uses "SerialProtocol";
        }
        container "com_3_prot" {
            when "not ((/config_data/device/DeviceHw/RR_DynHw_Port_Com3 != 'On') or (/config_data/main/ComPort_3/RR_ComPort_3_ENA != 'On'))";
            presence "Port / Terminal server enabled.";
            leaf "_variant_source_ref" {
                type "instance-identifier";
                default "/rr:config_data/rr:main/rr:ComPort_3/rr:RR_ComPort_3_Protocol";
            }
            uses "SerialProtocol";
        }
        container "term_server_1_prot" {
            when "not (/config_data/main/TerminalServer_1/RR_TerminalServer_1_ENA != 'On')";
            presence "Port / Terminal server enabled.";
            leaf "_variant_source_ref" {
                type "instance-identifier";
                default "/rr:config_data/rr:main/rr:TerminalServer_1/rr:RR_TerminalServer_1_Protocol";
            }
            uses "TermServerProtocol";
        }
        container "term_server_2_prot" {
            when "not (/config_data/main/TerminalServer_2/RR_TerminalServer_2_ENA != 'On')";
            presence "Port / Terminal server enabled.";
            leaf "_variant_source_ref" {
                type "instance-identifier";
                default "/rr:config_data/rr:main/rr:TerminalServer_2/rr:RR_TerminalServer_2_Protocol";
            }
            uses "TermServerProtocol";
        }
        container "term_server_3_prot" {
            when "not (/config_data/main/TerminalServer_3/RR_TerminalServer_3_ENA != 'On')";
            presence "Port / Terminal server enabled.";
            leaf "_variant_source_ref" {
                type "instance-identifier";
                default "/rr:config_data/rr:main/rr:TerminalServer_3/rr:RR_TerminalServer_3_Protocol";
            }
            uses "TermServerProtocol";
        }
        container "term_server_4_prot" {
            when "not (/config_data/main/TerminalServer_4/RR_TerminalServer_4_ENA != 'On')";
            presence "Port / Terminal server enabled.";
            leaf "_variant_source_ref" {
                type "instance-identifier";
                default "/rr:config_data/rr:main/rr:TerminalServer_4/rr:RR_TerminalServer_4_Protocol";
            }
            uses "TermServerProtocol";
        }
        container "term_server_5_prot" {
            when "not (/config_data/main/TerminalServer_5/RR_TerminalServer_5_ENA != 'On')";
            presence "Port / Terminal server enabled.";
            leaf "_variant_source_ref" {
                type "instance-identifier";
                default "/rr:config_data/rr:main/rr:TerminalServer_5/rr:RR_TerminalServer_5_Protocol";
            }
            uses "TermServerProtocol";
        }
    }
    container "Diagnostics" {
        grouping "Error_message" {
            container "message_params" {
                description "Optional error message parameters.";
            }
            leaf "message_id" {
                type "string";
                mandatory "true";
            }
        }
        grouping "Error" {
            container "error" {
                presence "An error occured during processing rpc request.
        Container \"result\" may or may not be present simultaneously.";
                description "General RPC error message definition";
                leaf "code" {
                    type "enumeration" {
                        enum "rpc_server_error";
                        enum "rpc_compatibility_error";
                        enum "rpc_invalid_request";
                        enum "rpc_temporarily_unavailable";
                        enum "rpc_method_not_found";
                        enum "rpc_permission_denied";
                        enum "rpc_async_action_in_progress";
                    }
                    mandatory "true";
                }
                leaf "log" {
                    type "string";
                }
                list "suberrors" {
                    leaf-list "seids" {
                        type "string";
                    }
                    uses "Error_message";
                }
                uses "Error_message";
            }
        }
        grouping "Version_and_id" {
            leaf "id" {
                type "string";
            }
            leaf "version" {
                type "string";
            }
        }
        grouping "Input_header" {
            leaf "target" {
                type "inet:ipv4-address";
                mandatory "true";
            }
            uses "Version_and_id";
        }
        action "statistics_data_get" {
            input {
                container "params" {
                    container "filter" {
                        leaf "tstamp_from" {
                            type "uint64";
                            mandatory "true";
                        }
                        leaf "tstamp_until" {
                            type "uint64";
                            must ". > ../tstamp_from" {
                                error-message "valmsg_tstamp_until_before_from";
                            }
                        }
                        leaf-list "types" {
                            type "enumeration" {
                                enum "stat_rlp_ifc";
                                enum "stat_rlp_proto";
                                enum "stat_rlp_proto_na";
                                enum "stat_rlp_sig";
                                enum "stat_rlp_sig_na";
                                enum "stat_sp";
                                enum "stat_eth";
                                enum "stat_cell_data";
                                enum "stat_cell_state";
                                enum "stat_cell_sig";
                                enum "stat_wifi_data";
                                enum "stat_wifi_sta_data";
                                enum "stat_wifi_sta_sig";
                                enum "stat_meas_data";
                            }
                            min-elements "1";
                            ordered-by "user";
                        }
                    }
                }
                uses "Input_header";
            }
            output {
                container "result" {
                    typedef "stat_counter_t" {
                        type "uint64";
                    }
                    typedef "stat_percent_t" {
                        type "uint32" {
                            range "0..100";
                        }
                    }
                    typedef "stat_int1000_t" {
                        type "int32" {
                            range "-1000..1000";
                        }
                    }
                    grouping "avg_min_max" {
                        leaf "avg" {
                            type "stat_int1000_t";
                        }
                        leaf "min" {
                            type "stat_int1000_t";
                        }
                        leaf "max" {
                            type "stat_int1000_t";
                        }
                    }
                    grouping "avg_min_max_dev" {
                        leaf "dev" {
                            type "stat_int1000_t";
                        }
                        uses "avg_min_max";
                    }
                    grouping "rx_tx_count_bytes" {
                        leaf "rx_count" {
                            type "stat_counter_t";
                        }
                        leaf "rx_bytes" {
                            type "stat_counter_t";
                        }
                        leaf "tx_count" {
                            type "stat_counter_t";
                        }
                        leaf "tx_bytes" {
                            type "stat_counter_t";
                        }
                    }
                    grouping "IP_proto" {
                        container "UDP" {
                            uses "rx_tx_count_bytes";
                        }
                        container "TCP" {
                            uses "rx_tx_count_bytes";
                        }
                        container "ICMP" {
                            uses "rx_tx_count_bytes";
                        }
                        container "ARP" {
                            uses "rx_tx_count_bytes";
                        }
                        container "Other" {
                            uses "rx_tx_count_bytes";
                        }
                    }
                    grouping "att12" {
                        container "att2" {
                            uses "avg_min_max";
                        }
                        leaf "att1" {
                            type "stat_percent_t";
                        }
                    }
                    container "stat_rlp" {
                        container "stat_rlp_proto_na" {
                            leaf "False_sync" {
                                type "stat_counter_t";
                            }
                            leaf "Subhdr_err" {
                                type "stat_counter_t";
                            }
                            leaf "Phy_err" {
                                type "stat_counter_t";
                            }
                            leaf "Hdr_err" {
                                type "stat_counter_t";
                            }
                            leaf "Incompatible" {
                                type "stat_counter_t";
                            }
                            leaf "Strange" {
                                type "stat_counter_t";
                            }
                            leaf "Unroutable" {
                                type "stat_counter_t";
                            }
                            leaf "nullptr" {
                                type "stat_counter_t";
                            }
                        }
                        container "stat_rlp_sig_na" {
                            container "Preframe_noise" {
                                container "rss" {
                                    uses "avg_min_max_dev";
                                }
                                container "att" {
                                    uses "att12";
                                }
                                leaf "count" {
                                    type "stat_counter_t";
                                }
                            }
                            container "Hdrerr_other" {
                                container "rss" {
                                    uses "avg_min_max_dev";
                                }
                                container "mse" {
                                    uses "avg_min_max_dev";
                                }
                                leaf "count" {
                                    type "stat_counter_t";
                                }
                            }
                            leaf "nullptr" {
                                type "stat_counter_t";
                            }
                        }
                        list "stat_rlp_ifc" {
                            key "Link_address";
                            leaf "Link_address" {
                                type "string";
                            }
                            leaf "IP_address" {
                                type "inet:ipv4-address";
                            }
                            leaf "nullptr" {
                                type "stat_counter_t";
                            }
                            uses "IP_proto";
                        }
                        list "stat_rlp_proto" {
                            key "Link_address";
                            container "Frame" {
                                leaf "rx_ok" {
                                    type "stat_counter_t";
                                }
                                leaf "rx_error" {
                                    type "stat_counter_t";
                                }
                                leaf "rx_dupl" {
                                    type "stat_counter_t";
                                }
                                leaf "tx_ok" {
                                    type "stat_counter_t";
                                }
                                leaf "tx_lost" {
                                    type "stat_counter_t";
                                }
                                leaf "tx_rep" {
                                    type "stat_counter_t";
                                }
                                leaf "tx_rej" {
                                    type "stat_counter_t";
                                }
                            }
                            container "Packet" {
                                leaf "rx_rej" {
                                    type "stat_counter_t";
                                }
                                leaf "tx_rej" {
                                    type "stat_counter_t";
                                }
                            }
                            container "Ctrl" {
                                leaf "rx_frame" {
                                    type "stat_counter_t";
                                }
                                leaf "tx_frame" {
                                    type "stat_counter_t";
                                }
                            }
                            container "Total" {
                                uses "rx_tx_count_bytes";
                            }
                            leaf "Link_address" {
                                type "string";
                            }
                            leaf "IP_address" {
                                type "inet:ipv4-address";
                            }
                            leaf "nullptr" {
                                type "stat_counter_t";
                            }
                        }
                        list "stat_rlp_sig" {
                            key "Link_address";
                            container "Rss" {
                                uses "avg_min_max_dev";
                            }
                            container "Subhdr_mse" {
                                uses "avg_min_max_dev";
                            }
                            container "Att" {
                                uses "att12";
                            }
                            container "Data" {
                                container "mse" {
                                    uses "avg_min_max_dev";
                                }
                                leaf "count" {
                                    type "stat_counter_t";
                                }
                            }
                            leaf "Link_address" {
                                type "string";
                            }
                            leaf "IP_address" {
                                type "inet:ipv4-address";
                            }
                            leaf "Frame_count" {
                                type "stat_counter_t";
                            }
                            leaf "Freq_offset" {
                                type "int32";
                            }
                            leaf "nullptr" {
                                type "stat_counter_t";
                            }
                        }
                    }
                    container "stat_wifi_data" {
                        container "UDP" {
                            uses "rx_tx_count_bytes";
                        }
                        container "TCP" {
                            uses "rx_tx_count_bytes";
                        }
                        container "ICMP" {
                            uses "rx_tx_count_bytes";
                        }
                        container "IPv4_other" {
                            uses "rx_tx_count_bytes";
                        }
                        container "Sms" {
                            leaf "rx_ok" {
                                type "stat_counter_t";
                            }
                            leaf "rx_rej" {
                                type "stat_counter_t";
                            }
                            leaf "tx_ok" {
                                type "stat_counter_t";
                            }
                        }
                        leaf "Interface" {
                            type "stat_counter_t";
                        }
                        leaf "nullptr" {
                            type "stat_counter_t";
                        }
                    }
                    container "stat_wifi_sta_data" {
                        container "Packet" {
                            leaf "rx_drop" {
                                type "stat_counter_t";
                            }
                            leaf "rx_err" {
                                type "stat_counter_t";
                            }
                            leaf "tx_ret" {
                                type "stat_counter_t";
                            }
                            leaf "tx_fail" {
                                type "stat_counter_t";
                            }
                        }
                        container "Total" {
                            uses "rx_tx_count_bytes";
                        }
                        leaf "Interface" {
                            type "stat_counter_t";
                        }
                        leaf "MAC_address" {
                            type "stat_counter_t";
                        }
                        leaf "nullptr" {
                            type "stat_counter_t";
                        }
                    }
                    container "stat_wifi_sta_sig" {
                        container "Overall" {
                            container "rss" {
                                uses "avg_min_max_dev";
                            }
                            leaf "samples" {
                                type "stat_counter_t";
                            }
                        }
                        container "Ant1" {
                            container "rss" {
                                uses "avg_min_max_dev";
                            }
                            leaf "samples" {
                                type "stat_counter_t";
                            }
                        }
                        container "Ant2" {
                            container "rss" {
                                uses "avg_min_max_dev";
                            }
                            leaf "samples" {
                                type "stat_counter_t";
                            }
                        }
                        leaf "Interface" {
                            type "stat_counter_t";
                        }
                        leaf "MAC_address" {
                            type "stat_counter_t";
                        }
                        leaf "nullptr" {
                            type "stat_counter_t";
                        }
                    }
                    list "stat_cell" {
                        key "Interface";
                        container "stat_cell_data" {
                            container "UDP" {
                                uses "rx_tx_count_bytes";
                            }
                            container "TCP" {
                                uses "rx_tx_count_bytes";
                            }
                            container "ICMP" {
                                uses "rx_tx_count_bytes";
                            }
                            container "IPv4_other" {
                                uses "rx_tx_count_bytes";
                            }
                            container "Sms" {
                                leaf "rx_ok" {
                                    type "stat_counter_t";
                                }
                                leaf "rx_rej" {
                                    type "stat_counter_t";
                                }
                                leaf "tx_ok" {
                                    type "stat_counter_t";
                                }
                            }
                            leaf "nullptr" {
                                type "stat_counter_t";
                            }
                        }
                        container "stat_cell_state" {
                            container "Sim" {
                                leaf "SIM1" {
                                    type "stat_percent_t";
                                }
                                leaf "SIM2" {
                                    type "stat_percent_t";
                                }
                            }
                            container "Service" {
                                container "Cat" {
                                    leaf "M" {
                                        type "stat_counter_t";
                                    }
                                    leaf "NB" {
                                        type "stat_counter_t";
                                    }
                                }
                                leaf "NA" {
                                    type "stat_percent_t";
                                }
                                leaf "_2G" {
                                    type "stat_percent_t";
                                }
                                leaf "_3G" {
                                    type "stat_percent_t";
                                }
                                leaf "_4G" {
                                    type "stat_percent_t";
                                }
                                leaf "_5G" {
                                    type "stat_percent_t";
                                }
                            }
                            container "Network" {
                                leaf "NC" {
                                    type "stat_percent_t";
                                }
                                leaf "home" {
                                    type "stat_percent_t";
                                }
                                leaf "roam" {
                                    type "stat_percent_t";
                                }
                                leaf "other" {
                                    type "stat_percent_t";
                                }
                            }
                            leaf "nullptr" {
                                type "stat_counter_t";
                            }
                        }
                        container "stat_cell_sig" {
                            container "_2G" {
                                container "rssi" {
                                    uses "avg_min_max_dev";
                                }
                                leaf "count" {
                                    type "stat_counter_t";
                                }
                            }
                            container "_3G" {
                                container "rscp" {
                                    uses "avg_min_max_dev";
                                }
                                leaf "count" {
                                    type "stat_counter_t";
                                }
                            }
                            container "_4G" {
                                container "rsrp" {
                                    uses "avg_min_max_dev";
                                }
                                leaf "count" {
                                    type "stat_counter_t";
                                }
                            }
                            container "_5G" {
                                container "ss_rsrp" {
                                    uses "avg_min_max_dev";
                                }
                                leaf "count" {
                                    type "stat_counter_t";
                                }
                            }
                            container "cat" {
                                container "m" {
                                    container "rsrp" {
                                        uses "avg_min_max_dev";
                                    }
                                    leaf "count" {
                                        type "stat_counter_t";
                                    }
                                }
                                container "nb" {
                                    container "rsrp" {
                                        uses "avg_min_max_dev";
                                    }
                                    leaf "count" {
                                        type "stat_counter_t";
                                    }
                                }
                            }
                            leaf "nullptr" {
                                type "stat_counter_t";
                            }
                        }
                        leaf "Interface" {
                            type "enumeration" {
                                enum "cell-ext";
                                enum "cell-main";
                            }
                        }
                    }
                    list "stat_sp" {
                        key "Interface";
                        container "Correct" {
                            uses "rx_tx_count_bytes";
                        }
                        container "Drop" {
                            uses "rx_tx_count_bytes";
                        }
                        leaf "Interface" {
                            type "stat_counter_t";
                        }
                        leaf "nullptr" {
                            type "stat_counter_t";
                        }
                    }
                    list "stat_eth" {
                        key "Interface";
                        container "VLAN" {
                            uses "rx_tx_count_bytes";
                        }
                        container "Multicast" {
                            uses "rx_tx_count_bytes";
                        }
                        container "IPv4_other" {
                            uses "rx_tx_count_bytes";
                        }
                        container "IPv6" {
                            uses "rx_tx_count_bytes";
                        }
                        leaf "Interface" {
                            type "stat_counter_t";
                        }
                        leaf "nullptr" {
                            type "stat_counter_t";
                        }
                        uses "IP_proto";
                    }
                    list "stat_meas_data" {
                        key "Sensor";
                        container "Meas" {
                            leaf "count" {
                                type "stat_counter_t";
                            }
                            uses "avg_min_max";
                        }
                        leaf "Sensor" {
                            type "string";
                        }
                        leaf "nullptr" {
                            type "stat_counter_t";
                        }
                    }
                }
                uses "Version_and_id";
                uses "Error";
            }
        }
    }
}
