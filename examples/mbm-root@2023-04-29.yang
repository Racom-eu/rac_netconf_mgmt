                    type "lim_udp_port0";
                    must ". <= /config_data/monitoring/MonitoringWWANMainPhy/RR_MoniWWANMainPhyPortDstTo" {
                        error-message "valmsg_it_MoniWWANMainPhyPortDstFrom";
                    }
                    description "Monitoring - WWANMain - filter: destination port (from)";
                }
                leaf "RR_MoniWWANMainPhyPortDstTo" {
                    when "not ((/config_data/monitoring/MonitoringWWANMainPhy/RR_MoniWWANMainPhyPackType_All != 'On') and (/config_data/monitoring/MonitoringWWANMainPhy/RR_MoniWWANMainPhyPackType_Udp != 'On') and (/config_data/monitoring/MonitoringWWANMainPhy/RR_MoniWWANMainPhyPackType_Tcp != 'On'))";
                    type "lim_udp_port0";
                    must ". >= /config_data/monitoring/MonitoringWWANMainPhy/RR_MoniWWANMainPhyPortDstFrom" {
                        error-message "valmsg_it_MoniWWANMainPhyPortDstTo";
                    }
                    description "Monitoring - WWANMain - filter: destination port (to)";
                }
            }
        }
