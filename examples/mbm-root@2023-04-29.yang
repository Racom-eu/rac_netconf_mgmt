                key "ID";
                max-elements "256";
                ordered-by "user";
                description "Cnf. group for Babel: row of table BabelImFilterRules";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "BabelImFRule_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "BabelImFRule_FilterNet" {
                    type "lbox_adr_filter_match";
                    default "Off";
                }
                leaf "BabelImFRule_FNetMask" {
                    when "not (../BabelImFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "BabelImFRule_FNetMaskFrom" {
                    when "not (../BabelImFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    must ". <= ../BabelImFRule_FNetMaskTo" {
                        error-message "valmsg_it_BabelImFRule_FNetMaskFrom";
                    }
                    default "0";
                }
                leaf "BabelImFRule_SetPreference" {
                    when "not (../BabelImFRule_Action = 'Reject')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "BabelImFRule_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "BabelImFRule_FNetAddr" {
                    when "not (../BabelImFRule_FilterNet = 'Off')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "BabelImFRule_FNetMaskTo" {
                    when "not (../BabelImFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    must ". >= ../BabelImFRule_FNetMaskFrom" {
                        error-message "valmsg_it_BabelImFRule_FNetMaskTo";
                    }
                    default "32";
                }
                leaf "BabelImFRule_Action" {
                    type "lbox_adr_filter_action";
                    default "Accept";
                }
                leaf "BabelImFRule_Preference" {
                    when "not ((../BabelImFRule_Action = 'Reject') or (../BabelImFRule_SetPreference != 'On'))";
                    type "lim_adr_preference";
                    default "210";
                }
                leaf "BabelImFRule_LocalUseSrcAddr" {
                    when "not (../BabelImFRule_Action = 'Reject')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_BabelExFilterRules" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_BabelEn != 'On'))";
                key "ID";
                max-elements "256";
                ordered-by "user";
                description "Cnf. group for Babel: row of table BabelExFilterRules";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "BabelExFRule_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "BabelExFRule_FilterNet" {
                    type "lbox_adr_filter_match";
                    default "Off";
                }
                leaf "BabelExFRule_FNetMask" {
                    when "not (../BabelExFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "BabelExFRule_FNetMaskFrom" {
                    when "not (../BabelExFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    must ". <= ../BabelExFRule_FNetMaskTo" {
                        error-message "valmsg_it_BabelExFRule_FNetMaskFrom";
                    }
                    default "0";
                }
                leaf "BabelExFRule_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "BabelExFRule_FNetAddr" {
                    when "not (../BabelExFRule_FilterNet = 'Off')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "BabelExFRule_FNetMaskTo" {
                    when "not (../BabelExFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    must ". >= ../BabelExFRule_FNetMaskFrom" {
                        error-message "valmsg_it_BabelExFRule_FNetMaskTo";
                    }
                    default "32";
                }
                leaf "BabelExFRule_FilterProtocol" {
                    type "lbox_adr_filter_match";
                    default "Off";
                }
                leaf "BabelExFRule_FProtocol" {
                    when "not (../BabelExFRule_FilterProtocol = 'Off')";
                    type "enumeration" {
                        enum "System" {
                            value "0";
                        }
                        enum "BGP" {
                            value "1";
                        }
                        enum "BGP external" {
                            value "2";
                        }
                        enum "BGP internal" {
                            value "3";
                        }
                        enum "OSPF" {
                            value "4";
                        }
                    }
                    must "not ((. = 'BGP' and (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On')) or (. = 'BGP external' and (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On')) or (. = 'BGP internal' and (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On')) or (. = 'OSPF' and (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On')))";
                    default "System";
                }
                leaf "BabelExFRule_FilterBgpPath" {
                    when "not ((../BabelExFRule_FilterProtocol != 'Match') or (../BabelExFRule_FProtocol != 'BGP' and ../BabelExFRule_FProtocol != 'BGP internal'))";
                    type "lbox_adr_filter_bgppath_simple";
                    default "Off";
                }
                leaf "BabelExFRule_SetMetricFromOtherProt" {
                    when "not (../BabelExFRule_Action = 'Reject')";
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "BGP MED" {
                            value "1";
                        }
                        enum "OSPF metric 1" {
                            value "2";
                        }
                        enum "OSPF metric 2" {
                            value "3";
                        }
                        enum "OSPF metric sum" {
                            value "4";
                        }
                    }
                    must "not ((. = 'BGP MED' and (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On')) or (. = 'OSPF metric 1' and (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On')) or (. = 'OSPF metric 2' and (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On')) or (. = 'OSPF metric sum' and (/config_data/main/AdvDynamicRouting/RR_ADR_OspfEn != 'On')))";
                    default "Off";
                }
                leaf "BabelExFRule_FilterOspfSource" {
                    when "not ((../BabelExFRule_FilterProtocol != 'Match') or (../BabelExFRule_FProtocol != 'OSPF'))";
                    type "lbox_adr_filter_match";
                    default "Off";
                }
                leaf "BabelExFRule_FOspfSource" {
                    when "not ((../BabelExFRule_FilterProtocol != 'Match') or (../BabelExFRule_FProtocol != 'OSPF') or (../BabelExFRule_FilterOspfSource = 'Off'))";
                    type "lbox_ospf_source";
                    default "External type 2";
                }
                leaf "BabelExFRule_FilterOspfTag" {
                    when "not ((../BabelExFRule_FilterProtocol != 'Match') or (../BabelExFRule_FProtocol != 'OSPF'))";
                    type "lbox_adr_filter_match";
                    default "Off";
                }
                leaf "BabelExFRule_Action" {
                    type "lbox_adr_filter_action";
                    default "Accept";
                }
                leaf "BabelExFRule_FOspfTag" {
                    when "not ((../BabelExFRule_FilterProtocol != 'Match') or (../BabelExFRule_FProtocol != 'OSPF') or (../BabelExFRule_FilterOspfTag = 'Off'))";
                    type "lim_uint_32";
                    default "0";
                }
                leaf "BabelExFRule_Metric" {
                    when "not (../BabelExFRule_Action = 'Reject')";
                    type "lim_adr_babel_metric0";
                    default "0";
                }
            }
            list "RR_S_TABLE_BabelRelFilterRules" {
