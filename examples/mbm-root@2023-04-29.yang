                leaf "RR_Time_GnssPpsOffset" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Module_Gps = 'Off') or (/config_data/main/Gnss/RR_Gnss_Enable = 'Off') or (/config_data/main/Time/RR_Time_GnssSynchEn = 'Off'))";
                    type "uint16" {
                        range "0..999";
                    }
                }
                leaf "RR_Time_GnssMinJitter" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Module_Gps = 'Off') or (/config_data/main/Gnss/RR_Gnss_Enable = 'Off') or (/config_data/main/Time/RR_Time_GnssSynchEn = 'Off'))";
                    type "uint16" {
                        range "0..999";
                    }
                }
            }
            container "FW" {
                leaf "RR_FW_DowngradeEnable" {
                    type "lbox_off_on";
                }
            }
            container "FwDistribution" {
                when "not (/config_data/device/DeviceHw/RR_DynHw_FwDistribution != 'On')";
                leaf "RR_FwDist_SenderEn" {
                    type "lbox_off_on";
                }
                leaf "RR_FwDist_ReceiverEn" {
                    type "lbox_off_on";
                }
            }
            container "FwDistCommon" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_FwDistribution != 'On') or ((/config_data/main/FwDistribution/RR_FwDist_SenderEn != 'On') and (/config_data/main/FwDistribution/RR_FwDist_ReceiverEn != 'On')))";
                leaf "RR_FwDist_PublicMcastAddr" {
                    type "inet:ipv4-address";
                }
                leaf "RR_FwDist_KeySource" {
                    type "lbox_default_user";
                }
                leaf "RR_FwDist_DSCP" {
                    type "lim_qos_dscp";
                }
                leaf "RR_FwDist_KeyId" {
                    when "not (/config_data/main/FwDistCommon/RR_FwDist_KeySource != 'LB_default_user_User')";
                    type "string" {
                        pattern "[a-zA-Z0-9_]{0,128}";
                    }
                }
            }
            container "FwDistSender" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_FwDistribution != 'On') or (/config_data/main/FwDistribution/RR_FwDist_SenderEn != 'On'))";
                leaf "RR_FwDistSnd_PrivateMcastAddr" {
                    type "inet:ipv4-address";
                }
            }
            container "Gnss" {
                leaf "RR_Gnss_Enable" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Module_Gps = 'Off')";
                    type "lbox_off_on";
                }
                leaf "RR_Gnss_ServerEnable" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Module_Gps = 'Off') or (/config_data/main/Gnss/RR_Gnss_Enable = 'Off'))";
                    type "lbox_off_on";
                }
                leaf "RR_Gnss_ServerPort" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Module_Gps = 'Off') or (/config_data/main/Gnss/RR_Gnss_Enable = 'Off') or (/config_data/main/Gnss/RR_Gnss_ServerEnable = 'Off'))";
                    type "lim_udp_port";
                }
                leaf "RR_Gnss_MaxDowntime" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Module_Gps = 'Off') or (/config_data/main/Gnss/RR_Gnss_Enable = 'Off'))";
                    type "lim_uint_16_1toFF";
                }
            }
            container "KrngGenCrtKey" {
                leaf "RR_KrngGCKey_Algorithm" {
                    type "enumeration" {
                        enum "RSA" {
                            value "0";
                        }
                        enum "EC" {
                            value "1";
                        }
                        enum "ED25519" {
                            value "2";
                        }
                        enum "ED448" {
                            value "3";
                        }
                    }
                }
                leaf "RR_KrngGCKey_RsaLength" {
                    when "not (/config_data/main/KrngGenCrtKey/RR_KrngGCKey_Algorithm != 'RSA')";
                    type "enumeration" {
                        enum "2048" {
                            value "0";
                        }
                        enum "3072" {
                            value "1";
                        }
                        enum "4096" {
                            value "2";
