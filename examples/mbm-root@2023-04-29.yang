                    when "not ((/config_data/main/SvcAccess/RR_SvcAcc_UsbEthEn != 'On') and (/config_data/main/SvcAccess/RR_SvcAcc_UsbWifiEn != 'On'))";
                    type "inet:ipv4-address";
                }
                leaf "RR_SvcAcc_DhcpStartIp" {
                    when "not ((/config_data/main/SvcAccess/RR_SvcAcc_UsbEthEn != 'On') and (/config_data/main/SvcAccess/RR_SvcAcc_UsbWifiEn != 'On'))";
                    type "inet:ipv4-address";
                    must "(round(16777216 * number(substring-before(., \".\")) + 65536 * number(substring-before(substring-after(., \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(., \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(., \".\"), \".\"), \".\")))) <= (round(16777216 * number(substring-before(/config_data/main/SvcAccess/RR_SvcAcc_DhcpEndIp, \".\")) + 65536 * number(substring-before(substring-after(/config_data/main/SvcAccess/RR_SvcAcc_DhcpEndIp, \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(/config_data/main/SvcAccess/RR_SvcAcc_DhcpEndIp, \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(/config_data/main/SvcAccess/RR_SvcAcc_DhcpEndIp, \".\"), \".\"), \".\"))))" {
                        error-message "valmsg_it_SvcAcc_DhcpStartIp";
                    }
                }
                leaf "RR_SvcAcc_DhcpEndIp" {
                    when "not ((/config_data/main/SvcAccess/RR_SvcAcc_UsbEthEn != 'On') and (/config_data/main/SvcAccess/RR_SvcAcc_UsbWifiEn != 'On'))";
                    type "inet:ipv4-address";
                    must "(round(16777216 * number(substring-before(., \".\")) + 65536 * number(substring-before(substring-after(., \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(., \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(., \".\"), \".\"), \".\")))) >= (round(16777216 * number(substring-before(/config_data/main/SvcAccess/RR_SvcAcc_DhcpStartIp, \".\")) + 65536 * number(substring-before(substring-after(/config_data/main/SvcAccess/RR_SvcAcc_DhcpStartIp, \".\"), \".\")) + 256 * number(substring-before(substring-after(substring-after(/config_data/main/SvcAccess/RR_SvcAcc_DhcpStartIp, \".\"), \".\"), \".\")) + number(substring-after(substring-after(substring-after(/config_data/main/SvcAccess/RR_SvcAcc_DhcpStartIp, \".\"), \".\"), \".\"))))" {
                        error-message "valmsg_it_SvcAcc_DhcpEndIp";
                    }
                }
            }
            container "SvcAccessWifi" {
                when "not (/config_data/main/SvcAccess/RR_SvcAcc_UsbWifiEn != 'On')";
                leaf "RR_SvcWifi_SsidAutomatic" {
                    type "lbox_off_on";
                }
                leaf "RR_SvcWifi_Mode" {
                    type "enumeration" {
                        enum "802.11g" {
                            value "0";
                        }
                        enum "802.11n" {
                            value "1";
                        }
                    }
                }
                leaf "RR_SvcWifi_Channel" {
                    type "enumeration" {
                        enum "1 - 2412 MHz" {
                            value "1";
                        }
                        enum "2 - 2417 MHz" {
                            value "2";
                        }
                        enum "3 - 2422 MHz" {
                            value "3";
                        }
                        enum "4 - 2427 MHz" {
                            value "4";
                        }
                        enum "5 - 2432 MHz" {
                            value "5";
                        }
                        enum "6 - 2437 MHz" {
                            value "6";
                        }
                        enum "7 - 2442 MHz" {
                            value "7";
                        }
                        enum "8 - 2447 MHz" {
                            value "8";
                        }
                        enum "9 - 2452 MHz" {
                            value "9";
                        }
                        enum "10 - 2457 MHz" {
                            value "10";
                        }
                        enum "11 - 2462 MHz" {
                            value "11";
                        }
                    }
                    must "not ((. = '8 - 2447 MHz' and (/config_data/main/SvcAccessWifi/RR_SvcWifi_Mode = '802.11n')) or (. = '9 - 2452 MHz' and (/config_data/main/SvcAccessWifi/RR_SvcWifi_Mode = '802.11n')) or (. = '10 - 2457 MHz' and (/config_data/main/SvcAccessWifi/RR_SvcWifi_Mode = '802.11n')) or (. = '11 - 2462 MHz' and (/config_data/main/SvcAccessWifi/RR_SvcWifi_Mode = '802.11n')))";
                }
                leaf "RR_SvcWifi_Security" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "WPA2-PSK" {
                            value "1";
                        }
                    }
                }
                leaf "RR_SvcWifi_Ssid" {
                    when "not (/config_data/main/SvcAccessWifi/RR_SvcWifi_SsidAutomatic = 'On')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{1,32}";
                    }
                }
                leaf "RR_SvcWifi_Passphrase" {
                    when "not (/config_data/main/SvcAccessWifi/RR_SvcWifi_Security = 'Off')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,63}";
                    }
                }
            }
