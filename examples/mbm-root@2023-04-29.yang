                    type "lbox_off_on";
                }
                leaf "RR_Event_Sys_Boot_Completed_Sms" {
                    when "not (((/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_Sms != 'On') or (/config_data/main/Cellular/RR_CellMain_Enable != 'On') or (/config_data/main/CellularMain/RR_CellMain_SmsNotifications != 'On')) and ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_Sms != 'On') or (/config_data/main/Cellular/RR_CellAux_Enable != 'On') or (/config_data/main/CellularAux/RR_CellAux_SmsNotifications != 'On')))";
                    type "lbox_off_on";
                }
