                    must ". <= ../BabelRelFRule_FNetMaskTo" {
                        error-message "valmsg_it_BabelRelFRule_FNetMaskFrom";
                    }
                    default "0";
                }
                leaf "BabelRelFRule_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "BabelRelFRule_FNetAddr" {
                    when "not (../BabelRelFRule_FilterNet = 'Off')";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "BabelRelFRule_FNetMaskTo" {
                    when "not (../BabelRelFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    must ". >= ../BabelRelFRule_FNetMaskFrom" {
                        error-message "valmsg_it_BabelRelFRule_FNetMaskTo";
                    }
                    default "32";
                }
                leaf "BabelRelFRule_FilterMetric" {
                    type "lbox_adr_filter_metric_cmp";
                    default "Off";
                }
                leaf "BabelRelFRule_Action" {
                    type "lbox_adr_filter_action";
                    default "Accept";
                }
                leaf "BabelRelFRule_IncreaseMetric" {
                    when "not (../BabelRelFRule_Action = 'Reject')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "BabelRelFRule_FMetricValue" {
                    when "not (../BabelRelFRule_FilterMetric = 'Off')";
                    type "lim_adr_babel_metric0";
                    default "0";
                }
                leaf "BabelRelFRule_AddedMetric" {
                    when "not ((../BabelRelFRule_Action = 'Reject') or (../BabelRelFRule_IncreaseMetric != 'On'))";
                    type "lim_adr_babel_metric";
                    default "1";
                }
