                leaf "RR_CellAuxPS_ConnectionTimeout" {
                    type "uint8" {
                        range "3..60";
                    }
                }
                leaf "RR_CellAuxPS_RetryFirstProfile" {
                    type "lbox_off_on";
                }
                leaf "RR_CellAuxPS_RetryTimeout" {
                    when "not (/config_data/main/CellularAuxProfileSwitch/RR_CellAuxPS_RetryFirstProfile != 'On')";
