                    must "(. >= /config_data/region/Region/RR_DynReg_FreqInterval_0_Min and . <= /config_data/region/Region/RR_DynReg_FreqInterval_0_Max) or (. >= /config_data/region/Region/RR_DynReg_FreqInterval_1_Min and . <= /config_data/region/Region/RR_DynReg_FreqInterval_1_Max) or (. >= /config_data/region/Region/RR_DynReg_FreqInterval_2_Min and . <= /config_data/region/Region/RR_DynReg_FreqInterval_2_Max) or (. >= /config_data/region/Region/RR_DynReg_FreqInterval_3_Min and . <= /config_data/region/Region/RR_DynReg_FreqInterval_3_Max) or (. >= /config_data/region/Region/RR_DynReg_FreqInterval_4_Min and . <= /config_data/region/Region/RR_DynReg_FreqInterval_4_Max) or (. >= /config_data/region/Region/RR_DynReg_FreqInterval_5_Min and . <= /config_data/region/Region/RR_DynReg_FreqInterval_5_Max) or (. >= /config_data/region/Region/RR_DynReg_FreqInterval_6_Min and . <= /config_data/region/Region/RR_DynReg_FreqInterval_6_Max) or (. >= /config_data/region/Region/RR_DynReg_FreqInterval_7_Min and . <= /config_data/region/Region/RR_DynReg_FreqInterval_7_Max)" {
