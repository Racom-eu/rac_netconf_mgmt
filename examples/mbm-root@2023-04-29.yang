                max-elements "8";
                min-elements "1";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "CellProfAux_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "CellProfAux_Network" {
                    type "lbox_cellular_network";
                    default "Automatic";
                }
                leaf "CellProfAux_PreferredSvc" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_SvcConv != 'On')";
                    type "lbox_cellular_Aux_preferred_svc_M2";
                    must "not ((. = 'LB_cell_pref_svc_2g_first' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc2gFirst != 'On')) or (. = 'LB_cell_pref_svc_2g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc2gOnly != 'On') or ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc2gFirst = 'On') and (../CellProfAux_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_3g_first' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3gFirst != 'On')) or (. = 'LB_cell_pref_svc_3g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3g4g5gOnly = 'On')) and (../CellProfAux_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_2g_3g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc2g3gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc2gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3gFirst = 'On')) and (../CellProfAux_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_4g_first' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc4gFirst != 'On')) or (. = 'LB_cell_pref_svc_4g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc4gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc4gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3g4g5gOnly = 'On')) and (../CellProfAux_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_3g_4g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3g4gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc4gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3g4g5gOnly = 'On')) and (../CellProfAux_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_5g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc5gOnly != 'On') or ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3g4g5gOnly = 'On') and (../CellProfAux_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_3g_5g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3g5gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3g4g5gOnly = 'On')) and (../CellProfAux_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_4g_5g_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc4g5gOnly != 'On') or (((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc4gFirst = 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3g4g5gOnly = 'On')) and (../CellProfAux_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_3g_4g_5g_only' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvc3g4g5gOnly != 'On')))";
                    default "LB_cell_pref_svc_4g_first";
                }
                leaf "CellProfAux_ComprHdr" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "CellProfAux_ComprData" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "CellProfAux_Authentication" {
                    type "lbox_cellular_authentication";
                    default "None";
                }
                leaf "CellProfAux_SimUsed" {
                    type "lbox_cellular_sim_select";
                    default "SIM1";
                }
                leaf "CellProfAux_PreferredSvcLpwan" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_SvcLpwan != 'On')";
                    type "lbox_cellular_Aux_preferred_svc_lpwan_M2";
                    must "not ((. = 'LB_cell_pref_svc_lpwan_Lte_cat_m_first' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvcCatMFirst != 'On')) or (. = 'LB_cell_pref_svc_lpwan_Lte_cat_m_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvcCatMOnly != 'On') or ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvcCatMFirst = 'On') and (../CellProfAux_Network = 'Prefer manual')))) or (. = 'LB_cell_pref_svc_lpwan_Lte_cat_nb_first' and (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvcCatNbFirst != 'On')) or (. = 'LB_cell_pref_svc_lpwan_Lte_cat_nb_only' and ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvcCatNbOnly != 'On') or ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_PrefSvcCatNbFirst = 'On') and (../CellProfAux_Network = 'Prefer manual')))))";
                    default "LB_cell_pref_svc_lpwan_Lte_cat_m_only";
                }
                leaf "CellProfAux_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "CellProfAux_ManualPlmn" {
                    when "not (../CellProfAux_Network != 'Prefer manual' and ../CellProfAux_Network != 'Lock to manual')";
                    type "string" {
                        pattern "[0-9]{1,10}";
                    }
                    default "00000";
                }
                leaf "CellProfAux_APN" {
                    type "string" {
                        pattern "(([a-zA-Z0-9]|([a-zA-Z0-9][a-zA-Z0-9-]{0,61}[a-zA-Z0-9]))(\\.([a-zA-Z0-9]|([a-zA-Z0-9][a-zA-Z0-9-]{0,61}[a-zA-Z0-9])))*)?";
                    }
                    must "string-length(.) <= 99" {
                        error-message "valmsg_it_CellProfAux_APN";
                    }
                    default "";
                }
                leaf "CellProfAux_Username" {
                    when "not (../CellProfAux_Authentication = 'None')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,50}";
                    }
                    default "";
                }
                leaf "CellProfAux_Password" {
                    when "not (../CellProfAux_Authentication = 'None')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,50}";
                    }
                    default "";
                }
                leaf "CellProfAux_Mtu" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_SvcLpwan != 'Off') and (../CellProfAux_PreferredSvcLpwan != 'LB_cell_pref_svc_lpwan_Lte_cat_m_only'))";
                    type "uint16" {
                        range "70..1500";
                    }
                    must ". >= /config_data/device/DeviceHw/RR_DynHw_Cell_Ext_MtuMin" {
                        error-message "valmsg_it_CellProfExt_MtuMin";
                    }
                    default "1500";
                }
            }
            list "RR_S_TABLE_CellularSmsPhones" {
                when "not (((/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Main_Sms != 'On') or (/config_data/main/Cellular/RR_CellMain_Enable != 'On') or ((/config_data/main/CellularMain/RR_CellMain_SmsCommands != 'On') and (/config_data/main/CellularMain/RR_CellMain_SmsNotifications != 'On'))) and ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Cell_Ext_Sms != 'On') or (/config_data/main/Cellular/RR_CellAux_Enable != 'On') or ((/config_data/main/CellularAux/RR_CellAux_SmsCommands != 'On') and (/config_data/main/CellularAux/RR_CellAux_SmsNotifications != 'On'))))";
                key "ID";
                max-elements "64";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "CellSmsPh_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "CellSmsPh_RecvCommands" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "CellSmsPh_SendNotifications" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "CellSmsPh_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "CellSmsPh_Phone" {
                    type "string" {
                        pattern "\\+[0-9]{3,15}";
                    }
                    mandatory "true";
                }
            }
            list "RR_S_TABLE_WifiExtMacAclRules" {
                when "not ((/config_data/device/DeviceHw/RR_DynHw_Module_Wifi != 'On') or (/config_data/main/Wifi/RR_WifiExt_Enable != 'On') or (/config_data/main/WifiExt/RR_WifiExt_OperationType != 'LB_wifi_operation_type_Ap') or (/config_data/main/WifiExt/RR_WifiExt_MacAcl = 'LB_wifi_mac_acl_Off'))";
                key "ID WifiExtMacAcl_MacAddr";
                max-elements "64";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "WifiExtMacAcl_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "WifiExtMacAcl_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "WifiExtMacAcl_MacAddr" {
                    type "yang:mac-address";
                }
                leaf "WifiExtMacAcl_Password" {
                    when "not ((/config_data/main/WifiExt/RR_WifiExt_Security != 'LB_wifi_security_Wpa3') or (/config_data/main/WifiExt/RR_WifiExt_MacAcl != 'LB_wifi_mac_acl_Accept'))";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,63}";
                    }
                    default "";
                }
            }
            list "RR_S_TABLE_LoopbackAddresses" {
                key "ID";
                max-elements "256";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "LoopAddr_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "LoopAddr_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "LoopAddr_IpAddr" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
            }
            list "RR_S_TABLE_FirewallL3Rules" {
                when "not (/config_data/main/Networking/RR_FirewallL3Mode != 'On')";
                key "ID";
                max-elements "256";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "FwallL3_ItActive" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (((/config_data/main/EthPorts/RR_EthPort_1_Enable != 'On') and (../FwallL3_DeviceIn = 'ETH1')) or ((/config_data/main/EthPorts/RR_EthPort_2_Enable != 'On') and (../FwallL3_DeviceIn = 'ETH2')) or ((/config_data/main/EthPorts/RR_EthPort_3_Enable != 'On') and (../FwallL3_DeviceIn = 'ETH3')) or ((/config_data/main/EthPorts/RR_EthPort_4_Enable != 'On') and (../FwallL3_DeviceIn = 'ETH4')) or ((/config_data/main/ExtensionPorts/RR_PortSfpEnable != 'On') and (../FwallL3_DeviceIn = 'ETH5')) or ((/config_data/main/Cellular/RR_CellMain_Enable != 'On') and ((../FwallL3_DeviceIn = 'WWAN') or (../FwallL3_DeviceOut = 'WWAN'))) or ((/config_data/main/Cellular/RR_CellAux_Enable != 'On') and (/config_data/main/Wifi/RR_WifiExt_Enable != 'On') and ((../FwallL3_DeviceIn = 'EXT') or (../FwallL3_DeviceOut = 'EXT'))) or ((/config_data/main/ComPort_1/RR_ComPort_1_Protocol != 'PPP') and (/config_data/main/ComPort_2/RR_ComPort_2_Protocol != 'PPP') and (/config_data/main/ComPort_3/RR_ComPort_3_Protocol != 'PPP') and ((../FwallL3_DeviceIn = 'All PPP') or (../FwallL3_DeviceOut = 'All PPP'))) or ((/config_data/main/Networking/RR_PppoeClient_Enable != 'On') and ((../FwallL3_DeviceIn = 'PPPoE client') or (../FwallL3_DeviceOut = 'PPPoE client'))) or ((/config_data/main/VPN/RR_GreL2Enable != 'On') and (../FwallL3_DeviceIn = 'GRE L2')) or ((/config_data/main/VPN/RR_GreL3Enable != 'On') and ((../FwallL3_DeviceIn = 'GRE L3') or (../FwallL3_DeviceOut = 'GRE L3'))) or ((/config_data/main/VPN/RR_OpenVpnEnable != 'On') and ((../FwallL3_DeviceIn = 'OpenVPN L2' and ../FwallL3_DeviceIn = 'OpenVPN L3') or (../FwallL3_DeviceOut = 'OpenVPN L3'))) or ((/config_data/main/HotStdby/RR_HotStdby_Enable != 'On') and ((../FwallL3_DeviceIn = 'HotStandby') or (../FwallL3_DeviceOut = 'HotStandby'))) or ((/config_data/main/RadioInterface/RR_RadioIfMode != 'Router') and (../FwallL3_DeviceOut = 'Radio')))))";
                    default "On";
                }
                leaf "FwallL3_PolicyFlt" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3_PolDirection" {
                    when "not (../FwallL3_PolicyFlt != 'On')";
                    type "lbox_firewall_pol_direction";
                    default "LB_firewall_pol_direction_V_In";
                }
                leaf "FwallL3_PolPolicy" {
                    when "not (../FwallL3_PolicyFlt != 'On')";
                    type "lbox_firewall_policy";
                    default "LB_firewall_policy_V_None";
                }
                leaf "FwallL3_SrcIpMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "FwallL3_DstIpMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "FwallL3_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "FwallL3_Protocol" {
                    type "lbox_l3_protocol";
                    default "All";
                }
                leaf "FwallL3_DeviceOut" {
                    type "lbox_network_devices_log_M8";
                    must "not ((. = 'Radio' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')) or (. = 'WWAN' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On')) or (. = 'EXT' and ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') and (/config_data/device/DeviceHw/RR_DynHw_Module_Wifi != 'On'))) or (. = 'HotStandby' and (/config_data/device/DeviceHw/RR_DynHw_HotStandby != 'On')))";
                    default "All";
                }
                leaf "FwallL3_CStateNew" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3_CStateRel" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3_CStateEst" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3_Action" {
                    type "lbox_firewall_action";
                    default "Deny";
                }
                leaf "FwallL3_DeviceIn" {
                    type "lbox_network_devices_log_phy_M9";
                    must "not ((. = 'Radio' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')) or (. = 'WWAN' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On')) or (. = 'EXT' and ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') and (/config_data/device/DeviceHw/RR_DynHw_Module_Wifi != 'On'))) or (. = 'ETH1' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 0)) or (. = 'ETH2' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 1)) or (. = 'ETH3' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 2)) or (. = 'ETH4' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 3)) or (. = 'ETH5' and (/config_data/device/DeviceHw/RR_DynHw_Port_Sfp != 'On')) or (. = 'HotStandby' and (/config_data/device/DeviceHw/RR_DynHw_HotStandby != 'On')))";
                    default "All";
                }
                leaf "FwallL3_ProtocolNum" {
                    when "not (../FwallL3_Protocol != 'Other')";
                    type "lim_uint_8_1toFF";
                    default "1";
                }
                leaf "FwallL3_SrcIp" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "FwallL3_SrcPortStart" {
                    when "not (../FwallL3_Protocol != 'UDP' and ../FwallL3_Protocol != 'TCP')";
                    type "lim_udp_port0";
                    must ". <= ../FwallL3_SrcPortEnd" {
                        error-message "valmsg_it_FwallL3_SrcPortStart";
                    }
                    default "0";
                }
                leaf "FwallL3_SrcPortEnd" {
                    when "not (../FwallL3_Protocol != 'UDP' and ../FwallL3_Protocol != 'TCP')";
                    type "lim_udp_port0";
                    must ". >= ../FwallL3_SrcPortStart" {
                        error-message "valmsg_it_FwallL3_SrcPortEnd";
                    }
                    default "0";
                }
                leaf "FwallL3_DstIp" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "FwallL3_DstPortStart" {
                    when "not (../FwallL3_Protocol != 'UDP' and ../FwallL3_Protocol != 'TCP')";
                    type "lim_udp_port0";
                    must ". <= ../FwallL3_DstPortEnd" {
                        error-message "valmsg_tab_FwallL3_DstPortStart";
                    }
                    default "0";
                }
                leaf "FwallL3_DstPortEnd" {
                    when "not (../FwallL3_Protocol != 'UDP' and ../FwallL3_Protocol != 'TCP')";
                    type "lim_udp_port0";
                    must ". >= ../FwallL3_DstPortStart" {
                        error-message "valmsg_tab_FwallL3_DstPortEnd";
                    }
                    default "0";
                }
                leaf "FwallL3_DeviceInName" {
                    when "not (../FwallL3_DeviceIn != 'Other')";
                    type "string" {
                        pattern "[a-zA-Z0-9_.-]{0,16}";
                    }
                    default "";
                }
                leaf "FwallL3_DeviceOutName" {
                    when "not (../FwallL3_DeviceOut != 'Other')";
                    type "string" {
                        pattern "[a-zA-Z0-9_.-]{0,16}";
                    }
                    default "";
                }
                leaf "FwallL3_LogId" {
                    when "not ((/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On') or (../FwallL3_LogEn != 'On'))";
                    type "string" {
                        pattern "[a-zA-Z0-9_-]{0,12}";
                    }
                    default "";
                }
                leaf "FwallL3_LogEn" {
                    when "not (/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3_LogSeverity" {
                    when "not ((/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On') or (../FwallL3_LogEn != 'On'))";
                    type "lbox_event_severity";
                    default "Notice";
                }
            }
            list "RR_S_TABLE_FirewallL3RulesIn" {
                when "not (/config_data/main/Networking/RR_FirewallL3Mode != 'On')";
                key "ID";
                max-elements "256";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "FwallL3In_Active" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (((/config_data/main/EthPorts/RR_EthPort_1_Enable != 'On') and (../FwallL3In_DeviceIn = 'ETH1')) or ((/config_data/main/EthPorts/RR_EthPort_2_Enable != 'On') and (../FwallL3In_DeviceIn = 'ETH2')) or ((/config_data/main/EthPorts/RR_EthPort_3_Enable != 'On') and (../FwallL3In_DeviceIn = 'ETH3')) or ((/config_data/main/EthPorts/RR_EthPort_4_Enable != 'On') and (../FwallL3In_DeviceIn = 'ETH4')) or ((/config_data/main/ExtensionPorts/RR_PortSfpEnable != 'On') and (../FwallL3In_DeviceIn = 'ETH5')) or ((/config_data/main/Cellular/RR_CellMain_Enable != 'On') and (../FwallL3In_DeviceIn = 'WWAN')) or ((/config_data/main/Cellular/RR_CellAux_Enable != 'On') and (/config_data/main/Wifi/RR_WifiExt_Enable != 'On') and (../FwallL3In_DeviceIn = 'EXT')) or ((/config_data/main/ComPort_1/RR_ComPort_1_Protocol != 'PPP') and (/config_data/main/ComPort_2/RR_ComPort_2_Protocol != 'PPP') and (/config_data/main/ComPort_3/RR_ComPort_3_Protocol != 'PPP') and (../FwallL3In_DeviceIn = 'All PPP')) or ((/config_data/main/Networking/RR_PppoeClient_Enable != 'On') and (../FwallL3In_DeviceIn = 'PPPoE client')) or ((/config_data/main/VPN/RR_GreL2Enable != 'On') and (../FwallL3In_DeviceIn = 'GRE L2')) or ((/config_data/main/VPN/RR_GreL3Enable != 'On') and (../FwallL3In_DeviceIn = 'GRE L3')) or ((/config_data/main/VPN/RR_OpenVpnEnable != 'On') and (../FwallL3In_DeviceIn = 'OpenVPN L2' and ../FwallL3In_DeviceIn = 'OpenVPN L3')) or ((/config_data/main/HotStdby/RR_HotStdby_Enable != 'On') and (../FwallL3In_DeviceIn = 'HotStandby')) or ((/config_data/main/RadioInterface/RR_RadioIfMode != 'Router') and (../FwallL3In_DeviceIn = 'Radio')))))";
                    default "On";
                }
                leaf "FwallL3In_NetService" {
                    type "lbox_net_services";
                    default "Other";
                }
                leaf "FwallL3In_Protocol" {
                    when "not (../FwallL3In_NetService != 'Other')";
                    type "lbox_l3_protocol";
                    default "All";
                }
                leaf "FwallL3In_SrcIpMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "FwallL3In_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "FwallL3In_ProtocolNum" {
                    when "not ((../FwallL3In_NetService != 'Other') or (../FwallL3In_Protocol != 'Other'))";
                    type "lim_uint_8_1toFF";
                    default "1";
                }
                leaf "FwallL3In_SrcIp" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "FwallL3In_SrcPortStart" {
                    when "not ((../FwallL3In_NetService = 'Other') and (../FwallL3In_Protocol != 'TCP' and ../FwallL3In_Protocol != 'UDP'))";
                    type "lim_udp_port0";
                    must ". <= ../FwallL3In_SrcPortEnd" {
                        error-message "valmsg_it_FwallL3In_SrcPortStart";
                    }
                    default "0";
                }
                leaf "FwallL3In_SrcPortEnd" {
                    when "not ((../FwallL3In_NetService = 'Other') and (../FwallL3In_Protocol != 'TCP' and ../FwallL3In_Protocol != 'UDP'))";
                    type "lim_udp_port0";
                    must ". >= ../FwallL3In_SrcPortStart" {
                        error-message "valmsg_it_FwallL3In_SrcPortEnd";
                    }
                    default "0";
                }
                leaf "FwallL3In_DstIp" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "FwallL3In_DstPortStart" {
                    when "not ((../FwallL3In_NetService != 'Other') or (../FwallL3In_Protocol != 'TCP' and ../FwallL3In_Protocol != 'UDP'))";
                    type "uint16";
                    must ". <= ../FwallL3In_DstPortEnd" {
                        error-message "valmsg_it_FwallL3In_DstPortStart";
                    }
                    default "0";
                }
                leaf "FwallL3In_DstPortEnd" {
                    when "not ((../FwallL3In_NetService != 'Other') or (../FwallL3In_Protocol != 'TCP' and ../FwallL3In_Protocol != 'UDP'))";
                    type "lim_udp_port0";
                    must ". >= ../FwallL3In_DstPortStart" {
                        error-message "valmsg_it_FwallL3In_DstPortEnd";
                    }
                    default "0";
                }
                leaf "FwallL3In_DstIpMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "FwallL3In_PolicyFlt" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3In_PolPolicy" {
                    when "not (../FwallL3In_PolicyFlt != 'On')";
                    type "lbox_firewall_policy";
                    default "LB_firewall_policy_V_None";
                }
                leaf "FwallL3In_CStateNew" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3In_CStateRel" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3In_CStateEst" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3In_Action" {
                    type "enumeration" {
                        enum "Deny" {
                            value "0";
                        }
                        enum "Allow" {
                            value "1";
                        }
                        enum "Ban source" {
                            value "2";
                        }
                    }
                    default "Deny";
                }
                leaf "FwallL3In_DeviceIn" {
                    type "lbox_network_devices_log_phy_M9";
                    must "not ((. = 'Radio' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')) or (. = 'WWAN' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On')) or (. = 'EXT' and ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') and (/config_data/device/DeviceHw/RR_DynHw_Module_Wifi != 'On'))) or (. = 'ETH1' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 0)) or (. = 'ETH2' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 1)) or (. = 'ETH3' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 2)) or (. = 'ETH4' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 3)) or (. = 'ETH5' and (/config_data/device/DeviceHw/RR_DynHw_Port_Sfp != 'On')) or (. = 'HotStandby' and (/config_data/device/DeviceHw/RR_DynHw_HotStandby != 'On')))";
                    default "All";
                }
                leaf "FwallL3In_DeviceInName" {
                    when "not (../FwallL3In_DeviceIn != 'Other')";
                    type "string" {
                        pattern "[a-zA-Z0-9_.-]{0,16}";
                    }
                    default "";
                }
                leaf "FwallL3In_LogId" {
                    when "not ((/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On') or (../FwallL3In_LogEn != 'On'))";
                    type "string" {
                        pattern "[a-zA-Z0-9_-]{0,12}";
                    }
                    default "";
                }
                leaf "FwallL3In_LogEn" {
                    when "not (/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3In_LogSeverity" {
                    when "not ((/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On') or (../FwallL3In_LogEn != 'On'))";
                    type "lbox_event_severity";
                    default "Notice";
                }
            }
            list "RR_S_TABLE_FirewallL3RulesOut" {
                when "not (/config_data/main/Networking/RR_FirewallL3Mode != 'On')";
                key "ID";
                max-elements "256";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "FwallL3Out_Active" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (((/config_data/main/Cellular/RR_CellMain_Enable != 'On') and (../FwallL3Out_DeviceOut = 'WWAN')) or ((/config_data/main/Cellular/RR_CellAux_Enable != 'On') and (/config_data/main/Wifi/RR_WifiExt_Enable != 'On') and (../FwallL3Out_DeviceOut = 'EXT')) or ((/config_data/main/ComPort_1/RR_ComPort_1_Protocol != 'PPP') and (/config_data/main/ComPort_2/RR_ComPort_2_Protocol != 'PPP') and (/config_data/main/ComPort_3/RR_ComPort_3_Protocol != 'PPP') and (../FwallL3Out_DeviceOut = 'All PPP')) or ((/config_data/main/Networking/RR_PppoeClient_Enable != 'On') and (../FwallL3Out_DeviceOut = 'PPPoE client')) or ((/config_data/main/VPN/RR_GreL3Enable != 'On') and (../FwallL3Out_DeviceOut = 'GRE L3')) or ((/config_data/main/VPN/RR_OpenVpnEnable != 'On') and (../FwallL3Out_DeviceOut = 'OpenVPN L3')) or ((/config_data/main/HotStdby/RR_HotStdby_Enable != 'On') and (../FwallL3Out_DeviceOut = 'HotStandby')) or ((/config_data/main/RadioInterface/RR_RadioIfMode != 'Router') and (../FwallL3Out_DeviceOut = 'Radio')))))";
                    default "On";
                }
                leaf "FwallL3Out_NetService" {
                    type "lbox_net_services";
                    default "Other";
                }
                leaf "FwallL3Out_Protocol" {
                    when "not (../FwallL3Out_NetService != 'Other')";
                    type "lbox_l3_protocol";
                    default "All";
                }
                leaf "FwallL3Out_DstIpMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "FwallL3Out_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "FwallL3Out_ProtocolNum" {
                    when "not ((../FwallL3Out_NetService != 'Other') or (../FwallL3Out_Protocol != 'Other'))";
                    type "lim_uint_8_1toFF";
                    default "1";
                }
                leaf "FwallL3Out_SrcIp" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "FwallL3Out_SrcIpMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "FwallL3Out_DeviceOut" {
                    type "lbox_network_devices_log_M8";
                    must "not ((. = 'Radio' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')) or (. = 'WWAN' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On')) or (. = 'EXT' and ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') and (/config_data/device/DeviceHw/RR_DynHw_Module_Wifi != 'On'))) or (. = 'HotStandby' and (/config_data/device/DeviceHw/RR_DynHw_HotStandby != 'On')))";
                    default "All";
                }
                leaf "FwallL3Out_PolicyFlt" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3Out_PolPolicy" {
                    when "not (../FwallL3Out_PolicyFlt != 'On')";
                    type "lbox_firewall_policy";
                    default "LB_firewall_policy_V_None";
                }
                leaf "FwallL3Out_SrcPortStart" {
                    when "not ((../FwallL3Out_NetService != 'Other') or (../FwallL3Out_Protocol != 'TCP' and ../FwallL3Out_Protocol != 'UDP'))";
                    type "lim_udp_port0";
                    must ". <= ../FwallL3Out_SrcPortEnd" {
                        error-message "valmsg_it_FwallL3Out_SrcPortStart";
                    }
                    default "0";
                }
                leaf "FwallL3Out_SrcPortEnd" {
                    when "not ((../FwallL3Out_NetService != 'Other') or (../FwallL3Out_Protocol != 'TCP' and ../FwallL3Out_Protocol != 'UDP'))";
                    type "lim_udp_port0";
                    must ". >= ../FwallL3Out_SrcPortStart" {
                        error-message "valmsg_it_FwallL3Out_SrcPortEnd";
                    }
                    default "0";
                }
                leaf "FwallL3Out_DstIp" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "FwallL3Out_DstPortStart" {
                    when "not ((../FwallL3Out_NetService = 'Other') and (../FwallL3Out_Protocol != 'TCP' and ../FwallL3Out_Protocol != 'UDP'))";
                    type "lim_udp_port0";
                    must ". <= ../FwallL3Out_DstPortEnd" {
                        error-message "valmsg_it_FwallL3Out_DstPortStart";
                    }
                    default "0";
                }
                leaf "FwallL3Out_DstPortEnd" {
                    when "not ((../FwallL3Out_NetService = 'Other') and (../FwallL3Out_Protocol != 'TCP' and ../FwallL3Out_Protocol != 'UDP'))";
                    type "lim_udp_port0";
                    must ". >= ../FwallL3Out_DstPortStart" {
                        error-message "valmsg_it_FwallL3Out_DstPortEnd";
                    }
                    default "0";
                }
                leaf "FwallL3Out_DeviceOutName" {
                    when "not (../FwallL3Out_DeviceOut != 'Other')";
                    type "string" {
                        pattern "[a-zA-Z0-9_.-]{0,16}";
                    }
                    default "";
                }
                leaf "FwallL3Out_CStateNew" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3Out_CStateRel" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3Out_CStateEst" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3Out_Action" {
                    type "lbox_firewall_action";
                    default "Deny";
                }
                leaf "FwallL3Out_LogEn" {
                    when "not (/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL3Out_LogSeverity" {
                    when "not ((/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On') or (../FwallL3Out_LogEn != 'On'))";
                    type "lbox_event_severity";
                    default "Notice";
                }
                leaf "FwallL3Out_LogId" {
                    when "not ((/config_data/main/FirewallL3Log/RR_FirewallL3Log_En != 'On') or (../FwallL3Out_LogEn != 'On'))";
                    type "string" {
                        pattern "[a-zA-Z0-9_-]{0,12}";
                    }
                    default "";
                }
            }
            list "RR_S_TABLE_FirewallL2AccRules" {
                when "not (/config_data/main/Networking/RR_FirewallL2AccessCtrl = 'Off')";
                key "ID";
                max-elements "128";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "FwallL2Acc_ItActive" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (((/config_data/main/EthPorts/RR_EthPort_1_Enable != 'On') and (../FwallL2Acc_PortIn = 'ETH1')) or ((/config_data/main/EthPorts/RR_EthPort_2_Enable != 'On') and (../FwallL2Acc_PortIn = 'ETH2')) or ((/config_data/main/EthPorts/RR_EthPort_3_Enable != 'On') and (../FwallL2Acc_PortIn = 'ETH3')) or ((/config_data/main/EthPorts/RR_EthPort_4_Enable != 'On') and (../FwallL2Acc_PortIn = 'ETH4')) or ((/config_data/main/ExtensionPorts/RR_PortSfpEnable != 'On') and (../FwallL2Acc_PortIn = 'ETH5')))))";
                    default "On";
                }
                leaf "FwallL2Acc_PortIn" {
                    type "enumeration" {
                        enum "All" {
                            value "0";
                        }
                        enum "ETH1" {
                            value "1";
                        }
                        enum "ETH2" {
                            value "2";
                        }
                        enum "ETH3" {
                            value "3";
                        }
                        enum "ETH4" {
                            value "4";
                        }
                        enum "ETH5" {
                            value "5";
                        }
                    }
                    must "not ((. = 'ETH1' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 0)) or (. = 'ETH2' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 1)) or (. = 'ETH3' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 2)) or (. = 'ETH4' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 3)) or (. = 'ETH5' and (/config_data/device/DeviceHw/RR_DynHw_Port_Sfp != 'On')))";
                    default "All";
                }
                leaf "FwallL2Acc_LogEn" {
                    when "not (/config_data/main/FirewallL2AccLog/RR_FirewallL2AccLog_En != 'On')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL2Acc_LogSeverity" {
                    when "not ((/config_data/main/FirewallL2AccLog/RR_FirewallL2AccLog_En != 'On') or (../FwallL2Acc_LogEn != 'On'))";
                    type "lbox_event_severity";
                    default "Notice";
                }
                leaf "FwallL2Acc_LogId" {
                    when "not ((/config_data/main/FirewallL2AccLog/RR_FirewallL2AccLog_En != 'On') or (../FwallL2Acc_LogEn != 'On'))";
                    type "string" {
                        pattern "[a-zA-Z0-9_-]{0,12}";
                    }
                    default "";
                }
                leaf "FwallL2Acc_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "FwallL2Acc_MAC" {
                    type "yang:mac-address";
                    default "00:00:00:00:00:00";
                }
            }
            list "RR_S_TABLE_FirewallL2RulesFwd" {
                when "not (/config_data/main/Networking/RR_FirewallL2Mode != 'On')";
                key "ID";
                max-elements "256";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "FwallL2Fwd_ItActive" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (((/config_data/main/EthPorts/RR_EthPort_1_Enable != 'On') and ((../FwallL2Fwd_DeviceIn = 'ETH1') or (../FwallL2Fwd_DeviceOut = 'ETH1'))) or ((/config_data/main/EthPorts/RR_EthPort_2_Enable != 'On') and ((../FwallL2Fwd_DeviceIn = 'ETH2') or (../FwallL2Fwd_DeviceOut = 'ETH2'))) or ((/config_data/main/EthPorts/RR_EthPort_3_Enable != 'On') and ((../FwallL2Fwd_DeviceIn = 'ETH3') or (../FwallL2Fwd_DeviceOut = 'ETH3'))) or ((/config_data/main/EthPorts/RR_EthPort_4_Enable != 'On') and ((../FwallL2Fwd_DeviceIn = 'ETH4') or (../FwallL2Fwd_DeviceOut = 'ETH4'))) or ((/config_data/main/ExtensionPorts/RR_PortSfpEnable != 'On') and ((../FwallL2Fwd_DeviceIn = 'ETH5') or (../FwallL2Fwd_DeviceOut = 'ETH5'))) or ((/config_data/main/VPN/RR_GreL2Enable != 'On') and ((../FwallL2Fwd_DeviceIn = 'GRE L2') or (../FwallL2Fwd_DeviceOut = 'GRE L2'))) or ((/config_data/main/VPN/RR_OpenVpnEnable != 'On') and ((../FwallL2Fwd_DeviceIn = 'OpenVPN L2') or (../FwallL2Fwd_DeviceOut = 'OpenVPN L2'))) or ((/config_data/main/RadioInterface/RR_RadioIfMode != 'Bridge') and ((../FwallL2Fwd_DeviceIn = 'Radio') or (../FwallL2Fwd_DeviceOut = 'Radio'))))))";
                    default "On";
                }
                leaf "FwallL2Fwd_VlanEncap" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL2Fwd_VlanId" {
                    when "not (../FwallL2Fwd_VlanEncap != 'On')";
                    type "lim_vlan_id";
                    default "1";
                }
                leaf "FwallL2Fwd_BridgeFilter" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL2Fwd_TrafficLimit" {
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL2Fwd_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "FwallL2Fwd_EtherType" {
                    type "lbox_l2_protocol";
                    default "LB_l2_protocol_V_All";
                }
                leaf "FwallL2Fwd_SrcFilter" {
                    type "lbox_l2_address_filter";
                    default "LB_l2_address_filter_V_All";
                }
                leaf "FwallL2Fwd_DstFilter" {
                    type "lbox_l2_address_filter";
                    default "LB_l2_address_filter_V_All";
                }
                leaf "FwallL2Fwd_DeviceIn" {
                    type "lbox_network_devices_phy";
                    must "not ((. = 'Radio' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')) or (. = 'ETH1' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 0)) or (. = 'ETH2' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 1)) or (. = 'ETH3' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 2)) or (. = 'ETH4' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 3)) or (. = 'ETH5' and (/config_data/device/DeviceHw/RR_DynHw_Port_Sfp != 'On')))";
                    default "All";
                }
                leaf "FwallL2Fwd_Action" {
                    type "lbox_firewall_action";
                    default "Deny";
                }
                leaf "FwallL2Fwd_EtherTypeNum" {
                    when "not (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_Other')";
                    type "uint16" {
                        range "2048..65535";
                    }
                    default "0x0800";
                }
                leaf "FwallL2Fwd_SrcMac" {
                    when "not (../FwallL2Fwd_SrcFilter != 'LB_l2_address_filter_V_Mask')";
                    type "yang:mac-address";
                    default "00:00:00:00:00:00";
                }
                leaf "FwallL2Fwd_SrcMacMask" {
                    when "not (../FwallL2Fwd_SrcFilter != 'LB_l2_address_filter_V_Mask')";
                    type "yang:mac-address";
                    default "00:00:00:00:00:00";
                }
                leaf "FwallL2Fwd_DstMac" {
                    when "not (../FwallL2Fwd_DstFilter != 'LB_l2_address_filter_V_Mask')";
                    type "yang:mac-address";
                    default "00:00:00:00:00:00";
                }
                leaf "FwallL2Fwd_DstMacMask" {
                    when "not (../FwallL2Fwd_DstFilter != 'LB_l2_address_filter_V_Mask')";
                    type "yang:mac-address";
                    default "00:00:00:00:00:00";
                }
                leaf "FwallL2Fwd_DeviceInName" {
                    when "not (../FwallL2Fwd_DeviceIn != 'Other')";
                    type "string" {
                        pattern "[a-zA-Z0-9_.-]{0,16}";
                    }
                    default "";
                }
                leaf "FwallL2Fwd_DeviceOut" {
                    type "lbox_network_devices_phy";
                    must "not ((. = 'Radio' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')) or (. = 'ETH1' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 0)) or (. = 'ETH2' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 1)) or (. = 'ETH3' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 2)) or (. = 'ETH4' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 3)) or (. = 'ETH5' and (/config_data/device/DeviceHw/RR_DynHw_Port_Sfp != 'On')))";
                    default "All";
                }
                leaf "FwallL2Fwd_Arp_SrcIpMask" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_ARP'))";
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "FwallL2Fwd_Arp_DstIpMask" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_ARP'))";
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "FwallL2Fwd_DeviceOutName" {
                    when "not (../FwallL2Fwd_DeviceOut != 'Other')";
                    type "string" {
                        pattern "[a-zA-Z0-9_.-]{0,16}";
                    }
                    default "";
                }
                leaf "FwallL2Fwd_BridgeId" {
                    when "not (../FwallL2Fwd_BridgeFilter != 'On')";
                    type "lim_uint_16";
                    default "0";
                }
                leaf "FwallL2Fwd_TL_FrameCount" {
                    when "not (../FwallL2Fwd_TrafficLimit != 'On')";
                    type "lim_fwall_traffic_filter";
                    must ". <= ../FwallL2Fwd_TL_FrameBurst" {
                        error-message "valmsg_it_FwallL2Fwd_TL_FrameCount";
                    }
                    default "3";
                }
                leaf "FwallL2Fwd_TL_TimePeriod" {
                    when "not (../FwallL2Fwd_TrafficLimit != 'On')";
                    type "lbox_fwall_filter_limit_period";
                    default "LB_fwall_filter_limit_period_V_minute";
                }
                leaf "FwallL2Fwd_TL_FrameBurst" {
                    when "not (../FwallL2Fwd_TrafficLimit != 'On')";
                    type "lim_fwall_traffic_filter";
                    must ". >= ../FwallL2Fwd_TL_FrameCount" {
                        error-message "valmsg_it_FwallL2Fwd_TL_FrameBurst";
                    }
                    default "3";
                }
                leaf "FwallL2Fwd_Arp_OpCode" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_ARP'))";
                    type "enumeration" {
                        enum "LB_FwallL2Fwd_Arp_OpCode_V_All" {
                            value "0";
                        }
                        enum "LB_FwallL2Fwd_Arp_OpCode_V_Request" {
                            value "1";
                        }
                        enum "LB_FwallL2Fwd_Arp_OpCode_V_Reply" {
                            value "2";
                        }
                    }
                    default "LB_FwallL2Fwd_Arp_OpCode_V_All";
                }
                leaf "FwallL2Fwd_Arp_SrcIp" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_ARP'))";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "FwallL2Fwd_Arp_DstIp" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_ARP'))";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "FwallL2Fwd_Ip_Protocol" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_IPv4'))";
                    type "lbox_l3_protocol";
                    default "All";
                }
                leaf "FwallL2Fwd_Ip_SrcIpMask" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_IPv4'))";
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "FwallL2Fwd_Ip_DstIpMask" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_IPv4'))";
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "FwallL2Fwd_Ip_ProtocolNum" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_IPv4') or (../FwallL2Fwd_Ip_Protocol != 'Other'))";
                    type "lim_uint_8_1toFF";
                    default "1";
                }
                leaf "FwallL2Fwd_Ip_SrcIp" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_IPv4'))";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "FwallL2Fwd_Ip_DstIp" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_IPv4'))";
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "FwallL2Fwd_Ip_SrcPortStart" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_IPv4') or (../FwallL2Fwd_Ip_Protocol != 'UDP' and ../FwallL2Fwd_Ip_Protocol != 'TCP'))";
                    type "lim_udp_port0";
                    must ". <= ../FwallL2Fwd_Ip_SrcPortEnd" {
                        error-message "valmsg_it_FwallL2Fwd_Ip_SrcPortStart";
                    }
                    default "0";
                }
                leaf "FwallL2Fwd_Ip_SrcPortEnd" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_IPv4') or (../FwallL2Fwd_Ip_Protocol != 'UDP' and ../FwallL2Fwd_Ip_Protocol != 'TCP'))";
                    type "lim_udp_port0";
                    must ". >= ../FwallL2Fwd_Ip_SrcPortStart" {
                        error-message "valmsg_it_FwallL2Fwd_Ip_SrcPortEnd";
                    }
                    default "0";
                }
                leaf "FwallL2Fwd_Ip_DstPortStart" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_IPv4') or (../FwallL2Fwd_Ip_Protocol != 'UDP' and ../FwallL2Fwd_Ip_Protocol != 'TCP'))";
                    type "lim_udp_port0";
                    must ". <= ../FwallL2Fwd_Ip_DstPortEnd" {
                        error-message "valmsg_it_FwallL2Fwd_Ip_DstPortStart";
                    }
                    default "0";
                }
                leaf "FwallL2Fwd_Ip_DstPortEnd" {
                    when "not ((../FwallL2Fwd_VlanEncap = 'On') or (../FwallL2Fwd_EtherType != 'LB_l2_protocol_V_IPv4') or (../FwallL2Fwd_Ip_Protocol != 'UDP' and ../FwallL2Fwd_Ip_Protocol != 'TCP'))";
                    type "lim_udp_port0";
                    must ". >= ../FwallL2Fwd_Ip_DstPortStart" {
                        error-message "valmsg_it_FwallL2Fwd_Ip_DstPortEnd";
                    }
                    default "0";
                }
                leaf "FwallL2Fwd_LogId" {
                    when "not ((/config_data/main/FirewallL2FwdLog/RR_FirewallL2FwdLog_En != 'On') or (../FwallL2Fwd_LogEn != 'On'))";
                    type "string" {
                        pattern "[a-zA-Z0-9_-]{0,12}";
                    }
                    default "";
                }
                leaf "FwallL2Fwd_LogEn" {
                    when "not (/config_data/main/FirewallL2FwdLog/RR_FirewallL2FwdLog_En != 'On')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "FwallL2Fwd_LogSeverity" {
                    when "not ((/config_data/main/FirewallL2FwdLog/RR_FirewallL2FwdLog_En != 'On') or (../FwallL2Fwd_LogEn != 'On'))";
                    type "lbox_event_severity";
                    default "Notice";
                }
            }
            list "RR_S_TABLE_NatSnatRules" {
                when "not (/config_data/main/Networking/RR_NatMode != 'On')";
                key "ID";
                max-elements "256";
                ordered-by "user";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "NatSnat_ItActive" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "On" {
                            value "1";
                        }
                    }
                    must "not ((. = 'On' and (((/config_data/main/Cellular/RR_CellMain_Enable != 'On') and (../NatSnat_DeviceOut = 'WWAN')) or ((/config_data/main/Cellular/RR_CellAux_Enable != 'On') and (/config_data/main/Wifi/RR_WifiExt_Enable != 'On') and (../NatSnat_DeviceOut = 'EXT')) or ((/config_data/main/ComPort_1/RR_ComPort_1_Protocol != 'PPP') and (/config_data/main/ComPort_2/RR_ComPort_2_Protocol != 'PPP') and (/config_data/main/ComPort_3/RR_ComPort_3_Protocol != 'PPP') and (../NatSnat_DeviceOut = 'All PPP')) or ((/config_data/main/Networking/RR_PppoeClient_Enable != 'On') and (../NatSnat_DeviceOut = 'PPPoE client')) or ((/config_data/main/VPN/RR_GreL3Enable != 'On') and (../NatSnat_DeviceOut = 'GRE L3')) or ((/config_data/main/VPN/RR_OpenVpnEnable != 'On') and (../NatSnat_DeviceOut = 'OpenVPN L3')) or ((/config_data/main/HotStdby/RR_HotStdby_Enable != 'On') and (../NatSnat_DeviceOut = 'HotStandby')) or ((/config_data/main/RadioInterface/RR_RadioIfMode != 'Router') and (../NatSnat_DeviceOut = 'Radio')))))";
                    default "On";
                }
                leaf "NatSnat_Protocol" {
                    type "lbox_l3_protocol";
                    default "All";
                }
                leaf "NatSnat_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "NatSnat_ProtocolNum" {
                    when "not (../NatSnat_Protocol != 'Other')";
                    type "lim_uint_8_1toFF";
                    default "1";
                }
                leaf "NatSnat_SrcIp" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "NatSnat_SrcIpMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "NatSnat_DstIpMask" {
                    type "lim_ipv4_mask0";
                    default "0";
                }
                leaf "NatSnat_DeviceOut" {
                    type "lbox_network_devices_log_M8";
                    must "not ((. = 'Radio' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')) or (. = 'WWAN' and (/config_data/device/DeviceHw/RR_DynHw_Primary_Cellular != 'On')) or (. = 'EXT' and ((/config_data/device/DeviceHw/RR_DynHw_Module_Cellular != 'On') and (/config_data/device/DeviceHw/RR_DynHw_Module_Wifi != 'On'))) or (. = 'HotStandby' and (/config_data/device/DeviceHw/RR_DynHw_HotStandby != 'On')))";
                    default "All";
                }
                leaf "NatSnat_SrcPortStart" {
                    when "not (../NatSnat_Protocol != 'UDP' and ../NatSnat_Protocol != 'TCP')";
                    type "lim_udp_port0";
                    must ". <= ../NatSnat_SrcPortEnd" {
                        error-message "valmsg_it_NatSnat_SrcPortStart";
                    }
                    default "0";
                }
                leaf "NatSnat_SrcPortEnd" {
                    when "not (../NatSnat_Protocol != 'UDP' and ../NatSnat_Protocol != 'TCP')";
                    type "lim_udp_port0";
                    must ". >= ../NatSnat_SrcPortStart" {
                        error-message "valmsg_it_NatSnat_SrcPortEnd";
                    }
                    default "0";
                }
                leaf "NatSnat_DstIp" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "NatSnat_DstPortStart" {
                    when "not (../NatSnat_Protocol != 'UDP' and ../NatSnat_Protocol != 'TCP')";
                    type "lim_udp_port0";
                    must ". <= ../NatSnat_DstPortEnd" {
                        error-message "valmsg_it_NatSnat_DstPortStart";
                    }
                    default "0";
                }
                leaf "NatSnat_DstPortEnd" {
                    when "not (../NatSnat_Protocol != 'UDP' and ../NatSnat_Protocol != 'TCP')";
                    type "lim_udp_port0";
                    must ". >= ../NatSnat_DstPortStart" {
                        error-message "valmsg_it_NatSnat_DstPortEnd";
                    }
                    default "0";
                }
                leaf "NatSnat_DeviceOutName" {
                    when "not (../NatSnat_DeviceOut != 'Other')";
                    type "string" {
                        pattern "[a-zA-Z0-9_.-]{0,16}";
                    }
                    default "";
                }
                leaf "NatSnat_RangeMapping" {
                    type "enumeration" {
                        enum "Off" {
                            value "0";
                        }
                        enum "IP address to IP address" {
                            value "1";
                        }
                    }
                    default "Off";
                }
                leaf "NatSnat_RewriteToIpMask" {
                    when "not (../NatSnat_RangeMapping != 'IP address to IP address')";
                    type "lim_ipv4_mask";
                    default "32";
                }
                leaf "NatSnat_RewriteToIp" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "NatSnat_RewriteToPort" {
                    when "not ((../NatSnat_Protocol != 'UDP' and ../NatSnat_Protocol != 'TCP') or (../NatSnat_RangeMapping = 'IP address to IP address'))";
                    type "lim_udp_port0";
                    default "0";
                }
                leaf "NatSnat_LogId" {
                    when "not ((/config_data/main/NatLog/RR_NatLog_En != 'On') or (../NatSnat_LogEn != 'On'))";
                    type "string" {
                        pattern "[a-zA-Z0-9_-]{0,12}";
                    }
                    default "";
                }
                leaf "NatSnat_LogEn" {
                    when "not (/config_data/main/NatLog/RR_NatLog_En != 'On')";
                    type "lbox_off_on";
                    default "Off";
                }
                leaf "NatSnat_LogSeverity" {
                    when "not ((/config_data/main/NatLog/RR_NatLog_En != 'On') or (../NatSnat_LogEn != 'On'))";
                    type "lbox_event_severity";
                    default "Notice";
                }
            }
