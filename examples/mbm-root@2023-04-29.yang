                leaf "RR_KrngGCKey_EcCurve" {
                    when "not (/config_data/main/KrngGenCrtKey/RR_KrngGCKey_Algorithm != 'EC')";
                    type "enumeration" {
                        enum "P-224 (secp224r1)" {
                            value "0";
                        }
                        enum "P-256 (prime256v1)" {
                            value "1";
                        }
                        enum "P-384 (secp384r1)" {
                            value "2";
                        }
                        enum "P-521 (secp521r1)" {
                            value "3";
                        }
                    }
                }
            }
