                }
                leaf "BgpImIgpFRule_FNetMaskTo" {
                    when "not (../BgpImIgpFRule_FilterNet = 'Off')";
                    type "lim_ipv4_mask0";
                    must ". >= ../BgpImIgpFRule_FNetMaskFrom" {
                        error-message "valmsg_it_BgpImIgpFRule_FNetMaskTo";
                    }
                    default "32";
