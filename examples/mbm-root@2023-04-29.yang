            list "RR_S_TABLE_BabelInterfaces" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_BabelEn != 'On'))";
                key "ID";
                max-elements "64";
                leaf "ID" {
                    type "lim_uint_16";
                }
                leaf "BabelIface_ItActive" {
                    type "lbox_off_on";
                    default "On";
                }
                leaf "BabelIface_Type" {
                    type "enumeration" {
                        enum "Wired" {
                            value "0";
                        }
                        enum "Wireless" {
                            value "1";
                        }
                    }
                    default "Wireless";
                }
                leaf "BabelIface_HelloLimit" {
                    when "not (../BabelIface_Type != 'Wired')";
                    type "uint8" {
                        range "1..16";
                    }
                    default "12";
                }
                leaf "BabelIface_UpdateIntervalMult" {
                    type "uint8" {
                        range "2..30";
                    }
                    default "4";
                }
                leaf "BabelIface_AuthAlg" {
                    when "not (../BabelIface_Authentication = 'BabelIface_Authentication__None')";
                    type "enumeration" {
                        enum "HMAC SHA256" {
                            value "1";
                        }
                        enum "HMAC SHA384" {
                            value "2";
                        }
                        enum "HMAC SHA512" {
                            value "3";
                        }
                        enum "BLAKE2s-128" {
                            value "4";
                        }
                        enum "BLAKE2s-256" {
                            value "5";
                        }
                        enum "BLAKE2b-256" {
                            value "6";
                        }
                        enum "BLAKE2b-512" {
                            value "7";
                        }
                    }
                    default "HMAC SHA256";
                }
                leaf "BabelIface_Authentication" {
                    type "enumeration" {
                        enum "BabelIface_Authentication__None" {
                            value "0";
                        }
                        enum "BabelIface_Authentication__Full" {
                            value "1";
                        }
                        enum "BabelIface_Authentication__Only_sign" {
                            value "2";
                        }
                    }
                    default "BabelIface_Authentication__None";
                }
                leaf "BabelIface_Note" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,42}";
                    }
                    default "";
                }
                leaf "BabelIface_IfName" {
                    type "string" {
                        pattern "[a-zA-Z0-9_.-]{0,16}";
                    }
                    default "";
                }
                leaf "BabelIface_RxCost" {
                    type "lim_adr_babel_metric";
                    default "128";
                }
                leaf "BabelIface_HelloInterval" {
                    type "decimal64" {
                        fraction-digits "1";
                        range "0.1..327.0";
                    }
                    default "4.0";
                }
                leaf "BabelIface_AdvertisedNextHop" {
                    type "inet:ipv4-address";
                    default "0.0.0.0";
                }
                leaf "BabelIface_Password" {
                    when "not (../BabelIface_Authentication = 'BabelIface_Authentication__None')";
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,128}";
                    }
                    default "";
                }
            }
            list "RR_S_TABLE_BabelStaticRules" {
