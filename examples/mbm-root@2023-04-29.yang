            list "RR_S_TABLE_BgpImIgpFilterRules" {
                when "not ((/config_data/main/Networking/RR_AdvancedDynRouting != 'On') or (/config_data/main/AdvDynamicRouting/RR_ADR_BgpEn != 'On'))";
                key "ID";
                max-elements "256";
                ordered-by "user";
