                                type "lbox_off_on";
                                default "Off";
                            }
                            leaf "TTEntry_SAIA_SBUS_StdPort" {
                                type "lbox_udp_reserved_ports";
                                default "COM1";
                            }
                            leaf "TTEntry_SAIA_SBUS_ManPort" {
                                when "not (../TTEntry_SAIA_SBUS_StdPort != 'MANUAL')";
                                type "lim_udp_port";
                                default "50000";
                            }
                        }
                    }
                }
                case "c-Mars-A" {
                    when "deref(./_variant_source_ref) = \"Mars-A\"";
                    container "Mars-A" {
                        container "Protocol_MarsA" {
                            leaf "RR_ComProt_MarsA_AtrmIpBase" {
                                when "not (./../../Protocol_MarsA/RR_ComProt_MarsA_AtrMethod = 'Table')";
                                type "inet:ipv4-address";
                            }
                            leaf "RR_ComProt_MarsA_AtrmUdpPort" {
                                when "not ((./../../Protocol_MarsA/RR_ComProt_MarsA_AtrMethod = 'Table') or (./../../Protocol_MarsA/RR_ComProt_MarsA_DstStdPort != 'MANUAL'))";
                                type "lim_udp_port";
                            }
                            leaf "RR_ComProt_MarsA_Repeats" {
                                type "uint8" {
                                    range "0..31";
                                }
                            }
                            leaf "RR_ComProt_MarsA_Bcast" {
                                when "not (/config_data/device/DeviceHw/RR_DynHw_Primary_Radio != 'On')";
                                type "lbox_off_on";
                            }
                            leaf "RR_ComProt_MarsA_Crc" {
                                type "lbox_off_on";
                            }
                            leaf "RR_ComProt_MarsA_AtrMethod" {
                                type "lbox_com_prot_addr_mode";
                            }
                            leaf "RR_ComProt_MarsA_AtrmIpMask" {
                                when "not (./../../Protocol_MarsA/RR_ComProt_MarsA_AtrMethod = 'Table')";
                                type "lim_ipv4_mask";
                            }
                            leaf "RR_ComProt_MarsA_SecurityBit" {
                                type "lbox_off_on";
                            }
                            leaf "RR_ComProt_MarsA_DstStdPort" {
                                when "not (./../../Protocol_MarsA/RR_ComProt_MarsA_AtrMethod = 'Table')";
                                type "lbox_udp_reserved_ports";
                            }
                            leaf "RR_ComProt_MarsA_RepeatTimeout" {
                                type "uint16" {
                                    range "0..16383";
                                }
                            }
                        }
                        list "RR_S_TABLE_Protocol_MarsA_TTable" {
                            when "not (./../Protocol_MarsA/RR_ComProt_MarsA_AtrMethod = 'Mask')";
                            key "ID";
                            max-elements "1024";
                            ordered-by "user";
                            leaf "ID" {
                                type "lim_uint_16";
                            }
                            leaf "TTEntry_MarsA_Ena" {
                                type "lbox_off_on";
                                default "On";
                            }
                            leaf "TTEntry_MarsA_Note" {
                                type "string" {
                                    pattern "[^\"`\\\\$;]{0,42}";
                                }
                                default "";
                            }
                            leaf "TTEntry_MarsA_DevAddr_4B" {
                                type "lim_uint_32";
                                must ". <= ../TTEntry_MarsA_DevAddrLast_4B" {
                                    error-message "valmsg_it_TTEntry_MarsA_DevAddr_4B";
                                }
                                default "1";
                            }
                            leaf "TTEntry_MarsA_DevAddrLast_4B" {
                                type "lim_uint_32";
                                must ". >= ../TTEntry_MarsA_DevAddr_4B" {
                                    error-message "valmsg_it_TTEntry_MarsA_DevAddr_4B";
                                }
                                default "1";
                            }
                            leaf "TTEntry_MarsA_IpAddr" {
                                type "inet:ipv4-address";
                                default "0.0.0.0";
                            }
                            leaf "TTEntry_MarsA_IpInt" {
                                type "lbox_off_on";
                                default "Off";
                            }
                            leaf "TTEntry_MarsA_StdPort" {
                                type "lbox_udp_reserved_ports";
                                default "COM1";
                            }
                            leaf "TTEntry_MarsA_ManPort" {
                                when "not (../TTEntry_MarsA_StdPort != 'MANUAL')";
                                type "lim_udp_port";
                                default "50000";
                            }
                        }
                    }
                }
                case "c-COMLI" {
                    when "deref(./_variant_source_ref) = \"COMLI\"";
                    container "COMLI" {
                        container "Protocol_COMLI" {
                            leaf "RR_ComProt_COMLI_AtrmIpBase" {
                                when "not ((./../../Protocol_COMLI/RR_ComProt_COMLI_AtrMethod = 'Table') or (./../../Protocol_COMLI/RR_ComProt_COMLI_Mode = 'Slave'))";
                                type "inet:ipv4-address";
                            }
                            leaf "RR_ComProt_COMLI_AtrmUdpPort" {
                                when "not ((./../../Protocol_COMLI/RR_ComProt_COMLI_AtrMethod = 'Table') or (./../../Protocol_COMLI/RR_ComProt_COMLI_DstStdPort != 'MANUAL'))";
                                type "lim_udp_port";
                            }
                            leaf "RR_ComProt_COMLI_Mode" {
                                type "lbox_com_prot_mode";
                            }
                            leaf "RR_ComProt_COMLI_AtrMethod" {
                                when "not (./../../Protocol_COMLI/RR_ComProt_COMLI_Mode = 'Slave')";
                                type "lbox_com_prot_addr_mode";
                            }
                            leaf "RR_ComProt_COMLI_AtrmIpMask" {
                                when "not ((./../../Protocol_COMLI/RR_ComProt_COMLI_Mode = 'Slave') or (./../../Protocol_COMLI/RR_ComProt_COMLI_AtrMethod = 'Table'))";
                                type "lim_ipv4_mask";
                            }
                            leaf "RR_ComProt_COMLI_DstStdPort" {
                                when "not (((./../../Protocol_COMLI/RR_ComProt_COMLI_Mode = 'Master') and (./../../Protocol_COMLI/RR_ComProt_COMLI_AtrMethod = 'Table')) or ((./../../Protocol_COMLI/RR_ComProt_COMLI_Mode = 'Slave') and (./../../Protocol_COMLI/RR_ComProt_COMLI_SlaveDst = 'LASTRCV')))";
                                type "lbox_udp_reserved_ports";
                            }
                            leaf "RR_ComProt_COMLI_SlaveDst" {
                                when "not (./../../Protocol_COMLI/RR_ComProt_COMLI_Mode != 'Slave')";
                                type "lbox_com_prot_slave_dst";
                            }
                            leaf "RR_ComProt_COMLI_ResponseTimeout" {
                                when "not (./../../Protocol_COMLI/RR_ComProt_COMLI_Mode != 'Slave')";
                                type "uint16" {
                                    range "0..16383";
                                }
                            }
                            leaf "RR_ComProt_COMLI_CongestionTimeout" {
                                when "not (./../../Protocol_COMLI/RR_ComProt_COMLI_Mode != 'Master')";
                                type "uint16" {
                                    range "0..65535";
                                }
                            }
                            leaf "RR_ComProt_COMLI_SlaveTargetIp" {
                                when "not ((./../../Protocol_COMLI/RR_ComProt_COMLI_Mode = 'Master') or ((./../../Protocol_COMLI/RR_ComProt_COMLI_Mode = 'Slave') and (./../../Protocol_COMLI/RR_ComProt_COMLI_SlaveDst = 'LASTRCV')))";
                                type "inet:ipv4-address";
                            }
                        }
                        list "RR_S_TABLE_Protocol_COMLI_TTable" {
                            when "not (./../Protocol_COMLI/RR_ComProt_COMLI_AtrMethod = 'Mask')";
                            key "ID";
                            max-elements "1024";
                            ordered-by "user";
                            leaf "ID" {
                                type "lim_uint_16";
                            }
                            leaf "TTEntry_COMLI_Ena" {
                                type "lbox_off_on";
                                default "On";
                            }
                            leaf "TTEntry_COMLI_Note" {
                                type "string" {
                                    pattern "[^\"`\\\\$;]{0,42}";
                                }
                                default "";
                            }
                            leaf "TTEntry_COMLI_DevAddr_1B" {
                                type "lim_uint_8";
                                must ". <= ../TTEntry_COMLI_DevAddrLast_1B" {
                                    error-message "valmsg_it_TTEntry_COMLI_DevAddr_1B";
                                }
                                default "1";
                            }
                            leaf "TTEntry_COMLI_DevAddrLast_1B" {
                                type "lim_uint_8";
                                must ". >= ../TTEntry_COMLI_DevAddr_1B" {
                                    error-message "valmsg_it_TTEntry_COMLI_DevAddr_1B";
                                }
                                default "1";
                            }
                            leaf "TTEntry_COMLI_IpAddr" {
                                type "inet:ipv4-address";
                                default "0.0.0.0";
                            }
                            leaf "TTEntry_COMLI_IpInt" {
                                type "lbox_off_on";
                                default "Off";
                            }
                            leaf "TTEntry_COMLI_StdPort" {
                                type "lbox_udp_reserved_ports";
                                default "COM1";
                            }
                            leaf "TTEntry_COMLI_ManPort" {
                                when "not (../TTEntry_COMLI_StdPort != 'MANUAL')";
                                type "lim_udp_port";
                                default "50000";
                            }
                        }
                    }
                }
            }
        }
        container "main" {
            container "Main" {
                leaf "RR_StationName" {
                    type "string" {
                        pattern "[a-zA-Z0-9_]{1,64}";
                    }
                }
                leaf "RR_StationDesc" {
                    type "string" {
                        pattern "[^\"`\\\\$;]{0,1024}";
                    }
                }
                leaf "RR_DevicePortBase" {
                    type "uint16" {
                        range "1024..64512";
                    }
                }
                leaf "RR_StationLocation" {
                    type "string" {
                        pattern "[ !#%-\\)\\+-:<-\\?@-\\[\\]-_a-~]{0,255}";
                    }
                }
                leaf "RR_StationContactInfo" {
                    type "string" {
                        pattern "[ !#%-\\)\\+-:<-\\?@-\\[\\]-_a-~]{0,255}";
                    }
                }
            }
            container "EthPorts" {
                leaf "RR_EthPort_1_Enable" {
                    when "not (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 0)";
                    type "lbox_off_on";
                }
                leaf "RR_EthPort_1_AutoNeg" {
                    when "not ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Cnt <= 0) or (/config_data/main/EthPorts/RR_EthPort_1_Enable != 'On'))";
                    type "lbox_eth_autoneg_M1";
                    must "not ((. = 'LB_eth_autoneg_1000mbps_auto' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100)) or (. = 'LB_eth_autoneg_1000mbps_full' and ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_1000Mbps_Full != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100))) or (. = 'LB_eth_autoneg_1000mbps_half' and ((/config_data/device/DeviceHw/RR_DynHw_Port_Eth_1000Mbps_Half != 'On') or (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 100))) or (. = 'LB_eth_autoneg_100mbps_auto' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)) or (. = 'LB_eth_autoneg_100mbps_full' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)) or (. = 'LB_eth_autoneg_100mbps_half' and (/config_data/device/DeviceHw/RR_DynHw_Port_Eth_Speed <= 10)))";
